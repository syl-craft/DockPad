<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <!-- WPF pour JpegBitmapEncoder : aucune dépendance NuGet dans le pilote. -->
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <Platforms>x64</Platforms>
    <Product>DockPad</Product>
    <Authors>syl-craft</Authors>
    <Copyright>Copyright (c) 2026 syl-craft</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <AssemblyName>DockPad.StreamDock</AssemblyName>
    <RootNamespace>DockPad.StreamDock</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DockPad.Tests" />
    <InternalsVisibleTo Include="StreamDockProbe" />
  </ItemGroup>

  <ItemGroup>
    <!-- Private=false : DockPad fournit le contrat, le dossier du pilote n'en garde pas de copie. -->
    <ProjectReference Include="..\DockPad.Surfaces\DockPad.Surfaces.csproj">
      <Private>false</Private>
    </ProjectReference>
  </ItemGroup>

</Project>
