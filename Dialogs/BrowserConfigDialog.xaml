<Window x:Class="DockPad.BrowserConfigDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Navigateurs"
        Width="680" Height="860"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize" MinWidth="640" MinHeight="640"
        Background="#F3F3F3"
        FontFamily="Segoe UI">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#0078D4" Padding="20,14">
            <TextBlock Text="Navigateurs" FontSize="16" FontWeight="SemiBold" Foreground="White"/>
        </Border>

        <!-- Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,20">

                <!-- Section enregistrement -->
                <TextBlock Text="Interception des URLs" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,8"/>
                <TextBlock x:Name="TxtRegStatus" Foreground="#555" FontSize="12"
                           TextWrapping="Wrap" Margin="0,0,0,10"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <Button x:Name="BtnRegister" Content="S'enregistrer comme navigateur"
                            Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"
                            Click="Register_Click"/>
                    <Button Content="Paramètres Windows…" Style="{StaticResource SecondaryButton}"
                            Click="OpenSettings_Click"
                            ToolTip="Choisir DockPad comme navigateur par défaut (Applications par défaut)"/>
                </StackPanel>

                <Separator Margin="0,20,0,16"/>

                <!-- Section navigateurs -->
                <Grid Margin="0,0,0,8">
                    <TextBlock Text="Navigateurs de la popup" FontWeight="SemiBold" FontSize="13"
                               VerticalAlignment="Center"/>
                    <Button Content="↻ Redétecter" Style="{StaticResource SecondaryButton}"
                            HorizontalAlignment="Right" Padding="8,4" Click="Redetect_Click"
                            ToolTip="Ajoute les navigateurs nouvellement installés (n'écrase rien)"/>
                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <ListBox x:Name="LstBrowsers" Grid.Column="0" Height="190"
                             SelectionChanged="LstBrowsers_SelectionChanged"
                             HorizontalContentAlignment="Stretch"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="2,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Image Grid.Column="0" Source="{Binding Icon}" Width="20" Height="20"/>
                                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                        <TextBlock Text="{Binding Name}" FontSize="12"/>
                                        <TextBlock Text="{Binding Detail}" FontSize="10" Foreground="#999"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding HiddenLabel}" FontSize="10"
                                               Foreground="#C42B1C" VerticalAlignment="Center"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                        <Button x:Name="BtnUp"     Content="▲"  Width="34" Margin="0,0,0,4" Style="{StaticResource SecondaryButton}" Click="Up_Click"     ToolTip="Monter"/>
                        <Button x:Name="BtnDown"   Content="▼"  Width="34" Margin="0,0,0,4" Style="{StaticResource SecondaryButton}" Click="Down_Click"   ToolTip="Descendre"/>
                        <Button x:Name="BtnHide"   Content="👁" Width="34" Margin="0,0,0,4" Style="{StaticResource SecondaryButton}" Click="Hide_Click"   ToolTip="Masquer / Afficher"/>
                        <Button x:Name="BtnDelete" Content="🗑" Width="34" Margin="0,0,0,12" Style="{StaticResource SecondaryButton}" Click="Delete_Click" ToolTip="Supprimer"/>
                        <Button Content="➕" Width="34" Style="{StaticResource SecondaryButton}" Click="Add_Click" ToolTip="Ajouter un navigateur"/>
                    </StackPanel>
                </Grid>

                <!-- Édition de l'entrée sélectionnée -->
                <Border Background="White" CornerRadius="6" Padding="12" Margin="0,10,0,0"
                        BorderBrush="#E0E0E0" BorderThickness="1"
                        SnapsToDevicePixels="True" UseLayoutRounding="True">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Nom :" Foreground="#555"
                                   VerticalAlignment="Center" Margin="0,0,10,8"/>
                        <TextBox  x:Name="TxtName" Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2"
                                  Padding="6,4" Margin="0,0,0,8"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Exécutable :" Foreground="#555"
                                   VerticalAlignment="Center" Margin="0,0,10,8"/>
                        <TextBox  x:Name="TxtExe" Grid.Row="1" Grid.Column="1" Padding="6,4"
                                  Margin="0,0,8,8" FontFamily="Consolas" FontSize="11"/>
                        <Button   Grid.Row="1" Grid.Column="2" Content="…" Width="30" Margin="0,0,0,8"
                                  Style="{StaticResource SecondaryButton}" Click="BrowseExe_Click"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Arguments :" Foreground="#555"
                                   VerticalAlignment="Center" Margin="0,0,10,8"/>
                        <TextBox  x:Name="TxtArgs" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2"
                                  Padding="6,4" Margin="0,0,0,8" FontFamily="Consolas" FontSize="11"
                                  ToolTip="Ex : --profile-directory=&quot;Profile 1&quot;, --incognito, -inprivate. %1 = URL."/>

                        <Button   x:Name="BtnApply" Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2"
                                  Content="✔ Appliquer" HorizontalAlignment="Right"
                                  Style="{StaticResource PrimaryButton}" Click="Apply_Click"/>
                    </Grid>
                </Border>

                <Separator Margin="0,20,0,16"/>

                <!-- Section règles -->
                <TextBlock Text="Règles de domaine" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,4"/>
                <TextBlock Text="Créées via « Toujours pour ce domaine » dans la popup. Ces domaines s'ouvrent directement, sans popup."
                           Foreground="#888" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ListBox x:Name="LstRules" Grid.Column="0" Height="110"
                             HorizontalContentAlignment="Stretch">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="2,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Host}" FontFamily="Consolas" FontSize="12"/>
                                    <TextBlock Grid.Column="1" Text="{Binding BrowserName}" Foreground="#0078D4" FontSize="12"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Button Grid.Column="1" Content="🗑" Width="34" Margin="8,0,0,0"
                            VerticalAlignment="Top" Style="{StaticResource SecondaryButton}"
                            Click="DeleteRule_Click" ToolTip="Supprimer la règle sélectionnée"/>
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="2" Background="White" Padding="24,12"
                BorderBrush="#E0E0E0" BorderThickness="0,1,0,0">
            <Button Content="Fermer" Style="{StaticResource SecondaryButton}"
                    HorizontalAlignment="Right" Click="Close_Click"/>
        </Border>
    </Grid>
</Window>
