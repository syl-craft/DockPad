<Window x:Class="DockPad.BrowserConfigDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:DockPad.Services.Localization"
        Title="{loc:T Browsers_Title}"
        Width="680" Height="760"
        MaxHeight="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Height}"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize" MinWidth="640" MinHeight="600"
        Background="{DynamicResource Brush.Surface}"
        FontFamily="Segoe UI">
    <Grid TextElement.Foreground="{DynamicResource Brush.Text}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{DynamicResource Brush.Accent}" Padding="20,14">
            <TextBlock Text="{loc:T Browsers_Title}" FontSize="16" FontWeight="SemiBold" Foreground="White"/>
        </Border>

        <!-- Onglets -->
        <TabControl FontSize="13" ItemContainerStyle="{StaticResource FlatTabItem}" Grid.Row="1" Background="Transparent" BorderThickness="0" Padding="0"
                    Margin="16,10,16,0">

            <!-- ══ Onglet Navigateurs ══ -->
            <TabItem Header="{loc:T Browsers_Tab_Browsers}">
                <Grid Margin="8,14,8,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Section enregistrement -->
                    <StackPanel Grid.Row="0">
                        <TextBlock Text="{loc:T Browsers_UrlInterception}" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,8"/>
                        <TextBlock x:Name="TxtRegStatus" Foreground="{DynamicResource Brush.TextLabel}" FontSize="12"
                                   TextWrapping="Wrap" Margin="0,0,0,10"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <Button x:Name="BtnRegister" Content="{loc:T Browsers_Register}"
                                    Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"
                                    Click="Register_Click"/>
                            <Button Content="{loc:T Browsers_WindowsSettings}" Style="{StaticResource SecondaryButton}"
                                    Click="OpenSettings_Click"
                                    ToolTip="{loc:T Browsers_WindowsSettings_Tip}"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <TextBlock Text="{loc:T Browsers_AutoOpen}" Foreground="{DynamicResource Brush.TextLabel}" FontSize="12"
                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBox x:Name="TxtAutoOpen" Width="50" Padding="6,4" FontSize="12"
                                     HorizontalContentAlignment="Center"
                                     TextChanged="AutoOpen_TextChanged"/>
                            <TextBlock Text="{loc:T Browsers_AutoOpen_Hint}"
                                       Foreground="{DynamicResource Brush.TextHint}" FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <Separator Grid.Row="1" Margin="0,16,0,14"/>

                    <!-- Titre + redétection -->
                    <Grid Grid.Row="2" Margin="0,0,0,8">
                        <TextBlock Text="{loc:T Browsers_PopupList}" FontWeight="SemiBold" FontSize="13"
                                   VerticalAlignment="Center"/>
                        <Button Content="{loc:T Browsers_Redetect}" Style="{StaticResource SecondaryButton}"
                                HorizontalAlignment="Right" Padding="8,4" Click="Redetect_Click"
                                ToolTip="{loc:T Browsers_Redetect_Tip}"/>
                    </Grid>

                    <!-- Liste + actions -->
                    <Grid Grid.Row="3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <ListBox x:Name="LstBrowsers" Grid.Column="0"
                                 SelectionChanged="LstBrowsers_SelectionChanged"
                                 HorizontalContentAlignment="Stretch"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="2,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="28"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Filet d'indentation des profils (largeur nulle si masqué) -->
                                        <Border Grid.Column="0" Width="14" Margin="2,1,8,1"
                                                BorderBrush="{DynamicResource Brush.BorderList}" BorderThickness="1,0,0,0"
                                                SnapsToDevicePixels="True" UseLayoutRounding="True">
                                            <!-- Visibilité par le Style et non en attribut : une valeur
                                                 locale bat les Setter des DataTrigger. -->
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsChild}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                        </Border>

                                        <CheckBox Grid.Column="1" IsChecked="{Binding Visible, Mode=OneTime}"
                                                  VerticalAlignment="Center" Margin="0,0,8,0"
                                                  Click="VisibleCheck_Click"
                                                  ToolTip="{loc:T Browsers_Visible_Tip}"/>
                                        <Image Grid.Column="2" Source="{Binding Icon}" Width="20" Height="20"/>
                                        <StackPanel Grid.Column="3" Margin="8,0,0,0">
                                            <TextBlock Text="{Binding Name}" FontSize="12"/>
                                            <TextBlock Text="{Binding Detail}" FontSize="10" Foreground="{DynamicResource Brush.TextFaint}"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="4" Text="{Binding HiddenLabel}" FontSize="10"
                                                   Foreground="{DynamicResource Brush.Danger}" VerticalAlignment="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                            <Button x:Name="BtnUp"     Content="▲"  Width="34" Height="30" Padding="0" Margin="0,0,0,4" Style="{StaticResource SecondaryButton}" Click="Up_Click"     ToolTip="{loc:T Common_MoveUp}" AutomationProperties.Name="{loc:T Common_MoveUp}"/>
                            <Button x:Name="BtnDown"   Content="▼"  Width="34" Height="30" Padding="0" Margin="0,0,0,4" Style="{StaticResource SecondaryButton}" Click="Down_Click"   ToolTip="{loc:T Common_MoveDown}" AutomationProperties.Name="{loc:T Common_MoveDown}"/>
                            <Button x:Name="BtnDelete" Content="🗑" Width="34" Height="30" Padding="0" Margin="0,0,0,12" Style="{StaticResource SecondaryButton}" Click="Delete_Click" ToolTip="{loc:T Common_Delete}" AutomationProperties.Name="{loc:T Common_Delete}"/>
                            <Button Content="➕" Width="34" Height="30" Padding="0" Style="{StaticResource SecondaryButton}" Click="Add_Click" ToolTip="{loc:T Browsers_Add_Tip}" AutomationProperties.Name="{loc:T Browsers_Add_Tip}"/>
                        </StackPanel>
                    </Grid>

                    <!-- Édition de l'entrée sélectionnée (désactivé sans sélection) -->
                    <Border x:Name="PnlEdit" Grid.Row="4" IsEnabled="False"
                            Background="{DynamicResource Brush.SurfaceCard}" CornerRadius="6" Padding="12" Margin="0,10,0,0"
                            BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                            SnapsToDevicePixels="True" UseLayoutRounding="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:T Browsers_Name}" Foreground="{DynamicResource Brush.TextLabel}"
                                       VerticalAlignment="Center" Margin="0,0,10,8"/>
                            <TextBox  x:Name="TxtName" Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2"
                                      Padding="6,4" Margin="0,0,0,8"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:T Browsers_Exe}" Foreground="{DynamicResource Brush.TextLabel}"
                                       VerticalAlignment="Center" Margin="0,0,10,8"/>
                            <TextBox  x:Name="TxtExe" Grid.Row="1" Grid.Column="1" Padding="6,4"
                                      Margin="0,0,8,8" FontFamily="Consolas" FontSize="11"/>
                            <Button   x:Name="BtnBrowseExe" Grid.Row="1" Grid.Column="2" Content="…" Width="30"
                              AutomationProperties.Name="{loc:T Browsers_Exe}"
                                      Padding="0" Margin="0,0,0,8"
                                      Style="{StaticResource SecondaryButton}" Click="BrowseExe_Click"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="{loc:T Browsers_Args}" Foreground="{DynamicResource Brush.TextLabel}"
                                       VerticalAlignment="Center" Margin="0,0,10,8"/>
                            <TextBox  x:Name="TxtArgs" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2"
                                      Padding="6,4" Margin="0,0,0,8" FontFamily="Consolas" FontSize="11"
                                      ToolTip="{loc:T Browsers_Args_Tip}"/>

                            <TextBlock x:Name="TxtProfileInfo" Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2"
                                       Visibility="Collapsed" Foreground="{DynamicResource Brush.TextHint}" FontSize="11"
                                       TextWrapping="Wrap" Margin="0,0,0,8"/>

                            <Button   x:Name="BtnApply" Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2"
                                      Content="{loc:T Common_Apply}" HorizontalAlignment="Right"
                                      Style="{StaticResource PrimaryButton}" Click="Apply_Click"/>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ══ Onglet Règles de domaine ══ -->
            <TabItem Header="{loc:T Browsers_Tab_Rules}">
                <Grid Margin="8,14,8,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="{loc:T Browsers_Rules_Intro}"
                               Foreground="{DynamicResource Brush.TextHint}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,10"/>

                    <!-- Recherche + filtre -->
                    <Grid Grid.Row="1" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TxtRuleSearch" Grid.Column="0" Padding="6,5" Margin="0,0,8,0"
                                 AutomationProperties.Name="{loc:T Browsers_Rules_Search_Tip}"
                                 FontSize="12" TextChanged="RuleFilter_Changed"
                                 ToolTip="{loc:T Browsers_Rules_Search_Tip}"/>
                        <ComboBox x:Name="CmbRuleFilter" Grid.Column="1" Width="190"
                                  DisplayMemberPath="Name" SelectedValuePath="Id"
                                  SelectionChanged="RuleFilter_Changed"/>
                    </Grid>

                    <!-- Liste des règles -->
                    <ListBox x:Name="LstRules" Grid.Row="2"
                             HorizontalContentAlignment="Stretch"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="2,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="190"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Host}" FontFamily="Consolas"
                                               FontSize="12" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"/>
                                    <ComboBox Grid.Column="1" Margin="8,0"
                                              ItemsSource="{Binding Browsers}"
                                              DisplayMemberPath="Name" SelectedValuePath="Id"
                                              SelectedValue="{Binding Rule.BrowserId, Mode=OneTime}"
                                              SelectionChanged="RuleBrowser_Changed"
                                              ToolTip="{loc:T Browsers_Rules_Browser_Tip}"/>
                                    <Button Grid.Column="2" Content="🗑" Width="30"
                                        AutomationProperties.Name="{loc:T Browsers_Rules_Delete_Tip}"
                                            Style="{StaticResource SecondaryButton}" Padding="4"
                                            Click="DeleteRule_Click" ToolTip="{loc:T Browsers_Rules_Delete_Tip}"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock x:Name="TxtRulesEmpty" Grid.Row="2" Foreground="{DynamicResource Brush.TextFaint}" FontSize="12"
                               TextWrapping="Wrap" TextAlignment="Center" MaxWidth="380"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="Collapsed"
                               Text="{loc:T Browsers_Rules_Empty}"/>

                    <TextBlock x:Name="TxtRulesCount" Grid.Row="3" Foreground="{DynamicResource Brush.TextHint}" FontSize="11"
                               Margin="2,8,0,0"/>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- Footer -->
        <Border Grid.Row="2" Style="{StaticResource DialogFooter}">
            <Grid>
                <TextBlock x:Name="TxtVersion" Style="{StaticResource FooterVersion}"/>
                <Button Content="{loc:T Common_Close}" Style="{StaticResource SecondaryButton}"
                        HorizontalAlignment="Right" Click="Close_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>
