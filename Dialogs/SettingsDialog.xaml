<Window x:Class="DockPad.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Paramètres"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F3F3F3"
        FontFamily="Segoe UI">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#0078D4" Padding="20,14">
            <TextBlock Text="Paramètres" FontSize="16"
                       FontWeight="SemiBold" Foreground="White"/>
        </Border>

        <!-- Content -->
        <StackPanel Grid.Row="1" Margin="24,20">
            <TextBlock Text="Raccourci clavier global" FontWeight="SemiBold"
                       FontSize="13" Margin="0,0,0,14"/>

            <TextBlock Text="Modificateurs :" Foreground="#555" Margin="0,0,0,8"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                <CheckBox x:Name="ChkCtrl"  Content="Ctrl"  Margin="0,0,16,0" VerticalContentAlignment="Center"/>
                <CheckBox x:Name="ChkAlt"   Content="Alt"   Margin="0,0,16,0" VerticalContentAlignment="Center"/>
                <CheckBox x:Name="ChkShift" Content="Shift" Margin="0,0,16,0" VerticalContentAlignment="Center"/>
                <CheckBox x:Name="ChkWin"   Content="Win"   VerticalContentAlignment="Center"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                <TextBlock Text="Touche :" VerticalAlignment="Center"
                           Foreground="#555" Margin="0,0,12,0"/>
                <ComboBox x:Name="CmbKey" Width="120"/>
            </StackPanel>

            <TextBlock x:Name="TxtPreview" Foreground="#0078D4" FontSize="12"/>

            <Separator Margin="0,20,0,16"/>

            <TextBlock Text="Démarrage" FontWeight="SemiBold"
                       FontSize="13" Margin="0,0,0,14"/>
            <CheckBox x:Name="ChkAutoStart" Content="Démarrer avec Windows"
                      VerticalContentAlignment="Center"/>
            <TextBlock x:Name="TxtAutoStartPath" Margin="0,8,0,0"
                       Foreground="#888" FontSize="11" TextWrapping="Wrap"
                       FontFamily="Consolas"/>

            <Separator Margin="0,20,0,16"/>

            <TextBlock Text="Claude Code" FontWeight="SemiBold"
                       FontSize="13" Margin="0,0,0,14"/>
            <TextBlock Text="Arguments supplémentaires :" Foreground="#555" Margin="0,0,0,8"/>
            <TextBox x:Name="TxtClaudeArgs" FontFamily="Consolas" FontSize="12"
                     Padding="6,5" BorderBrush="#CCCCCC" BorderThickness="1"
                     ToolTip="Ex : --enable-auto-mode"/>
        </StackPanel>

        <!-- Buttons -->
        <Border Grid.Row="2" Background="White" Padding="24,12"
                BorderBrush="#E0E0E0" BorderThickness="0,1,0,0">
            <Grid>
                <TextBlock x:Name="TxtVersion" VerticalAlignment="Center"
                           Foreground="#AAA" FontSize="11"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Sauvegarder" Style="{StaticResource PrimaryButton}"
                            Margin="0,0,8,0" Click="Save_Click"/>
                    <Button Content="Annuler" Style="{StaticResource SecondaryButton}"
                            Click="Cancel_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
