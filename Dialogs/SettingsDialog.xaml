<Window x:Class="DockPad.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Paramètres"
        Width="500" SizeToContent="Height"
        MaxHeight="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Height}"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F3F3F3"
        FontFamily="Segoe UI">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#0078D4" Padding="20,14">
            <TextBlock Text="Paramètres" FontSize="16"
                       FontWeight="SemiBold" Foreground="White"/>
        </Border>

        <!-- Content -->
        <StackPanel Grid.Row="1" Margin="24,20">
            <TextBlock Text="Raccourci clavier global" FontWeight="SemiBold"
                       FontSize="13" Margin="0,0,0,14"/>

            <TextBlock Text="Modificateurs :" Foreground="#555" Margin="0,0,0,8"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                <CheckBox x:Name="ChkCtrl"  Content="Ctrl"  Margin="0,0,16,0" VerticalContentAlignment="Center"/>
                <CheckBox x:Name="ChkAlt"   Content="Alt"   Margin="0,0,16,0" VerticalContentAlignment="Center"/>
                <CheckBox x:Name="ChkShift" Content="Shift" Margin="0,0,16,0" VerticalContentAlignment="Center"/>
                <CheckBox x:Name="ChkWin"   Content="Win"   VerticalContentAlignment="Center"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                <TextBlock Text="Touche :" VerticalAlignment="Center"
                           Foreground="#555" Margin="0,0,12,0"/>
                <ComboBox x:Name="CmbKey" Width="120"/>
            </StackPanel>

            <TextBlock x:Name="TxtPreview" Foreground="#0078D4" FontSize="12"/>

            <Separator Margin="0,20,0,16"/>

            <TextBlock Text="Raccourcis des tuiles" FontWeight="SemiBold"
                       FontSize="13" Margin="0,0,0,6"/>
            <TextBlock Text="Modificateur + 1-9 / 0 / ↑ / ↓ exécute une tuile de la moitié gauche ou droite de la grille."
                       Foreground="#888" FontSize="11" Margin="0,0,0,10" TextWrapping="Wrap"/>
            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Moitié gauche :" VerticalAlignment="Center"
                           Foreground="#555" Margin="0,0,12,8"/>
                <ComboBox  Grid.Row="0" Grid.Column="1" x:Name="CmbTriggerFirst"  Width="200" Margin="0,0,0,8"/>
                <TextBlock Grid.Row="1" Grid.Column="0" Text="Moitié droite :" VerticalAlignment="Center"
                           Foreground="#555" Margin="0,0,12,0"/>
                <ComboBox  Grid.Row="1" Grid.Column="1" x:Name="CmbTriggerSecond" Width="200"/>
            </Grid>
            <TextBlock x:Name="TxtTriggerWarn" Foreground="#C42B1C" FontSize="11"
                       TextWrapping="Wrap" Visibility="Collapsed"/>

            <Separator Margin="0,20,0,16"/>

            <TextBlock Text="Démarrage" FontWeight="SemiBold"
                       FontSize="13" Margin="0,0,0,14"/>
            <CheckBox x:Name="ChkAutoStart" Content="Démarrer avec Windows"
                      VerticalContentAlignment="Center"/>
            <TextBlock x:Name="TxtAutoStartPath" Margin="0,8,0,0"
                       Foreground="#888" FontSize="11" TextWrapping="Wrap"
                       FontFamily="Consolas"/>

            <Separator Margin="0,20,0,16"/>

            <TextBlock Text="Claude Code" FontWeight="SemiBold"
                       FontSize="13" Margin="0,0,0,14"/>
            <TextBlock Text="Arguments supplémentaires :" Foreground="#555" Margin="0,0,0,8"/>
            <TextBox x:Name="TxtClaudeArgs" FontFamily="Consolas" FontSize="12"
                     Padding="6,5" BorderBrush="#CCCCCC" BorderThickness="1"
                     ToolTip="Ex : --enable-auto-mode"/>
        </StackPanel>

        <!-- Footer -->
        <Border Grid.Row="2" Style="{StaticResource DialogFooter}">
            <Grid>
                <TextBlock x:Name="TxtVersion" Style="{StaticResource FooterVersion}"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Sauvegarder" Style="{StaticResource PrimaryButton}"
                            Margin="0,0,8,0" Click="Save_Click"/>
                    <Button Content="Annuler" Style="{StaticResource SecondaryButton}"
                            Click="Cancel_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
