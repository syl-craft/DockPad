<Window x:Class="DockPad.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:DockPad.Services.Localization"
        Title="{loc:T Settings_Title}"
        Width="500" SizeToContent="Height"
        MaxHeight="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Height}"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource Brush.Surface}"
        FontFamily="Segoe UI">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{DynamicResource Brush.Accent}" Padding="20,14">
            <TextBlock Text="{loc:T Settings_Title}" FontSize="16"
                       FontWeight="SemiBold" Foreground="White"/>
        </Border>

        <!-- Content -->
        <StackPanel Grid.Row="1" Margin="24,20">
            <TextBlock Text="{loc:T Settings_Language_Section}" FontWeight="SemiBold"
                       FontSize="13" Margin="0,0,0,14"/>
            <!-- Application immediate : la fenetre se retraduit sous les yeux, ce qui est la
                 demonstration la plus directe que la bascule fonctionne. Les noms de langue ne sont
                 pas traduits — une langue s'ecrit dans sa propre langue. -->
            <ComboBox x:Name="CmbLanguage" Width="240" HorizontalAlignment="Left"
                      SelectionChanged="Language_SelectionChanged"/>

            <Separator Margin="0,20,0,16"/>

            <TextBlock Text="{loc:T Settings_Theme_Section}" FontWeight="SemiBold"
                       FontSize="13" Margin="0,0,0,14"/>
            <ComboBox x:Name="CmbTheme" Width="240" HorizontalAlignment="Left"
                      SelectionChanged="Theme_SelectionChanged"/>

            <Separator Margin="0,20,0,16"/>

            <TextBlock Text="{loc:T Settings_Hotkey_Section}" FontWeight="SemiBold"
                       FontSize="13" Margin="0,0,0,14"/>

            <TextBlock Text="{loc:T Settings_Hotkey_Modifiers}" Foreground="{DynamicResource Brush.TextLabel}" Margin="0,0,0,8"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                <CheckBox x:Name="ChkCtrl"  Content="Ctrl"  Margin="0,0,16,0" VerticalContentAlignment="Center"/>
                <CheckBox x:Name="ChkAlt"   Content="Alt"   Margin="0,0,16,0" VerticalContentAlignment="Center"/>
                <CheckBox x:Name="ChkShift" Content="Shift" Margin="0,0,16,0" VerticalContentAlignment="Center"/>
                <CheckBox x:Name="ChkWin"   Content="Win"   VerticalContentAlignment="Center"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                <TextBlock Text="{loc:T Settings_Hotkey_Key}" VerticalAlignment="Center"
                           Foreground="{DynamicResource Brush.TextLabel}" Margin="0,0,12,0"/>
                <ComboBox x:Name="CmbKey" Width="120"/>
            </StackPanel>

            <TextBlock x:Name="TxtPreview" Foreground="{DynamicResource Brush.Accent}" FontSize="12"/>

            <Separator Margin="0,20,0,16"/>

            <TextBlock Text="{loc:T Settings_Tiles_Section}" FontWeight="SemiBold"
                       FontSize="13" Margin="0,0,0,6"/>
            <TextBlock Text="{loc:T Settings_Tiles_Help}"
                       Foreground="{DynamicResource Brush.TextHint}" FontSize="11" Margin="0,0,0,10" TextWrapping="Wrap"/>
            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:T Settings_Tiles_LeftHalf}" VerticalAlignment="Center"
                           Foreground="{DynamicResource Brush.TextLabel}" Margin="0,0,12,8"/>
                <ComboBox  Grid.Row="0" Grid.Column="1" x:Name="CmbTriggerFirst"  Width="200" Margin="0,0,0,8"/>
                <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:T Settings_Tiles_RightHalf}" VerticalAlignment="Center"
                           Foreground="{DynamicResource Brush.TextLabel}" Margin="0,0,12,0"/>
                <ComboBox  Grid.Row="1" Grid.Column="1" x:Name="CmbTriggerSecond" Width="200"/>
            </Grid>
            <TextBlock x:Name="TxtTriggerWarn" Foreground="{DynamicResource Brush.Danger}" FontSize="11"
                       TextWrapping="Wrap" Visibility="Collapsed"/>

            <Separator Margin="0,20,0,16"/>

            <TextBlock Text="{loc:T Settings_Startup_Section}" FontWeight="SemiBold"
                       FontSize="13" Margin="0,0,0,14"/>
            <CheckBox x:Name="ChkAutoStart" Content="{loc:T Settings_Startup_WithWindows}"
                      VerticalContentAlignment="Center"/>
            <TextBlock x:Name="TxtAutoStartPath" Margin="0,8,0,0"
                       Foreground="{DynamicResource Brush.TextHint}" FontSize="11" TextWrapping="Wrap"
                       FontFamily="Consolas"/>

            <Separator Margin="0,20,0,16"/>

            <TextBlock Text="{loc:T Settings_Claude_Section}" FontWeight="SemiBold"
                       FontSize="13" Margin="0,0,0,14"/>
            <TextBlock Text="{loc:T Settings_Claude_ExtraArgs}" Foreground="{DynamicResource Brush.TextLabel}" Margin="0,0,0,8"/>
            <TextBox x:Name="TxtClaudeArgs" FontFamily="Consolas" FontSize="12"
                     Padding="6,5" BorderBrush="{DynamicResource Brush.BorderStrong}" BorderThickness="1"
                     ToolTip="{loc:T Settings_Claude_ArgsHint}"/>

            <Separator Margin="0,20,0,16"/>

            <TextBlock Text="{loc:T Settings_Network_Section}" FontWeight="SemiBold"
                       FontSize="13" Margin="0,0,0,14"/>
            <CheckBox x:Name="ChkAutoFavicon" Content="{loc:T Settings_Network_AutoFavicon}"
                      VerticalContentAlignment="Center"/>
            <TextBlock Text="{loc:T Settings_Network_AutoFaviconHint}" Margin="0,8,0,0"
                       Foreground="{DynamicResource Brush.TextHint}" FontSize="11" TextWrapping="Wrap"/>
        </StackPanel>

        <!-- Footer -->
        <Border Grid.Row="2" Style="{StaticResource DialogFooter}">
            <Grid>
                <TextBlock x:Name="TxtVersion" Style="{StaticResource FooterVersion}"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="{loc:T Common_Save}" Style="{StaticResource PrimaryButton}"
                            Margin="0,0,8,0" Click="Save_Click"/>
                    <Button Content="{loc:T Common_Cancel}" Style="{StaticResource SecondaryButton}"
                            Click="Cancel_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
