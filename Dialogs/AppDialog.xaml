<Window x:Class="DockPad.AppDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:DockPad.Services.Localization"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        SizeToContent="Height"
        Width="400"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI"
        ShowInTaskbar="False">

    <Border Margin="16" CornerRadius="10" Background="White"
            SnapsToDevicePixels="True" UseLayoutRounding="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="32" ShadowDepth="6" Opacity="0.18" Direction="270"/>
        </Border.Effect>

        <Grid>
            <!-- Bande colorée en haut -->
            <Border x:Name="AccentBar" Height="4" VerticalAlignment="Top"
                    CornerRadius="10,10,0,0"
                    SnapsToDevicePixels="True" UseLayoutRounding="True"/>

            <StackPanel Margin="24,22,24,24">

                <!-- Icône + Titre -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <Border x:Name="IconBadge" Width="34" Height="34" CornerRadius="17"
                            Margin="0,0,12,0" VerticalAlignment="Center"
                            SnapsToDevicePixels="True" UseLayoutRounding="True">
                        <TextBlock x:Name="IconText" FontSize="16" FontWeight="SemiBold"
                                   Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock x:Name="TitleText" FontSize="15" FontWeight="SemiBold"
                               Foreground="#1A1A1A" VerticalAlignment="Center"
                               TextWrapping="Wrap" MaxWidth="290"/>
                </StackPanel>

                <!-- Message -->
                <TextBlock x:Name="MessageText" FontSize="13" Foreground="#555555"
                           TextWrapping="Wrap" LineHeight="20" Margin="0,0,0,0"/>

                <!-- Boutons -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                    <Button x:Name="BtnSecondary" Content="{loc:T Common_No}"
                            Style="{StaticResource SecondaryButton}"
                            Padding="18,7" Margin="0,0,8,0"
                            Visibility="Collapsed"
                            Click="BtnSecondary_Click"/>
                    <Button x:Name="BtnPrimary" Content="{loc:T Common_Ok}"
                            Padding="18,7"
                            Click="BtnPrimary_Click"/>
                </StackPanel>

            </StackPanel>
        </Grid>
    </Border>
</Window>
