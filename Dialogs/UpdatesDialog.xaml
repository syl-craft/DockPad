<Window x:Class="DockPad.UpdatesDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:DockPad.Services.Localization;assembly=DockPad.Core"
        Title="{loc:T Update_Title}" Width="580" Height="440" MinWidth="480" MinHeight="360"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource Brush.Surface}" FontFamily="Segoe UI">
    <Grid TextElement.Foreground="{DynamicResource Brush.Text}">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Margin="20,18,20,12">
            <TextBlock Text="{loc:T Update_Title}" FontSize="16" FontWeight="SemiBold"/>
            <TextBlock Text="{Binding CurrentVersion}" Foreground="{DynamicResource Brush.TextMuted}" Margin="0,6,0,12"/>
            <TextBlock Text="{Binding Status}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
            <ProgressBar Height="5" Minimum="0" Maximum="100" Value="{Binding Progress, Mode=OneWay}" Margin="0,12,0,12"
                         IsIndeterminate="{Binding IsIndeterminate, Mode=OneWay}"
                         Visibility="{Binding ShowsProgress, Converter={StaticResource BoolToVisibilityConverter}}"
                         AutomationProperties.Name="{loc:T Update_Progress}"/>
            <CheckBox x:Name="Automatic" Content="{loc:T Update_Automatic}" Click="Automatic_Click" Margin="0,8,0,0"/>
            <Button Content="{loc:T Update_DownloadLatest}" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Margin="0,12,0,0"
                    Visibility="{Binding IsUnavailable, Converter={StaticResource BoolToVisibilityConverter}}" Click="DownloadLatest_Click"/>
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="20,0,20,16">
            <TextBlock Text="{Binding Notes}" TextWrapping="Wrap"/>
        </ScrollViewer>
        <Border Grid.Row="2" Style="{StaticResource DialogFooter}">
            <WrapPanel HorizontalAlignment="Right">
                <Button Content="{loc:T Update_Check}" Style="{StaticResource SecondaryButton}" IsEnabled="{Binding CanCheck}" Click="Check_Click" Margin="0,0,8,6"/>
                <Button x:Name="InstallButton" Content="{loc:T Update_Install}" Style="{StaticResource PrimaryButton}" IsEnabled="{Binding CanInstall}" Click="Install_Click" Margin="0,0,8,6"/>
                <Button Content="{loc:T Common_Cancel}" Style="{StaticResource SecondaryButton}" Click="Cancel_Click" Margin="0,0,0,6"/>
            </WrapPanel>
        </Border>
    </Grid>
</Window>
