<Window x:Class="DockPad.UsageConfigDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:DockPad.Views"
        xmlns:loc="clr-namespace:DockPad.Services.Localization;assembly=DockPad.Core"
        xmlns:models="clr-namespace:DockPad.Models;assembly=DockPad.Core"
        xmlns:appmodels="clr-namespace:DockPad.Models"
        Title="{loc:T UsageCfg_Title}"
        Width="1000" Height="760"
        MaxHeight="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Height}"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize" MinWidth="820" MinHeight="420"
        Background="{DynamicResource Brush.Surface}"
        FontFamily="Segoe UI">
    <Window.Resources>
        <!-- Une mosaïque de tuiles pour le mini-schéma des positions. -->
        <DrawingBrush x:Key="SchemaTiles" TileMode="Tile" ViewportUnits="Absolute" Viewport="0,0,18,16"
                      ViewboxUnits="Absolute" Viewbox="0,0,18,16">
            <DrawingBrush.Drawing>
                <GeometryDrawing Brush="{DynamicResource Brush.BorderSubtle}">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="1.5,1.5,15,13" RadiusX="2" RadiusY="2"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingBrush.Drawing>
        </DrawingBrush>

        <!-- Un titre et son contrôle : inactifs ensemble, et pâlis ensemble. -->
        <Style x:Key="DisableableGroup" TargetType="StackPanel">
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.45"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ChoiceList" TargetType="ListBox" BasedOn="{StaticResource {x:Type ListBox}}">
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="-3,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <!-- Un gabarit sans fond : celui de Windows peint un fond blanc dès que la liste est inactive. -->
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBox">
                        <ItemsPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="1"/>
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ChoiceCard" TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
            <Setter Property="Padding" Value="4,8"/>
            <Setter Property="Margin" Value="3,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Background" Value="{DynamicResource Brush.SurfaceCard}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True" UseLayoutRounding="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Brush.SurfaceHover}"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
                    <Setter Property="Background" Value="{DynamicResource Brush.AccentSoft}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid TextElement.Foreground="{DynamicResource Brush.Text}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="3*"/>
        </Grid.ColumnDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Grid.ColumnSpan="2" Background="{DynamicResource Brush.Accent}" Padding="20,14">
            <TextBlock Text="{loc:T UsageCfg_Title}" FontSize="16" FontWeight="SemiBold" Foreground="White"/>
        </Border>

        <!-- Réglages du bandeau. Sauvegarde immédiate à chaque changement. -->
        <Border Grid.Row="1" Grid.RowSpan="2" Grid.Column="0" VerticalAlignment="Top"
                Background="{DynamicResource Brush.SurfaceCard}" Margin="16,12,6,12" Padding="16,12"
                BorderBrush="{DynamicResource Brush.BorderSoft}" BorderThickness="1" CornerRadius="8"
                SnapsToDevicePixels="True" UseLayoutRounding="True">
            <!-- Défilement : la section Ollama et ses messages d'erreur dépassent la hauteur
                 minimale de la fenêtre (420 px). -->
            <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Grid.IsSharedSizeScope="True">
                <TextBlock Text="{loc:T UsageCfg_Banner}" FontWeight="SemiBold" Margin="0,0,0,10"/>

                <CheckBox x:Name="ChkEnabled" Content="{loc:T UsageCfg_ShowBanner}"
                          VerticalContentAlignment="Center" Margin="0,0,0,10"
                          Click="Setting_Changed"/>

                <!-- Position : le bandeau sous la grille, ou la barre à sa droite. -->
                <StackPanel x:Name="GrpPosition" Style="{StaticResource DisableableGroup}" Margin="0,0,0,14">
                    <TextBlock Text="{loc:T UsageCfg_Position}" Foreground="{DynamicResource Brush.TextLabel}" Margin="0,0,0,6"/>
                    <ListBox x:Name="LstPlacement" Style="{StaticResource ChoiceList}"
                             ItemContainerStyle="{StaticResource ChoiceCard}"
                             AutomationProperties.Name="{loc:T UsageCfg_Position}"
                             SelectionChanged="Setting_Changed">
                        <ListBoxItem Tag="{x:Static appmodels:UsagePlacement.Bottom}"
                                     AutomationProperties.Name="{loc:T UsageCfg_Position_Bottom}">
                            <StackPanel>
                                <Border Width="124" Height="80" Padding="6" CornerRadius="4" HorizontalAlignment="Center"
                                        Background="{DynamicResource Brush.SurfaceAlt}"
                                        BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
                                    <StackPanel>
                                        <Rectangle Width="108" Height="48" Fill="{StaticResource SchemaTiles}"/>
                                        <Rectangle Width="108" Height="12" Margin="0,6,0,0" RadiusX="3" RadiusY="3"
                                                   Fill="{DynamicResource Brush.Accent}"/>
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="{loc:T UsageCfg_Position_Bottom}" FontWeight="SemiBold"
                                           TextAlignment="Center" Margin="0,8,0,0"/>
                                <TextBlock Text="{loc:T UsageCfg_Position_Bottom_Sub}" FontSize="11" TextWrapping="Wrap"
                                           TextAlignment="Center" Foreground="{DynamicResource Brush.TextHint}"/>
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="{x:Static appmodels:UsagePlacement.Right}"
                                     AutomationProperties.Name="{loc:T UsageCfg_Position_Right}">
                            <StackPanel>
                                <Border Width="124" Height="80" Padding="6" CornerRadius="4" HorizontalAlignment="Center"
                                        Background="{DynamicResource Brush.SurfaceAlt}"
                                        BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
                                        <Rectangle Width="90" Height="64" Fill="{StaticResource SchemaTiles}"/>
                                        <Rectangle Width="14" Height="64" Margin="4,0,0,0" RadiusX="3" RadiusY="3"
                                                   Fill="{DynamicResource Brush.Accent}"/>
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="{loc:T UsageCfg_Position_Right}" FontWeight="SemiBold"
                                           TextAlignment="Center" Margin="0,8,0,0"/>
                                <TextBlock Text="{loc:T UsageCfg_Position_Right_Sub}" FontSize="11" TextWrapping="Wrap"
                                           TextAlignment="Center" Foreground="{DynamicResource Brush.TextHint}"/>
                            </StackPanel>
                        </ListBoxItem>
                    </ListBox>
                </StackPanel>

                <!-- Style de la barre : quatre vignettes, chacune une vraie barre d'exemple à valeurs fixes. -->
                <StackPanel x:Name="GrpBarStyle" Style="{StaticResource DisableableGroup}" Margin="0,0,0,14">
                    <TextBlock Text="{loc:T UsageCfg_BarStyle}" Foreground="{DynamicResource Brush.TextLabel}" Margin="0,0,0,6"/>
                    <ListBox x:Name="LstBarStyle" Style="{StaticResource ChoiceList}"
                             ItemContainerStyle="{StaticResource ChoiceCard}"
                             AutomationProperties.Name="{loc:T UsageCfg_BarStyle}"
                             SelectionChanged="Setting_Changed">
                        <ListBoxItem Tag="{x:Static models:SideStripStyle.Columns}"
                                     AutomationProperties.Name="{loc:T UsageCfg_Style_Columns}">
                            <StackPanel>
                                <Viewbox Height="184" Stretch="Uniform" HorizontalAlignment="Center">
                                    <views:UsageBar x:Name="SampleColumns" Width="90" Height="390"
                                                    IsHitTestVisible="False" IsTabStop="False" KeyboardNavigation.TabNavigation="None"/>
                                </Viewbox>
                                <TextBlock Text="{loc:T UsageCfg_Style_Columns}" Margin="0,8,0,0"
                                           TextAlignment="Center" TextWrapping="Wrap"/>
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="{x:Static models:SideStripStyle.HeroStack}"
                                     AutomationProperties.Name="{loc:T UsageCfg_Style_Hero}">
                            <StackPanel>
                                <Viewbox Height="184" Stretch="Uniform" HorizontalAlignment="Center">
                                    <views:UsageBar x:Name="SampleHero" Width="90" Height="390"
                                                    IsHitTestVisible="False" IsTabStop="False" KeyboardNavigation.TabNavigation="None"/>
                                </Viewbox>
                                <TextBlock Text="{loc:T UsageCfg_Style_Hero}" Margin="0,8,0,0"
                                           TextAlignment="Center" TextWrapping="Wrap"/>
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="{x:Static models:SideStripStyle.Rings}"
                                     AutomationProperties.Name="{loc:T UsageCfg_Style_Rings}">
                            <StackPanel>
                                <Viewbox Height="184" Stretch="Uniform" HorizontalAlignment="Center">
                                    <views:UsageBar x:Name="SampleRings" Width="90" Height="390"
                                                    IsHitTestVisible="False" IsTabStop="False" KeyboardNavigation.TabNavigation="None"/>
                                </Viewbox>
                                <TextBlock Text="{loc:T UsageCfg_Style_Rings}" Margin="0,8,0,0"
                                           TextAlignment="Center" TextWrapping="Wrap"/>
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="{x:Static models:SideStripStyle.Reservoir}"
                                     AutomationProperties.Name="{loc:T UsageCfg_Style_Reservoir}">
                            <StackPanel>
                                <Viewbox Height="184" Stretch="Uniform" HorizontalAlignment="Center">
                                    <views:UsageBar x:Name="SampleReservoir" Width="90" Height="390"
                                                    IsHitTestVisible="False" IsTabStop="False" KeyboardNavigation.TabNavigation="None"/>
                                </Viewbox>
                                <TextBlock Text="{loc:T UsageCfg_Style_Reservoir}" Margin="0,8,0,0"
                                           TextAlignment="Center" TextWrapping="Wrap"/>
                            </StackPanel>
                        </ListBoxItem>
                    </ListBox>
                </StackPanel>

                <!-- IA mise en avant : manuel, ou la plus proche de sa limite. -->
                <StackPanel x:Name="GrpFocus" Style="{StaticResource DisableableGroup}" Margin="0,0,0,14">
                    <TextBlock Text="{loc:T UsageCfg_Focus}" Foreground="{DynamicResource Brush.TextLabel}" Margin="0,0,0,6"/>
                    <RadioButton x:Name="RbFocusManual" GroupName="UsageFocus" Margin="0,0,0,8"
                                 AutomationProperties.Name="{loc:T UsageCfg_Focus_Manual}"
                                 Checked="Setting_Changed">
                        <StackPanel>
                            <TextBlock Text="{loc:T UsageCfg_Focus_Manual}" FontWeight="SemiBold"/>
                            <TextBlock Text="{loc:T UsageCfg_Focus_Manual_Sub}" FontSize="11" TextWrapping="Wrap"
                                       Foreground="{DynamicResource Brush.TextHint}"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="RbFocusAuto" GroupName="UsageFocus"
                                 AutomationProperties.Name="{loc:T UsageCfg_Focus_Auto}"
                                 Checked="Setting_Changed" Click="Auto_Click">
                        <StackPanel>
                            <TextBlock Text="{loc:T UsageCfg_Focus_Auto}" FontWeight="SemiBold"/>
                            <TextBlock Text="{loc:T UsageCfg_Focus_Auto_Sub}" FontSize="11" TextWrapping="Wrap"
                                       Foreground="{DynamicResource Brush.TextHint}"/>
                        </StackPanel>
                    </RadioButton>
                </StackPanel>

                <!-- Charge du PC : le processeur et la mémoire, et la courbe du style Héros. -->
                <StackPanel x:Name="GrpSystemLoad" Style="{StaticResource DisableableGroup}" Margin="0,0,0,14">
                    <TextBlock Text="{loc:T UsageCfg_SystemLoad}" Foreground="{DynamicResource Brush.TextLabel}" Margin="0,0,0,6"/>
                    <CheckBox x:Name="ChkShowSystemLoad" Content="{loc:T UsageCfg_ShowSystemLoad}"
                              VerticalContentAlignment="Center" Margin="0,0,0,8"
                              Click="Setting_Changed"/>
                    <CheckBox x:Name="ChkShowLoadHistory" Content="{loc:T UsageCfg_ShowLoadHistory}"
                              VerticalContentAlignment="Center"
                              Click="Setting_Changed"/>
                </StackPanel>

                <CheckBox x:Name="ChkShowCost" Content="{loc:T UsageCfg_ShowCost}"
                          VerticalContentAlignment="Center" Margin="0,0,0,12"
                          Click="Setting_Changed"
                          ToolTip="{loc:T UsageCfg_ShowCost_Tip}"/>

                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{loc:T UsageCfg_AlertThreshold}" Foreground="{DynamicResource Brush.TextLabel}"
                               VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <ComboBox Grid.Column="1" x:Name="CmbThreshold" Width="140"
                              HorizontalAlignment="Left"
                              SelectionChanged="Setting_Changed"
                              ToolTip="{loc:T UsageCfg_AlertThreshold_Tip}"/>
                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{loc:T UsageCfg_DefaultProvider}" Foreground="{DynamicResource Brush.TextLabel}"
                               VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <ComboBox Grid.Column="1" x:Name="CmbDefaultProvider" Width="200"
                              HorizontalAlignment="Left" DisplayMemberPath="Label"
                              SelectionChanged="Setting_Changed"
                              ToolTip="{loc:T UsageCfg_DefaultProvider_Tip}"/>
                </Grid>

                <!-- Agent local (Ollama) : alimente le prédéfini « Ouvrir un agent local ».
                     Sauvegarde immédiate, mais seulement d'une valeur qui passe la liste blanche. -->
                <Border Height="1" Background="{DynamicResource Brush.BorderSoft}" Margin="0,16,0,12"/>

                <TextBlock Text="{loc:T UsageCfg_Ollama}" FontWeight="SemiBold" Margin="0,0,0,10"/>

                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="OllamaLabel"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:T UsageCfg_OllamaHarness}" Foreground="{DynamicResource Brush.TextLabel}"
                               VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBox Grid.Row="0" Grid.Column="1" x:Name="TxtOllamaHarness" Width="200" HorizontalAlignment="Left"
                             MaxLength="40" TextChanged="Ollama_TextChanged"
                             AutomationProperties.Name="{loc:T UsageCfg_OllamaHarness}"
                             ToolTip="{loc:T UsageCfg_OllamaHarness_Tip}"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" x:Name="TxtOllamaHarnessError" TextWrapping="Wrap"
                               Foreground="{DynamicResource Brush.Danger}" FontSize="11" Margin="0,3,0,0"
                               Visibility="Collapsed"/>
                </Grid>

                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="OllamaLabel"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:T UsageCfg_OllamaModel}" Foreground="{DynamicResource Brush.TextLabel}"
                               VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBox Grid.Row="0" Grid.Column="1" x:Name="TxtOllamaModel" Width="200" HorizontalAlignment="Left"
                             MaxLength="100" TextChanged="Ollama_TextChanged"
                             AutomationProperties.Name="{loc:T UsageCfg_OllamaModel}"
                             ToolTip="{loc:T UsageCfg_OllamaModel_Tip}"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" x:Name="TxtOllamaModelError" TextWrapping="Wrap"
                               Foreground="{DynamicResource Brush.Danger}" FontSize="11" Margin="0,3,0,0"
                               Visibility="Collapsed"/>
                </Grid>

                <TextBlock Text="{loc:T UsageCfg_OllamaHelp}" TextWrapping="Wrap" FontSize="11"
                           Foreground="{DynamicResource Brush.TextMuted}" Margin="0,2,0,6"/>
                <TextBlock x:Name="TxtOllamaStatus" TextWrapping="Wrap" FontSize="11"
                           Foreground="{DynamicResource Brush.TextMuted}"/>
            </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Fournisseurs détectés -->
        <Border Grid.Row="1" Grid.RowSpan="2" Grid.Column="1"
                Background="{DynamicResource Brush.SurfaceCard}" Margin="6,12,16,12" Padding="16,12"
                BorderBrush="{DynamicResource Brush.BorderSoft}" BorderThickness="1" CornerRadius="8"
                SnapsToDevicePixels="True" UseLayoutRounding="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <TextBlock Text="{loc:T UsageCfg_Providers}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <!-- Bouton carré : Padding="0" obligatoire, le 16,8 hérité de PrimaryButton
                         ne laisserait que 2 px au glyphe. -->
                    <Button Content="{loc:T UsageCfg_Redetect}" Style="{StaticResource SecondaryButton}"
                            HorizontalAlignment="Right" Padding="10,5" FontSize="12"
                            Click="Redetect_Click"
                            ToolTip="{loc:T UsageCfg_Redetect_Tip}"/>
                </Grid>

                <ListBox Grid.Row="1" x:Name="LstProviders"
                         HorizontalContentAlignment="Stretch"
                         BorderThickness="1" BorderBrush="{DynamicResource Brush.BorderSubtle}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="2,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <CheckBox Grid.Column="0" IsChecked="{Binding Visible, Mode=OneTime}"
                                          VerticalAlignment="Center" Margin="0,0,10,0"
                                          Click="VisibleCheck_Click"
                                          ToolTip="{loc:T UsageCfg_Visible_Tip}"/>

                                <views:ProviderIcon Grid.Column="1" Width="20" Height="20" VerticalAlignment="Center"
                                            ProviderId="{Binding Id}" Glyph="{Binding Glyph}"
                                            Accent="{Binding Accent, Converter={StaticResource StringToBrushConverter}}"/>

                                <StackPanel Grid.Column="2" Margin="10,0,0,0">
                                    <TextBlock Text="{Binding Name}" FontSize="12"/>
                                    <TextBlock Text="{Binding Detail}" FontSize="10" Foreground="{DynamicResource Brush.TextFaint}"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding Detail}"/>
                                </StackPanel>

                                <StackPanel Grid.Column="3" Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <Border Background="{DynamicResource Brush.DemoSurface}" BorderBrush="{DynamicResource Brush.DemoBorder}" BorderThickness="1"
                                            CornerRadius="4" Padding="5,1" Margin="4,0,0,0"
                                            SnapsToDevicePixels="True" UseLayoutRounding="True">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsDemo}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{loc:T Usage_Demo}" FontSize="10" Foreground="{DynamicResource Brush.Demo}"/>
                                    </Border>

                                    <TextBlock Text="{loc:T UsageCfg_Badge_Hidden}" FontSize="10" Foreground="{DynamicResource Brush.Danger}"
                                               Margin="8,0,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Visible}" Value="False">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <TextBlock Text="{loc:T UsageCfg_Badge_NotDetected}" FontSize="10" Foreground="{DynamicResource Brush.WarnTextStrong}"
                                               Margin="8,0,0,0"
                                               ToolTip="{loc:T UsageCfg_NotDetected_Tip}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Detected}" Value="False">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock Grid.Row="2" x:Name="TxtEmpty" Margin="0,10,0,0"
                           FontSize="11" Foreground="{DynamicResource Brush.TextHint}" TextWrapping="Wrap"
                           Text="{loc:T UsageCfg_Empty}"/>
            </Grid>
        </Border>

        <!-- Footer -->
        <Border Grid.Row="3" Grid.ColumnSpan="2" Style="{StaticResource DialogFooter}">
            <Grid>
                <TextBlock x:Name="TxtVersion" Style="{StaticResource FooterVersion}"/>
                <Button Content="{loc:T Common_Close}" Style="{StaticResource SecondaryButton}"
                        HorizontalAlignment="Right" Click="Close_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>
