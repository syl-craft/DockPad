<Window x:Class="DockPad.UsageConfigDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Usage IA"
        Width="620" Height="660"
        MaxHeight="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Height}"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize" MinWidth="560" MinHeight="440"
        Background="#F3F3F3"
        FontFamily="Segoe UI">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#0078D4" Padding="20,14">
            <TextBlock Text="Usage IA" FontSize="16" FontWeight="SemiBold" Foreground="White"/>
        </Border>

        <!-- Réglages du bandeau. Sauvegarde immédiate à chaque changement. -->
        <Border Grid.Row="1" Background="White" Margin="16,12,16,0" Padding="16,12"
                BorderBrush="#E4E4E4" BorderThickness="1" CornerRadius="8"
                SnapsToDevicePixels="True" UseLayoutRounding="True">
            <StackPanel>
                <TextBlock Text="Bandeau" FontWeight="SemiBold" Margin="0,0,0,10"/>

                <CheckBox x:Name="ChkEnabled" Content="Afficher le bandeau dans DockPad"
                          VerticalContentAlignment="Center" Margin="0,0,0,10"
                          Click="Setting_Changed"/>

                <CheckBox x:Name="ChkShowCost" Content="Afficher le coût estimé"
                          VerticalContentAlignment="Center" Margin="0,0,0,12"
                          Click="Setting_Changed"
                          ToolTip="Estimation à partir des tarifs publics, dans la devise de la source — jamais convertie"/>

                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Seuil d'alerte :" Foreground="#555"
                               VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <ComboBox Grid.Column="1" x:Name="CmbThreshold" Width="140"
                              HorizontalAlignment="Left"
                              SelectionChanged="Setting_Changed"
                              ToolTip="Pourcentage restant sous lequel une jauge passe au rouge"/>
                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Fournisseur affiché :" Foreground="#555"
                               VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <ComboBox Grid.Column="1" x:Name="CmbDefaultProvider" Width="200"
                              HorizontalAlignment="Left" DisplayMemberPath="Label"
                              SelectionChanged="Setting_Changed"
                              ToolTip="Fournisseur affiché à l'ouverture de DockPad. Changer d'onglet reste possible, sans modifier ce réglage. Un fournisseur masqué reste sélectionnable : le réafficher rétablit le réglage."/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Fournisseurs détectés -->
        <Border Grid.Row="2" Background="White" Margin="16,12,16,12" Padding="16,12"
                BorderBrush="#E4E4E4" BorderThickness="1" CornerRadius="8"
                SnapsToDevicePixels="True" UseLayoutRounding="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <TextBlock Text="Fournisseurs" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <!-- Bouton carré : Padding="0" obligatoire, le 16,8 hérité de PrimaryButton
                         ne laisserait que 2 px au glyphe. -->
                    <Button Content="↻ Redétecter" Style="{StaticResource SecondaryButton}"
                            HorizontalAlignment="Right" Padding="10,5" FontSize="12"
                            Click="Redetect_Click"
                            ToolTip="Cherche les assistants installés. Jamais fait en tâche de fond."/>
                </Grid>

                <ListBox Grid.Row="1" x:Name="LstProviders"
                         HorizontalContentAlignment="Stretch"
                         BorderThickness="1" BorderBrush="#E8E8E8"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="2,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <CheckBox Grid.Column="0" IsChecked="{Binding Visible, Mode=OneTime}"
                                          VerticalAlignment="Center" Margin="0,0,10,0"
                                          Click="VisibleCheck_Click"
                                          ToolTip="Décocher pour retirer ce fournisseur du bandeau, sans perdre son réglage"/>

                                <Border Grid.Column="1" Width="20" Height="20" CornerRadius="10"
                                        Background="{Binding Accent, Converter={StaticResource StringToBrushConverter}}"
                                        VerticalAlignment="Center"
                                        SnapsToDevicePixels="True" UseLayoutRounding="True">
                                    <TextBlock Text="{Binding Glyph}" Foreground="White" FontSize="10"
                                               FontFamily="Segoe UI Symbol, Segoe UI Emoji, Segoe UI"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <StackPanel Grid.Column="2" Margin="10,0,0,0">
                                    <TextBlock Text="{Binding Name}" FontSize="12"/>
                                    <TextBlock Text="{Binding Detail}" FontSize="10" Foreground="#999"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding Detail}"/>
                                </StackPanel>

                                <StackPanel Grid.Column="3" Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <Border Background="#F3F0FF" BorderBrush="#DDD6FE" BorderThickness="1"
                                            CornerRadius="4" Padding="5,1" Margin="4,0,0,0"
                                            SnapsToDevicePixels="True" UseLayoutRounding="True">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsDemo}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="démo" FontSize="10" Foreground="#7C3AED"/>
                                    </Border>

                                    <TextBlock Text="masqué" FontSize="10" Foreground="#C42B1C"
                                               Margin="8,0,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Visible}" Value="False">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <TextBlock Text="non détecté" FontSize="10" Foreground="#B26A00"
                                               Margin="8,0,0,0"
                                               ToolTip="Conservé : son masquage et son ordre sont gardés pour le jour où l'outil réapparaît">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Detected}" Value="False">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock Grid.Row="2" x:Name="TxtEmpty" Margin="0,10,0,0"
                           FontSize="11" Foreground="#888" TextWrapping="Wrap"
                           Text="Aucun fournisseur connu. Utilisez ↻ Redétecter."/>
            </Grid>
        </Border>

        <!-- Footer -->
        <Border Grid.Row="3" Style="{StaticResource DialogFooter}">
            <Grid>
                <TextBlock x:Name="TxtVersion" Style="{StaticResource FooterVersion}"/>
                <Button Content="Fermer" Style="{StaticResource SecondaryButton}"
                        HorizontalAlignment="Right" Click="Close_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>
