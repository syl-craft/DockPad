<Window x:Class="DockPad.ShortcutDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:DockPad.Services.Localization"
        Title="{loc:T Shortcut_Title}"
        Width="500" SizeToContent="Height" MaxHeight="720"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource Brush.Surface}"
        FontFamily="Segoe UI">

    <Window.Resources>
        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderStrong}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
            <Style.Triggers>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderStrong}"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style TargetType="Label">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}"/>
            <Setter Property="Padding" Value="0,0,0,4"/>
        </Style>
        <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}"/>
        </Style>
    </Window.Resources>

    <Grid TextElement.Foreground="{DynamicResource Brush.Text}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{DynamicResource Brush.Accent}" Padding="20,14">
            <TextBlock x:Name="TxtHeader" FontSize="16" FontWeight="SemiBold" Foreground="White"/>
        </Border>

        <!-- Contenu -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,20,24,0">

                <!-- Nom -->
                <Label Content="{loc:T Shortcut_Name}"/>
                <TextBox x:Name="TxtName" Margin="0,0,0,16"/>

                <!-- Type -->
                <Label Content="{loc:T Shortcut_Type}"/>
                <ComboBox x:Name="CmbType" Margin="0,0,0,16"
                          SelectionChanged="CmbType_SelectionChanged">
                    <ComboBoxItem Content="{loc:T Shortcut_Type_RunCommand}"          Tag="RunCommand"/>
                    <ComboBoxItem Content="{loc:T Shortcut_Type_OpenFolder}"            Tag="OpenFolder"/>
                    <ComboBoxItem Content="{loc:T Shortcut_Type_OpenUrl}"    Tag="OpenUrl"/>
                    <ComboBoxItem Content="{loc:T Shortcut_Type_OpenTerminal}"           Tag="OpenTerminal"/>
                    <ComboBoxItem Content="{loc:T Shortcut_Type_SwitchProcess}"   Tag="SwitchToProcess"/>
                </ComboBox>

                <!-- Panel commande standard (RunCommand / OpenFolder / OpenUrl) -->
                <StackPanel x:Name="PanelCommand">
                    <Label x:Name="LblCommand" Content="{loc:T Shortcut_Command}"/>
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TxtCommand" Grid.Column="0"/>
                        <Button x:Name="BtnBrowse" Grid.Column="1" Content="..." Width="36" Margin="6,0,0,0"
                                Style="{StaticResource SecondaryButton}"
                                Click="BrowseCommand_Click"/>
                    </Grid>
                </StackPanel>

                <!-- Panel terminal (OpenTerminal uniquement) -->
                <StackPanel x:Name="PanelTerminal" Visibility="Collapsed" Margin="0,0,0,16">

                    <!-- Sélection du terminal -->
                    <Label Content="{loc:T Shortcut_Terminal}"/>
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="CmbTerminal" Grid.Column="0" DisplayMemberPath="DisplayName"
                                  SelectionChanged="CmbTerminal_SelectionChanged"/>
                        <Button Grid.Column="1" Content="..." Width="36" Margin="6,0,0,0"
                                Style="{StaticResource SecondaryButton}"
                                Click="BrowseTerminal_Click"
                                ToolTip="{loc:T Shortcut_Terminal_Tip}"/>
                    </Grid>

                    <!-- Dossier de départ -->
                    <Label Content="{loc:T Shortcut_StartFolder}"/>
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TxtTerminalDir" Grid.Column="0"
                                 ToolTip="{loc:T Shortcut_StartFolder_Tip}"
                                 TextChanged="TerminalField_Changed"/>
                        <Button Grid.Column="1" Content="..." Width="36" Margin="6,0,0,0"
                                Style="{StaticResource SecondaryButton}"
                                Click="BrowseTerminalDir_Click"/>
                    </Grid>

                    <!-- Commande à lancer -->
                    <Label Content="{loc:T Shortcut_RunCommand}"/>
                    <TextBox x:Name="TxtTerminalCommand" Margin="0,0,0,16"
                             ToolTip="{loc:T Shortcut_RunCommand_Tip}"
                             TextChanged="TerminalField_Changed"/>

                    <!-- Nouvel onglet (Windows Terminal uniquement) -->
                    <CheckBox x:Name="ChkNewTab" Content="{loc:T Shortcut_NewTab}"
                              Margin="0,0,0,16" IsChecked="True"
                              Checked="TerminalField_Changed" Unchecked="TerminalField_Changed"/>

                    <!-- Paramètres libres -->
                    <Label Content="{loc:T Shortcut_ExtraArgs}"/>
                    <TextBox x:Name="TxtTerminalExtraArgs" Margin="0,0,0,16"
                             ToolTip="{loc:T Shortcut_ExtraArgs_Tip}"
                             TextChanged="TerminalField_Changed"/>

                    <!-- Aperçu de la commande générée -->
                    <Border Background="{DynamicResource Brush.SurfaceHover}" BorderBrush="{DynamicResource Brush.SeparatorStrong}" BorderThickness="1" CornerRadius="4" Padding="10,8"
                            SnapsToDevicePixels="True" UseLayoutRounding="True">
                        <StackPanel>
                            <TextBlock Text="{loc:T Shortcut_Preview}" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Brush.TextLabel}" Margin="0,0,0,4"/>
                            <TextBlock x:Name="TxtCmdPreview" FontSize="11" Foreground="{DynamicResource Brush.TextSecondary}"
                                       FontFamily="Consolas" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                </StackPanel>

                <!-- Panel SwitchToProcess -->
                <StackPanel x:Name="PanelProcessSwitch" Visibility="Collapsed" Margin="0,0,0,16">

                    <!-- Exécutable -->
                    <Label Content="{loc:T Shortcut_Exe}"/>
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TxtPsExecutable" Grid.Column="0"
                                 ToolTip="{loc:T Shortcut_Exe_Tip}"
                                 TextChanged="PsExecutable_Changed"/>
                        <Button Grid.Column="1" Content="..." Width="36" Margin="6,0,0,0"
                                Style="{StaticResource SecondaryButton}"
                                Click="BrowsePsExecutable_Click"/>
                    </Grid>

                    <!-- Mode de recherche -->
                    <Label Content="{loc:T Shortcut_SearchMode}"/>
                    <ComboBox x:Name="CmbPsSearchMode" Margin="0,0,0,16"
                              SelectionChanged="CmbPsSearchMode_SelectionChanged">
                        <ComboBoxItem Content="{loc:T Shortcut_SearchMode_ByName}" Tag="ByProcessName"/>
                        <ComboBoxItem Content="{loc:T Shortcut_SearchMode_ByTitle}"  Tag="ByWindowTitle"/>
                    </ComboBox>

                    <!-- Nom du processus / Titre de fenêtre -->
                    <Label x:Name="LblPsSearchTerm" Content="{loc:T Shortcut_ProcessName}"/>
                    <TextBox x:Name="TxtPsProcessName" Margin="0,0,0,16"/>

                    <!-- Paramètres (ByProcessName uniquement) -->
                    <StackPanel x:Name="PanelPsParameters">
                        <Label Content="{loc:T Shortcut_Params}"/>
                        <TextBox x:Name="TxtPsParameters" Margin="0,0,0,16"
                                 ToolTip="{loc:T Shortcut_Params_Tip_Name}"/>
                    </StackPanel>

                </StackPanel>

                <!-- Icône -->
                <Label Content="{loc:T Shortcut_Icon}"/>
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="TxtIconPath" Grid.Column="0"/>
                    <Button Grid.Column="1" Content="..." Width="36" Margin="6,0,0,0"
                            Style="{StaticResource SecondaryButton}"
                            Click="BrowseIcon_Click"/>
                    <Border Grid.Column="2" Width="36" Height="36" Margin="6,0,0,0"
                            BorderBrush="{DynamicResource Brush.BorderStrong}" BorderThickness="1" CornerRadius="4"
                            SnapsToDevicePixels="True" UseLayoutRounding="True">
                        <Image x:Name="ImgIconPreview" Stretch="Uniform" Margin="4"/>
                    </Border>
                </Grid>

            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="2" Background="{DynamicResource Brush.SurfaceCard}" Padding="24,12" Margin="0,16,0,0"
                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{loc:T Common_Cancel}" Style="{StaticResource SecondaryButton}"
                        Margin="0,0,12,0" Click="Cancel_Click"/>
                <Button Content="{loc:T Common_Save}" Style="{StaticResource PrimaryButton}"
                        Click="Save_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
