<Window x:Class="DockPad.PresetsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:DockPad.Services.Localization"
        Title="{loc:T Presets_Title}"
        Width="580" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource Brush.Surface}"
        FontFamily="Segoe UI">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{DynamicResource Brush.Accent}" Padding="20,14">
            <TextBlock Text="{loc:T Presets_Title}" FontSize="16"
                       FontWeight="SemiBold" Foreground="White"/>
        </Border>

        <!-- Contenu -->
        <StackPanel Grid.Row="1" Margin="24,20">
            <TextBlock Text="{loc:T Presets_Subtitle}"
                       FontSize="13" Foreground="{DynamicResource Brush.TextLabel}" Margin="0,0,0,16"/>

            <ItemsControl x:Name="ItemsPresets">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,0,10" Padding="14,12"
                                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="6"
                                Background="{DynamicResource Brush.SurfaceCard}" Opacity="{Binding Opacity}"
                                SnapsToDevicePixels="True" UseLayoutRounding="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <CheckBox Grid.Column="0" VerticalAlignment="Center"
                                          IsChecked="{Binding IsSelected}"
                                          IsEnabled="{Binding CanSelect}"
                                          Margin="0,0,14,0"/>

                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding DisplayName}"
                                               FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text}"/>
                                    <TextBlock Text="{Binding Description}"
                                               FontSize="12" Foreground="{DynamicResource Brush.TextSubtle}" Margin="0,3,0,0"/>
                                    <TextBlock Text="{Binding Command}" FontSize="11"
                                               Foreground="{DynamicResource Brush.TextFaint}" Margin="0,3,0,0"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>

                                <Border Grid.Column="2" VerticalAlignment="Center" Margin="12,0,0,0"
                                        Background="{Binding BadgeBackground}"
                                        CornerRadius="4" Padding="8,4"
                                        SnapsToDevicePixels="True" UseLayoutRounding="True"
                                        Visibility="{Binding ShowBadge, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <TextBlock Text="{Binding BadgeText}" FontSize="11"
                                               Foreground="{Binding BadgeForeground}"/>
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <!-- Footer -->
        <Border Grid.Row="2" Style="{StaticResource DialogFooter}">
            <Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <TextBlock x:Name="TxtVersion" Style="{StaticResource FooterVersion}" Margin="0,0,14,0"/>
                    <Button Content="{loc:T Presets_ContextMenu}" Style="{StaticResource SecondaryButton}"
                            Margin="0,0,8,0" Click="OpenContextMenuManager_Click"/>
                    <Button Content="{loc:T Common_Refresh}" Style="{StaticResource SecondaryButton}"
                            Click="Refresh_Click"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="{loc:T Common_Cancel}" Style="{StaticResource SecondaryButton}"
                            Margin="0,0,12,0" Click="Cancel_Click"/>
                    <Button x:Name="BtnInstall" Content="{loc:T Presets_Install}"
                            Style="{StaticResource PrimaryButton}" Click="Install_Click"/>
                    <Button x:Name="BtnElevate" Content="{loc:T Common_Elevate}"
                            Style="{StaticResource PrimaryButton}" Visibility="Collapsed"
                            Click="Elevate_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
