<Window x:Class="DockPad.EntryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nouveau raccourci"
        Width="520" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F3F3F3"
        FontFamily="Segoe UI">

    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
            <Style.Triggers>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="#0078D4"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style TargetType="Label">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="Padding" Value="0,0,0,4"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#0078D4" Padding="20,14">
            <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}"
                       FontSize="16" FontWeight="SemiBold" Foreground="White"/>
        </Border>

        <!-- Contenu -->
        <StackPanel Grid.Row="1" Margin="24,20">
            <!-- Nom affiché -->
            <Label Content="Nom affiché *"/>
            <TextBox x:Name="TxtDisplayName" Margin="0,0,0,16"
                     ToolTip="Texte visible dans le menu clic droit"/>

            <!-- Clé de registre -->
            <Label Content="Clé de registre *"/>
            <TextBox x:Name="TxtRegistryKey" Margin="0,0,0,4"
                     ToolTip="Identifiant unique (sans espaces, ex: MonApp)"/>
            <TextBlock Text="Identifiant interne unique, sans espaces ni caractères spéciaux."
                       FontSize="11" Foreground="#888" Margin="0,0,0,16"/>

            <!-- Commande -->
            <Label Content="Commande *"/>
            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="TxtCommand" Grid.Column="0"
                         ToolTip="Chemin de l&apos;exécutable. Utilisez &quot;%1&quot; pour le fichier sélectionné."/>
                <Button Grid.Column="1" Content="..." Width="36" Margin="6,0,0,0"
                        Style="{StaticResource SecondaryButton}"
                        Click="BrowseCommand_Click"/>
            </Grid>
            <TextBlock Text='Utilisez &quot;%1&quot; pour passer le fichier/dossier sélectionné en argument.'
                       FontSize="11" Foreground="#888" Margin="0,0,0,16"/>

            <!-- Icône -->
            <Label Content="Icône (optionnel)"/>
            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="TxtIconPath" Grid.Column="0"
                         ToolTip="Chemin vers .ico, .exe, .dll (ex: C:\app.exe,0)"/>
                <Button Grid.Column="1" Content="..." Width="36" Margin="6,0,0,0"
                        Style="{StaticResource SecondaryButton}"
                        Click="BrowseIcon_Click"/>
                <Border Grid.Column="2" Width="36" Height="36" Margin="6,0,0,0"
                        BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="4">
                    <Image x:Name="ImgIconPreview" Stretch="Uniform" Margin="4"/>
                </Border>
            </Grid>
            <TextBlock Text="Formats acceptés : .ico, .exe, .dll (index optionnel après virgule)."
                       FontSize="11" Foreground="#888" Margin="0,0,0,16"/>

            <!-- Cible -->
            <Label Content="S'applique à"/>
            <ComboBox x:Name="CmbTarget" Margin="0,0,0,16"
                      SelectionChanged="CmbTarget_SelectionChanged">
                <ComboBoxItem Content="Fichiers" Tag="Files"/>
                <ComboBoxItem Content="Dossiers" Tag="Folders"/>
                <ComboBoxItem Content="Fond de dossier (clic droit dans un dossier vide)" Tag="FolderBackground"/>
            </ComboBox>

            <!-- Note fond de dossier -->
            <Border x:Name="PanelBgNote" Visibility="Collapsed"
                    Background="#FFF4CE" BorderBrush="#F0C519" BorderThickness="1"
                    CornerRadius="4" Padding="12,8">
                <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="#5C4800">
                    Pour "Fond de dossier", la variable <Bold>%V</Bold> contient le chemin du dossier courant (et non %1).
                </TextBlock>
            </Border>
        </StackPanel>

        <!-- Footer -->
        <Border Grid.Row="2" Background="White" Padding="24,12"
                BorderBrush="#E0E0E0" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Annuler" Style="{StaticResource SecondaryButton}"
                        Margin="0,0,12,0" Click="Cancel_Click"/>
                <Button Content="Enregistrer" Style="{StaticResource PrimaryButton}"
                        Click="Save_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
