<Window x:Class="DockPad.EntryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:DockPad.Services.Localization"
        Title="{loc:T Entry_Title_New}"
        Width="520" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource Brush.Surface}"
        FontFamily="Segoe UI">

    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderStrong}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
            <Style.Triggers>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderStrong}"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style TargetType="Label">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}"/>
            <Setter Property="Padding" Value="0,0,0,4"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{DynamicResource Brush.Accent}" Padding="20,14">
            <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}"
                       FontSize="16" FontWeight="SemiBold" Foreground="White"/>
        </Border>

        <!-- Contenu -->
        <StackPanel Grid.Row="1" Margin="24,20">
            <!-- Nom affiché -->
            <Label Content="{loc:T Entry_DisplayName}"/>
            <TextBox x:Name="TxtDisplayName" Margin="0,0,0,16"
                     ToolTip="{loc:T Entry_DisplayName_Tip}"/>

            <!-- Clé de registre -->
            <Label Content="{loc:T Entry_RegistryKey}"/>
            <TextBox x:Name="TxtRegistryKey" Margin="0,0,0,4"
                     ToolTip="{loc:T Entry_RegistryKey_Tip}"/>
            <TextBlock Text="{loc:T Entry_RegistryKey_Hint}"
                       FontSize="11" Foreground="{DynamicResource Brush.TextHint}" Margin="0,0,0,16"/>

            <!-- Commande -->
            <Label Content="{loc:T Entry_Command}"/>
            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="TxtCommand" Grid.Column="0"
                         ToolTip="{loc:T Entry_Command_Tip}"/>
                <Button Grid.Column="1" Content="..." Width="36" Margin="6,0,0,0"
                        Style="{StaticResource SecondaryButton}"
                        Click="BrowseCommand_Click"/>
            </Grid>
            <TextBlock Text='Utilisez &quot;%1&quot; pour passer le fichier/dossier sélectionné en argument.'
                       FontSize="11" Foreground="{DynamicResource Brush.TextHint}" Margin="0,0,0,16"/>

            <!-- Icône -->
            <Label Content="{loc:T Entry_Icon}"/>
            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="TxtIconPath" Grid.Column="0"
                         ToolTip="{loc:T Entry_Icon_Tip}"/>
                <Button Grid.Column="1" Content="..." Width="36" Margin="6,0,0,0"
                        Style="{StaticResource SecondaryButton}"
                        Click="BrowseIcon_Click"/>
                <Border Grid.Column="2" Width="36" Height="36" Margin="6,0,0,0"
                        BorderBrush="{DynamicResource Brush.BorderStrong}" BorderThickness="1" CornerRadius="4"
                        SnapsToDevicePixels="True" UseLayoutRounding="True">
                    <Image x:Name="ImgIconPreview" Stretch="Uniform" Margin="4"/>
                </Border>
            </Grid>
            <TextBlock Text="{loc:T Entry_Icon_Hint}"
                       FontSize="11" Foreground="{DynamicResource Brush.TextHint}" Margin="0,0,0,16"/>

            <!-- Cible -->
            <Label Content="{loc:T Entry_AppliesTo}"/>
            <ComboBox x:Name="CmbTarget" Margin="0,0,0,16"
                      SelectionChanged="CmbTarget_SelectionChanged">
                <ComboBoxItem Content="{loc:T Entry_Target_Files}" Tag="Files"/>
                <ComboBoxItem Content="{loc:T Entry_Target_Folders}" Tag="Folders"/>
                <ComboBoxItem Content="{loc:T Entry_Target_Background}" Tag="FolderBackground"/>
            </ComboBox>

            <!-- Note fond de dossier -->
            <Border x:Name="PanelBgNote" Visibility="Collapsed"
                    Background="{DynamicResource Brush.WarnSurface}" BorderBrush="{DynamicResource Brush.WarnBorder}" BorderThickness="1"
                    CornerRadius="4" Padding="12,8"
                    SnapsToDevicePixels="True" UseLayoutRounding="True">
                <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource Brush.WarnText}">
                    Pour "Fond de dossier", la variable <Bold>%V</Bold> contient le chemin du dossier courant (et non %1).
                </TextBlock>
            </Border>
        </StackPanel>

        <!-- Footer -->
        <Border Grid.Row="2" Background="{DynamicResource Brush.SurfaceCard}" Padding="24,12"
                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{loc:T Common_Cancel}" Style="{StaticResource SecondaryButton}"
                        Margin="0,0,12,0" Click="Cancel_Click"/>
                <Button Content="{loc:T Common_Save}" Style="{StaticResource PrimaryButton}"
                        Click="Save_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
