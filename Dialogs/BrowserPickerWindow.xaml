<Window x:Class="DockPad.BrowserPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:DockPad.Services.Localization"
        Title="{loc:T Picker_Title}"
        Width="440" SizeToContent="Height"
        MaxHeight="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Height}"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize"
        FontFamily="Segoe UI"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Border Background="White" CornerRadius="8" Margin="16"
            SnapsToDevicePixels="True" UseLayoutRounding="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="14" Opacity="0.30" ShadowDepth="4" Direction="270"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- En-tête : URL sélectionnable + bouton copier -->
            <Border Grid.Row="0" Background="#0078D4" CornerRadius="8,8,0,0" Padding="14,10"
                    SnapsToDevicePixels="True" UseLayoutRounding="True">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{loc:T Picker_Title}" Foreground="White"
                                   FontWeight="SemiBold" FontSize="14" Margin="0,0,0,6"/>
                        <TextBox x:Name="TxtUrl" IsReadOnly="True"
                                 TextWrapping="Wrap" MaxHeight="52"
                                 VerticalScrollBarVisibility="Auto"
                                 Background="Transparent" Foreground="#DCEBFF"
                                 BorderThickness="0" FontSize="11" FontFamily="Consolas"
                                 ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                    </StackPanel>

                    <Button x:Name="BtnCopy" Grid.Column="1" Content="{loc:T Picker_Copy}"
                            Style="{StaticResource SecondaryButton}"
                            VerticalAlignment="Top" Margin="10,0,0,0" Padding="8,4"
                            FontSize="12" Click="BtnCopy_Click"/>
                </Grid>
            </Border>

            <!-- Liste des navigateurs -->
            <ListBox x:Name="LstBrowsers" Grid.Row="1" Margin="8,8,8,0"
                     BorderThickness="0" Background="Transparent"
                     MouseDoubleClick="LstBrowsers_MouseDoubleClick"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="10,8"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Bd" Background="Transparent" CornerRadius="6"
                                            Padding="{TemplateBinding Padding}"
                                            SnapsToDevicePixels="True" UseLayoutRounding="True">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#F0F6FC"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#E5F1FB"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <!-- Titre de groupe (navigateur masqué) : ni sélectionnable ni atteignable
                                 au clavier — un ListBoxItem désactivé est sauté par les flèches. -->
                            <DataTrigger Binding="{Binding IsHeader}" Value="True">
                                <Setter Property="IsEnabled" Value="False"/>
                                <Setter Property="Padding" Value="10,8,10,2"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsChild}" Value="True">
                                <Setter Property="Padding" Value="10,5"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="32"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Filet d'indentation des profils (largeur nulle si masqué) -->
                            <Border Grid.Column="0" Width="24" Margin="10,1,10,1"
                                    BorderBrush="#D8D8D8" BorderThickness="1,0,0,0"
                                    SnapsToDevicePixels="True" UseLayoutRounding="True">
                                <!-- Visibilité par le Style et non en attribut : une valeur locale
                                     bat les Setter des DataTrigger (le filet ne s'afficherait jamais). -->
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsChild}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>

                            <Image Grid.Column="1" Source="{Binding Icon}" Width="24" Height="24"
                                   VerticalAlignment="Center">
                                <Image.Style>
                                    <Style TargetType="Image">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsChild}" Value="True">
                                                <Setter Property="Width"  Value="20"/>
                                                <Setter Property="Height" Value="20"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsHeader}" Value="True">
                                                <Setter Property="Opacity" Value="0.45"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Image.Style>
                            </Image>

                            <TextBlock Grid.Column="2" Text="{Binding Name}"
                                       VerticalAlignment="Center" Margin="8,0,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontSize" Value="13"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsGroupTitle}" Value="True">
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsHeader}" Value="True">
                                                <Setter Property="FontSize"   Value="11"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                <Setter Property="Foreground" Value="#999"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <!-- Badge touche : même style que l'overlay clavier de la grille (Ctrl enfoncé) ;
                                 pendant le décompte d'ouverture auto, badge n°1 en bleu accent avec "Ns" -->
                            <Border Grid.Column="3" MinWidth="20" Height="20" Padding="4,0"
                                    CornerRadius="4" VerticalAlignment="Center"
                                    SnapsToDevicePixels="True" UseLayoutRounding="True">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#BB555555"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Badge}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsCountdown}" Value="True">
                                                <Setter Property="Background" Value="#0078D4"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding Badge}" FontSize="11" FontWeight="SemiBold"
                                           Foreground="White" HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Pied : règle de domaine + décompte d'ouverture automatique -->
            <Border Grid.Row="2" Padding="18,10,18,14">
                <StackPanel>
                    <CheckBox x:Name="ChkAlways" Content="{loc:T Picker_AlwaysForDomain}"
                              FontSize="12" Foreground="#555" VerticalContentAlignment="Center"/>
                    <TextBlock x:Name="TxtCountdown" Visibility="Collapsed"
                               FontSize="11" Foreground="#0078D4" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
