<Window x:Class="DockPad.BrowserPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ouvrir avec…"
        Width="440" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize"
        FontFamily="Segoe UI"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Border Background="White" CornerRadius="8" Margin="16"
            SnapsToDevicePixels="True" UseLayoutRounding="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="14" Opacity="0.30" ShadowDepth="4" Direction="270"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- En-tête : URL sélectionnable + bouton copier -->
            <Border Grid.Row="0" Background="#0078D4" CornerRadius="8,8,0,0" Padding="14,10"
                    SnapsToDevicePixels="True" UseLayoutRounding="True">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Ouvrir avec…" Foreground="White"
                                   FontWeight="SemiBold" FontSize="14" Margin="0,0,0,6"/>
                        <TextBox x:Name="TxtUrl" IsReadOnly="True"
                                 TextWrapping="Wrap" MaxHeight="52"
                                 VerticalScrollBarVisibility="Auto"
                                 Background="Transparent" Foreground="#DCEBFF"
                                 BorderThickness="0" FontSize="11" FontFamily="Consolas"
                                 ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                    </StackPanel>

                    <Button x:Name="BtnCopy" Grid.Column="1" Content="⧉ Copier"
                            Style="{StaticResource SecondaryButton}"
                            VerticalAlignment="Top" Margin="10,0,0,0" Padding="8,4"
                            FontSize="12" Click="BtnCopy_Click"/>
                </Grid>
            </Border>

            <!-- Liste des navigateurs -->
            <ListBox x:Name="LstBrowsers" Grid.Row="1" Margin="8,8,8,0"
                     BorderThickness="0" Background="Transparent"
                     MouseDoubleClick="LstBrowsers_MouseDoubleClick"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="10,8"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Bd" Background="Transparent" CornerRadius="6"
                                            Padding="{TemplateBinding Padding}"
                                            SnapsToDevicePixels="True" UseLayoutRounding="True">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#F0F6FC"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#E5F1FB"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="32"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Image Grid.Column="0" Source="{Binding Icon}" Width="24" Height="24"
                                   VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="13"
                                       VerticalAlignment="Center" Margin="8,0,0,0"/>
                            <Border Grid.Column="2" Background="#F0F0F0" CornerRadius="4"
                                    Padding="6,2" SnapsToDevicePixels="True" UseLayoutRounding="True">
                                <TextBlock Text="{Binding Badge}" FontFamily="Consolas"
                                           FontSize="11" Foreground="#666"/>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Pied : règle de domaine -->
            <Border Grid.Row="2" Padding="18,10,18,14">
                <CheckBox x:Name="ChkAlways" Content="Toujours pour ce domaine"
                          FontSize="12" Foreground="#555" VerticalContentAlignment="Center"/>
            </Border>
        </Grid>
    </Border>
</Window>
