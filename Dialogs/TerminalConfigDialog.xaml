<Window x:Class="DockPad.TerminalConfigDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:DockPad.Services.Localization;assembly=DockPad.Core"
        Title="{loc:T Terminals_Title}"
        Width="1100" Height="820"
        MaxHeight="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Height}"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize" MinWidth="900" MinHeight="480"
        Background="{DynamicResource Brush.Surface}"
        FontFamily="Segoe UI">
    <!--
        Patron de la fenetre Navigateurs : liste a gauche (detection + ajout), modification a
        droite. Sauvegarde immediate a chaque action, comme elle.
    -->
    <Grid TextElement.Foreground="{DynamicResource Brush.Text}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{DynamicResource Brush.Accent}" Padding="20,14">
            <TextBlock Text="{loc:T Terminals_Title}" FontSize="16" FontWeight="SemiBold" Foreground="White"/>
        </Border>

        <Grid Grid.Row="1" Margin="24,18,24,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="33"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Liste des terminaux -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <TextBlock Text="{loc:T Terminals_List}" FontWeight="SemiBold" FontSize="13"
                               VerticalAlignment="Center"/>
                    <Button Content="{loc:T Terminals_Redetect}" Style="{StaticResource SecondaryButton}"
                            HorizontalAlignment="Right" Padding="8,4" Click="Redetect_Click"
                            ToolTip="{loc:T Terminals_Redetect_Tip}"/>
                </Grid>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <ListBox x:Name="LstTerminals" Grid.Column="0"
                             SelectionChanged="LstTerminals_SelectionChanged"
                             HorizontalContentAlignment="Stretch"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="2,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="28"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <CheckBox Grid.Column="0" IsChecked="{Binding Visible, Mode=OneTime}"
                                              VerticalAlignment="Center" Margin="0,0,8,0"
                                              Click="VisibleCheck_Click"
                                              ToolTip="{loc:T Terminals_Visible_Tip}"/>
                                    <Image Grid.Column="1" Source="{Binding Icon}" Width="20" Height="20"/>
                                    <StackPanel Grid.Column="2" Margin="8,0,0,0">
                                        <TextBlock Text="{Binding Name}" FontSize="12"/>
                                        <TextBlock Text="{Binding Detail}" FontSize="10" Foreground="{DynamicResource Brush.TextFaint}"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="3" Text="{Binding Badges}" FontSize="10" Margin="8,0,0,0"
                                               Foreground="{DynamicResource Brush.Danger}" VerticalAlignment="Center"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                        <Button Content="▲" Width="34" Height="30" Padding="0" Margin="0,0,0,4" Style="{StaticResource SecondaryButton}" Click="Up_Click" ToolTip="{loc:T Common_MoveUp}" AutomationProperties.Name="{loc:T Common_MoveUp}"/>
                        <Button Content="▼" Width="34" Height="30" Padding="0" Margin="0,0,0,4" Style="{StaticResource SecondaryButton}" Click="Down_Click" ToolTip="{loc:T Common_MoveDown}" AutomationProperties.Name="{loc:T Common_MoveDown}"/>
                        <Button Content="🗑" Width="34" Height="30" Padding="0" Margin="0,0,0,12" Style="{StaticResource SecondaryButton}" Click="Delete_Click" ToolTip="{loc:T Common_Delete}" AutomationProperties.Name="{loc:T Common_Delete}"/>
                        <Button Content="➕" Width="34" Height="30" Padding="0" Style="{StaticResource SecondaryButton}" Click="Add_Click" ToolTip="{loc:T Terminals_Add_Tip}" AutomationProperties.Name="{loc:T Terminals_Add_Tip}"/>
                    </StackPanel>
                </Grid>
            </Grid>

            <Border Grid.Column="1" Width="1" HorizontalAlignment="Center"
                    Background="{DynamicResource Brush.Border}"/>

            <!-- Modification du terminal sélectionné (désactivée sans sélection) -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="PnlEdit" IsEnabled="False">
                    <TextBlock Text="{loc:T Terminals_Name}" Foreground="{DynamicResource Brush.TextLabel}" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtName" FontSize="12" Padding="6,5"
                             BorderBrush="{DynamicResource Brush.BorderStrong}" BorderThickness="1"
                             AutomationProperties.Name="{loc:T Terminals_Name}"/>

                    <TextBlock Text="{loc:T Settings_Terminal_Program}" Foreground="{DynamicResource Brush.TextLabel}"
                               Margin="0,10,0,4"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TxtExe" Grid.Column="0" FontFamily="Consolas" FontSize="12"
                                 Padding="6,5" BorderBrush="{DynamicResource Brush.BorderStrong}" BorderThickness="1"
                                 AutomationProperties.Name="{loc:T Settings_Terminal_Program}"
                                 TextChanged="Field_Changed"/>
                        <Button Grid.Column="1" Content="{loc:T Settings_Terminal_Browse}"
                                Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"
                                BorderBrush="{DynamicResource Brush.BorderStrong}" BorderThickness="1"
                                Click="BrowseExe_Click"/>
                    </Grid>
                    <TextBlock x:Name="TxtInvalid" Text="{loc:T Settings_Terminal_CustomInvalid}"
                               Foreground="{DynamicResource Brush.Danger}" FontSize="11" Margin="0,4,0,0"
                               TextWrapping="Wrap" Visibility="Collapsed"/>

                    <TextBlock Text="{loc:T Settings_Terminal_FolderArgs}" Foreground="{DynamicResource Brush.TextLabel}"
                               Margin="0,10,0,4"/>
                    <TextBox x:Name="TxtFolderArgs" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap"
                             Padding="6,5" BorderBrush="{DynamicResource Brush.BorderStrong}" BorderThickness="1"
                             AutomationProperties.Name="{loc:T Settings_Terminal_FolderArgs}"
                             TextChanged="Field_Changed"/>
                    <TextBlock Text="{loc:T Settings_Terminal_CommandArgs}" Foreground="{DynamicResource Brush.TextLabel}"
                               Margin="0,10,0,4"/>
                    <TextBox x:Name="TxtCommandArgs" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap"
                             Padding="6,5" BorderBrush="{DynamicResource Brush.BorderStrong}" BorderThickness="1"
                             AutomationProperties.Name="{loc:T Settings_Terminal_CommandArgs}"
                             TextChanged="Field_Changed"/>
                    <TextBlock x:Name="TxtNoCommand" Text="{loc:T Settings_Terminal_NoCommand}"
                               Foreground="{DynamicResource Brush.Danger}" FontSize="11" Margin="0,4,0,0"
                               TextWrapping="Wrap" Visibility="Collapsed"/>
                    <TextBlock Text="{loc:T Settings_Terminal_ArgsHint}" Margin="0,4,0,0"
                               Foreground="{DynamicResource Brush.TextHint}" FontSize="11" TextWrapping="Wrap"/>

                    <TextBlock Text="{loc:T Settings_Terminal_Preview}" Foreground="{DynamicResource Brush.TextLabel}"
                               Margin="0,12,0,4"/>
                    <TextBox x:Name="TxtPreview" IsReadOnly="True" TextWrapping="Wrap"
                             FontFamily="Consolas" FontSize="12" Padding="6,5"
                             Background="{DynamicResource Brush.SurfaceHover}"
                             BorderBrush="{DynamicResource Brush.BorderStrong}" BorderThickness="1"
                             AutomationProperties.Name="{loc:T Settings_Terminal_Preview}"/>

                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0" HorizontalAlignment="Right">
                        <Button x:Name="BtnTest" Content="{loc:T Settings_Terminal_Test}" Margin="0,0,8,0"
                                Style="{StaticResource SecondaryButton}"
                                BorderBrush="{DynamicResource Brush.BorderStrong}" BorderThickness="1"
                                ToolTip="{loc:T Settings_Terminal_TestTip}" Click="Test_Click"/>
                        <Button Content="{loc:T Terminals_UseAsDefault}" Margin="0,0,8,0"
                                Style="{StaticResource SecondaryButton}"
                                BorderBrush="{DynamicResource Brush.BorderStrong}" BorderThickness="1"
                                Click="UseAsDefault_Click"/>
                        <Button Content="{loc:T Common_Apply}" Style="{StaticResource PrimaryButton}"
                                Click="Apply_Click"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Footer -->
        <Border Grid.Row="2" Style="{StaticResource DialogFooter}">
            <Grid>
                <TextBlock x:Name="TxtVersion" Style="{StaticResource FooterVersion}"/>
                <Button Content="{loc:T Common_Close}" Style="{StaticResource SecondaryButton}"
                        HorizontalAlignment="Right" Click="Close_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>
