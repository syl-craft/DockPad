<Window x:Class="DockPad.McpConfigDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:DockPad.Services.Localization"
        Title="{loc:T Mcp_Title}"
        Width="620" Height="680"
        MaxHeight="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Height}"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize" MinWidth="560" MinHeight="500"
        Background="#F3F3F3"
        FontFamily="Segoe UI">
    <Window.Resources>
        <Style x:Key="MessageTextStyle" TargetType="TextBlock">
            <Setter Property="Visibility" Value="Visible"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Message}" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#0078D4" Padding="20,14">
            <TextBlock Text="{loc:T Mcp_Title}" FontSize="16" FontWeight="SemiBold" Foreground="White"/>
        </Border>

        <!-- Onglets -->
        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0" Padding="0"
                    Margin="16,10,16,0">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="FontSize" Value="13"/>
                    <Setter Property="Foreground" Value="#555"/>
                    <Setter Property="Cursor" Value="Hand"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TabItem">
                                <Border x:Name="Bd" Background="Transparent" Padding="14,8"
                                        BorderThickness="0,0,0,2" BorderBrush="Transparent">
                                    <ContentPresenter ContentSource="Header"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#EAEAEA"/>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Bd" Property="BorderBrush" Value="#0078D4"/>
                                        <Setter Property="Foreground" Value="#0078D4"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TabControl.Resources>

            <!-- ══ Onglet Options ══ -->
            <TabItem Header="{loc:T Mcp_Tab_Options}">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="8,14,8,12">
                    <CheckBox x:Name="ChkEnabled" Content="{loc:T Mcp_Enable}"
                              FontSize="13" Checked="Option_Changed" Unchecked="Option_Changed"/>
                    <TextBlock Text="{loc:T Mcp_Enable_Hint}"
                               Foreground="#888" FontSize="11" Margin="22,2,0,12" TextWrapping="Wrap"/>

                    <CheckBox x:Name="ChkAllowDelete" Content="{loc:T Mcp_AllowDelete}"
                              FontSize="13" Checked="Option_Changed" Unchecked="Option_Changed"/>
                    <TextBlock Text="{loc:T Mcp_AllowDelete_Hint}"
                               Foreground="#888" FontSize="11" Margin="22,2,0,16" TextWrapping="Wrap"/>

                    <Separator Margin="0,0,0,14"/>

                    <TextBlock Text="{loc:T Mcp_Register_ClaudeCode}" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,6"/>
                    <CheckBox x:Name="ChkUserScope" Content="{loc:T Mcp_Register_AllProjects}"
                              FontSize="12" IsChecked="True" Margin="0,0,0,6"
                              Checked="Scope_Changed" Unchecked="Scope_Changed"/>
                    <TextBlock Text="{loc:T Mcp_Register_Scope_Hint}"
                               Foreground="#888" FontSize="11" Margin="22,-2,0,8" TextWrapping="Wrap"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TxtClaudeCodeCmd" Grid.Column="0" IsReadOnly="True" FontFamily="Consolas"
                                 FontSize="11" Padding="6,4" TextWrapping="Wrap"/>
                        <Button x:Name="BtnCopyCmd" Grid.Column="1" Content="{loc:T Common_Copy}" Margin="8,0,0,0"
                                Style="{StaticResource SecondaryButton}" Click="CopyCmd_Click"/>
                    </Grid>

                    <TextBlock Text="{loc:T Mcp_UpdatePath}" FontWeight="SemiBold" FontSize="13" Margin="0,14,0,2"/>
                    <TextBlock Text="{loc:T Mcp_UpdatePath_Hint}"
                               Foreground="#888" FontSize="11" Margin="0,0,0,6" TextWrapping="Wrap"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TxtClaudeCodeRemove" Grid.Column="0" IsReadOnly="True" FontFamily="Consolas"
                                 FontSize="11" Padding="6,4" Text="claude mcp remove dockpad"/>
                        <Button x:Name="BtnCopyRemove" Grid.Column="1" Content="{loc:T Common_Copy}" Margin="8,0,0,0"
                                Style="{StaticResource SecondaryButton}" Click="CopyRemove_Click"/>
                    </Grid>

                    <TextBlock Text="{loc:T Mcp_ClaudeDesktop}" FontWeight="SemiBold" FontSize="13" Margin="0,14,0,6"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TxtClaudeDesktopCfg" Grid.Column="0" IsReadOnly="True" FontFamily="Consolas"
                                 FontSize="11" Padding="6,4" TextWrapping="Wrap" AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto" MaxHeight="140"/>
                        <Button x:Name="BtnCopyCfg" Grid.Column="1" Content="{loc:T Common_Copy}" Margin="8,0,0,0"
                                VerticalAlignment="Top" Style="{StaticResource SecondaryButton}" Click="CopyCfg_Click"/>
                    </Grid>
                </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ══ Onglet Journal ══ -->
            <TabItem Header="{loc:T Mcp_Tab_Journal}">
                <Grid Margin="8,14,8,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <TextBlock x:Name="TxtLogCount" FontSize="12" Foreground="#555" VerticalAlignment="Center"/>
                        <Button Content="{loc:T Common_Clear}" HorizontalAlignment="Right" Padding="8,4"
                                Style="{StaticResource SecondaryButton}" Click="ClearLog_Click"/>
                    </Grid>

                    <ListBox x:Name="LstLog" Grid.Row="1" HorizontalContentAlignment="Stretch"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="2,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding TimeText}" FontFamily="Consolas"
                                               FontSize="11" Foreground="#888" Margin="0,0,8,0"/>
                                    <TextBlock Grid.Column="1" Text="{Binding StatusIcon}" FontSize="11" Margin="0,0,8,0"/>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock FontSize="12">
                                            <Run Text="{Binding Tool, Mode=OneWay}" FontWeight="SemiBold"/>
                                            <Run Text="{Binding ParamsSummary, Mode=OneWay}" Foreground="#777"/>
                                        </TextBlock>
                                        <TextBlock Text="{Binding Message}" FontSize="11" Foreground="#C0392B"
                                                   TextWrapping="Wrap"
                                                   Style="{StaticResource MessageTextStyle}"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- Footer -->
        <Border Grid.Row="2" Style="{StaticResource DialogFooter}">
            <Grid>
                <TextBlock x:Name="TxtVersion" Style="{StaticResource FooterVersion}"/>
                <Button Content="{loc:T Common_Close}" Style="{StaticResource SecondaryButton}"
                        HorizontalAlignment="Right" Click="Close_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>
