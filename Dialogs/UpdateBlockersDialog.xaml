<Window x:Class="DockPad.UpdateBlockersDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:DockPad.Services.Localization;assembly=DockPad.Core"
        Title="{loc:T Update_BlockedTitle}" Width="700" Height="540" MinWidth="650" MinHeight="400"
        MaxHeight="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Height}"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource Brush.Surface}" FontFamily="Segoe UI">
    <Window.Resources>
        <DataTemplate x:Key="BlockerProcessTemplate">
            <Border BorderBrush="{DynamicResource Brush.Separator}" BorderThickness="0,1,0,0" Padding="0,6">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding Detail}" FontSize="11" Foreground="{DynamicResource Brush.TextDetail}" Margin="12,0,0,0"/>
                    <TextBlock Text="{Binding DisplayName}" FontSize="12" TextWrapping="Wrap"/>
                </DockPanel>
            </Border>
        </DataTemplate>
        <Style x:Key="BlockerExpander" TargetType="Expander">
            <Setter Property="Template"><Setter.Value>
                <ControlTemplate TargetType="Expander">
                    <StackPanel>
                        <DockPanel>
                            <ToggleButton DockPanel.Dock="Right" IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                          Width="26" Height="26" Margin="6,0,0,0" VerticalAlignment="Top" Cursor="Hand"
                                          AutomationProperties.Name="{loc:T Update_ExpandGroup}" Foreground="{DynamicResource Brush.AccentText}">
                                <ToggleButton.Template><ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="Disclosure" Background="{DynamicResource Brush.SurfaceCard}" BorderBrush="{DynamicResource Brush.SurfaceCard}" BorderThickness="1" CornerRadius="4">
                                        <Path x:Name="Chevron" Data="M 0,0 L 4,4 L 8,0" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.4" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True"><Setter TargetName="Chevron" Property="RenderTransform"><Setter.Value><RotateTransform Angle="180"/></Setter.Value></Setter></Trigger>
                                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Disclosure" Property="Background" Value="{DynamicResource Brush.AccentTint}"/></Trigger>
                                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Disclosure" Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/></Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate></ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter ContentSource="Header"/>
                        </DockPanel>
                        <ContentPresenter x:Name="Details" ContentSource="Content" Visibility="Collapsed"/>
                    </StackPanel>
                    <ControlTemplate.Triggers><Trigger Property="IsExpanded" Value="True"><Setter TargetName="Details" Property="Visibility" Value="Visible"/></Trigger></ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value></Setter>
        </Style>
    </Window.Resources>
    <Grid TextElement.Foreground="{DynamicResource Brush.Text}">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Margin="20,18,20,12">
            <TextBlock x:Name="StateLabel" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextLabel}" Margin="0,0,0,6"/>
            <TextBlock x:Name="Heading" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"/>
            <TextBlock x:Name="HelpText" TextWrapping="Wrap" Margin="0,10,0,0"/>
            <TextBlock x:Name="ErrorText" TextWrapping="Wrap" Foreground="{DynamicResource Brush.Danger}" Margin="0,8,0,0" AutomationProperties.LiveSetting="Polite"/>
        </StackPanel>
        <Grid Grid.Row="1" Margin="20,0,20,14">
            <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <StackPanel>
                <Border x:Name="RemainingCard" Background="{DynamicResource Brush.SurfaceCard}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="6" Padding="14,6" Margin="0,0,0,10" Visibility="Collapsed">
                    <ItemsControl x:Name="RemainingProcesses" ItemTemplate="{StaticResource BlockerProcessTemplate}"/>
                </Border>
                <TextBlock x:Name="OtherHeading" Text="{loc:T Update_OtherPrograms}" FontSize="11" FontWeight="SemiBold"
                           Foreground="{DynamicResource Brush.TextLabel}" Margin="0,6,0,8" Visibility="Collapsed"/>
                <ItemsControl x:Name="Processes" AutomationProperties.Name="{loc:T Update_BlockedTitle}">
                    <ItemsControl.ItemTemplate><DataTemplate>
                        <Border Background="{DynamicResource Brush.SurfaceCard}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,10">
                            <Expander Style="{StaticResource BlockerExpander}" Foreground="{DynamicResource Brush.Text}" HorizontalContentAlignment="Stretch" IsExpanded="True">
                                <Expander.Header>
                                    <Grid Margin="4,0,8,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <CheckBox IsChecked="{Binding Selected}" AutomationProperties.Name="{Binding Name}" VerticalAlignment="Top" Margin="0,2,10,0"/>
                                        <StackPanel Grid.Column="1">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"/>
                                                <Border CornerRadius="10" Padding="8,1" Background="{DynamicResource Brush.Border}" Margin="8,0,0,0">
                                                    <TextBlock Text="{Binding Count}" FontSize="12" Foreground="{DynamicResource Brush.TextSmall}"/>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Help}" TextWrapping="Wrap" MaxWidth="570" Margin="0,4,0,0" FontSize="12">
                                                <TextBlock.Style><Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource Brush.WarnTextAlt}"/>
                                                    <Style.Triggers><DataTrigger Binding="{Binding IsMcpRelay}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource Brush.TextLabel}"/>
                                                    </DataTrigger></Style.Triggers>
                                                </Style></TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </Grid>
                                </Expander.Header>
                                <ItemsControl ItemsSource="{Binding Processes}" ItemTemplate="{StaticResource BlockerProcessTemplate}" Margin="32,10,0,0"/>
                            </Expander>
                        </Border>
                    </DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </ScrollViewer>
            <Border x:Name="ForceWarning" Grid.Row="1" Background="{DynamicResource Brush.DangerSurface}" BorderBrush="{DynamicResource Brush.DangerBorder}"
                    BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,10,0,0" Visibility="Collapsed" AutomationProperties.LiveSetting="Polite">
                <TextBlock Text="{loc:T Update_ForceRisk}" TextWrapping="Wrap"/>
            </Border>
        </Grid>
        <Border Grid.Row="2" Style="{StaticResource DialogFooter}" Padding="20,12">
            <DockPanel>
                <Button x:Name="PostponeButton" DockPanel.Dock="Left" Content="{loc:T Update_Postpone}" Style="{StaticResource SecondaryButton}" IsCancel="True"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="RetryButton" Content="{loc:T Update_Retry}" Style="{StaticResource SecondaryButton}" Click="Retry_Click" Margin="0,0,8,0"/>
                    <Button x:Name="CloseButton" Style="{StaticResource PrimaryButton}" Click="CloseSelected_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
