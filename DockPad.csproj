<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>DockPad</AssemblyName>
    <RootNamespace>DockPad</RootNamespace>
    <Nullable>enable</Nullable>
    <Platforms>x64</Platforms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <Version>1.11.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="app.ico" />
    <Resource Include="Assets\folder.png" />
  </ItemGroup>

  <ItemGroup>
    <!-- DockPad.Tests et tools\McpShot sont des projets frères situés dans des sous-dossiers du
         répertoire de DockPad.csproj : sans ces exclusions, le glob par défaut du SDK (**/*.cs)
         compile aussi leurs sources dans l'app. -->
    <Compile Remove="DockPad.Tests\**;tools\**" />
    <EmbeddedResource Remove="DockPad.Tests\**;tools\**" />
    <None Remove="DockPad.Tests\**" />
  </ItemGroup>

  <ItemGroup>
    <None Include="CHANGELOG.md" CopyToPublishDirectory="Always" />
  </ItemGroup>

  <!-- Microsoft.Data.Sqlite embarque les binaires natifs de toutes les plateformes : mesure faite,
       26 Mo de runtimes/ dont 19 Mo pour Linux, macOS et wasm, dans une application net8.0-windows
       x64. On ne garde que les cibles Windows. -->
  <!--
    Ne garde que le binaire natif win-x64. Microsoft.Data.Sqlite embarque son moteur pour toutes les
    plateformes de son package : Linux, macOS, et les quatre architectures Windows. L'application est
    publiee en x64 seul (voir Platform dans le profil), donc x86, arm et arm64 sont du poids mort —
    mesure : 5,7 Mo sur 12, soit un zip qui avait plus que double depuis la version precedente.
    Deux RID sont gardes, et « win » en fait partie : c'est lui qui porte le dossier
    runtimes/win/lib, donc System.Management (le WMI de SwitchToProcess) et
    System.Diagnostics.EventLog. Ne garder que « win-x64 » compile et publie sans broncher,
    puis casse la bascule de processus a l'execution.
  -->
  <Target Name="TrimForeignRuntimes" AfterTargets="ResolvePackageAssets">
    <ItemGroup>
      <RuntimeTargetsCopyLocalItems Remove="@(RuntimeTargetsCopyLocalItems)" Condition="'%(RuntimeIdentifier)' != 'win-x64' And '%(RuntimeIdentifier)' != 'win'" />
    </ItemGroup>
  </Target>

  <Target Name="ZipAfterPublish" AfterTargets="Publish">
    <MakeDir Directories="$(MSBuildProjectDirectory)\release" />
    <ZipDirectory SourceDirectory="$(PublishDir)" DestinationFile="$(MSBuildProjectDirectory)\release\DockPad-$(Version).zip" Overwrite="true" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)\CHANGELOG.md" DestinationFiles="$(MSBuildProjectDirectory)\release\DockPad-$(Version)-Changelog.md" OverwriteReadOnlyFiles="true" />
    <RemoveDir Directories="$(PublishDir)" />
    <Message Text="Archive créée : release\DockPad-$(Version).zip" Importance="high" />
  </Target>

  <ItemGroup>
    <!-- Aligne sur le framework cible (net8.0) et non sur la derniere version : le SDK installe
         est un .NET 10, mais l'application est publiee framework-dependent pour .NET 8. -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.11" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.10" />
    <PackageReference Include="ModelContextProtocol" Version="2.1.0" />
    <PackageReference Include="Serilog" Version="4.4.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="SmartFormat" Version="3.6.1" />
    <PackageReference Include="System.Drawing.Common" Version="8.0.0" />
    <PackageReference Include="System.Management" Version="8.0.0" />
  </ItemGroup>

</Project>
