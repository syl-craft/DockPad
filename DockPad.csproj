<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>DockPad</AssemblyName>
    <RootNamespace>DockPad</RootNamespace>
    <Nullable>enable</Nullable>
    <Platforms>x64</Platforms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <Version>1.8.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="app.ico" />
    <Resource Include="Assets\folder.png" />
  </ItemGroup>

  <ItemGroup>
    <!-- DockPad.Tests est un projet frère situé dans un sous-dossier du répertoire de DockPad.csproj :
         sans cette exclusion, le glob par défaut du SDK (**/*.cs) y compile aussi SmokeTests.cs. -->
    <Compile Remove="DockPad.Tests\**" />
    <EmbeddedResource Remove="DockPad.Tests\**" />
    <None Remove="DockPad.Tests\**" />
  </ItemGroup>

  <ItemGroup>
    <None Include="CHANGELOG.md" CopyToPublishDirectory="Always" />
  </ItemGroup>

  <Target Name="ZipAfterPublish" AfterTargets="Publish">
    <MakeDir Directories="$(MSBuildProjectDirectory)\release" />
    <ZipDirectory SourceDirectory="$(PublishDir)" DestinationFile="$(MSBuildProjectDirectory)\release\DockPad-$(Version).zip" Overwrite="true" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)\CHANGELOG.md" DestinationFiles="$(MSBuildProjectDirectory)\release\DockPad-$(Version)-Changelog.md" OverwriteReadOnlyFiles="true" />
    <RemoveDir Directories="$(PublishDir)" />
    <Message Text="Archive créée : release\DockPad-$(Version).zip" Importance="high" />
  </Target>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.10" />
    <PackageReference Include="ModelContextProtocol" Version="2.1.0" />
    <PackageReference Include="Serilog" Version="4.4.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="System.Drawing.Common" Version="8.0.0" />
    <PackageReference Include="System.Management" Version="8.0.0" />
  </ItemGroup>

</Project>
