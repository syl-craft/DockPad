<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>DockPad</AssemblyName>
    <RootNamespace>DockPad</RootNamespace>
    <Nullable>enable</Nullable>
    <Platforms>x64</Platforms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <Version>1.3.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="app.ico"/>
  </ItemGroup>

  <Target Name="ZipAfterPublish" AfterTargets="Publish">
    <MakeDir Directories="$(MSBuildProjectDirectory)\release"/>
    <ZipDirectory SourceDirectory="$(PublishDir)"
                  DestinationFile="$(MSBuildProjectDirectory)\release\DockPad-$(Version).zip"
                  Overwrite="true"/>
    <RemoveDir Directories="$(PublishDir)"/>
    <Message Text="Archive créée : release\DockPad-$(Version).zip" Importance="high"/>
  </Target>

  <ItemGroup>
    <PackageReference Include="System.Drawing.Common" Version="8.0.0"/>
  </ItemGroup>

</Project>
