<Window x:Class="DockPad.PresetsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Raccourcis prédéfinis"
        Width="580" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F3F3F3"
        FontFamily="Segoe UI">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#0078D4" Padding="20,14">
            <TextBlock Text="Raccourcis prédéfinis" FontSize="16"
                       FontWeight="SemiBold" Foreground="White"/>
        </Border>

        <!-- Contenu -->
        <StackPanel Grid.Row="1" Margin="24,20">
            <TextBlock Text="Sélectionnez les raccourcis à installer ou mettre à jour"
                       FontSize="13" Foreground="#555" Margin="0,0,0,16"/>

            <ItemsControl x:Name="ItemsPresets">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,0,10" Padding="14,12"
                                BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="6"
                                Background="White" Opacity="{Binding Opacity}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <CheckBox Grid.Column="0" VerticalAlignment="Center"
                                          IsChecked="{Binding IsSelected}"
                                          IsEnabled="{Binding CanSelect}"
                                          Margin="0,0,14,0"/>

                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding DisplayName}"
                                               FontSize="13" FontWeight="SemiBold" Foreground="#1A1A1A"/>
                                    <TextBlock Text="{Binding Description}"
                                               FontSize="12" Foreground="#666" Margin="0,3,0,0"/>
                                    <TextBlock Text="{Binding Command}" FontSize="11"
                                               Foreground="#999" Margin="0,3,0,0"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>

                                <Border Grid.Column="2" VerticalAlignment="Center" Margin="12,0,0,0"
                                        Background="{Binding BadgeBackground}"
                                        CornerRadius="4" Padding="8,4"
                                        Visibility="{Binding ShowBadge, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <TextBlock Text="{Binding BadgeText}" FontSize="11"
                                               Foreground="{Binding BadgeForeground}"/>
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <!-- Footer -->
        <Border Grid.Row="2" Background="White" Padding="24,12"
                BorderBrush="#E0E0E0" BorderThickness="0,1,0,0">
            <Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <Button Content="☰ Menu contextuel" Style="{StaticResource SecondaryButton}"
                            Margin="0,0,8,0" Click="OpenContextMenuManager_Click"/>
                    <Button Content="↻ Actualiser" Style="{StaticResource SecondaryButton}"
                            Click="Refresh_Click"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Annuler" Style="{StaticResource SecondaryButton}"
                            Margin="0,0,12,0" Click="Cancel_Click"/>
                    <Button x:Name="BtnInstall" Content="Installer / Mettre à jour"
                            Style="{StaticResource PrimaryButton}" Click="Install_Click"/>
                    <Button x:Name="BtnElevate" Content="🛡 Élever"
                            Style="{StaticResource PrimaryButton}" Visibility="Collapsed"
                            Click="Elevate_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
