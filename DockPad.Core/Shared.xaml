<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Les styles partages des deux applications. Sortis d'App.xaml a l'extraction de
        DockPad.Core : une fenetre de la bibliotheque les reference, et un dictionnaire qui
        vit dans l'application ne lui serait pas visible.
    -->

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource Brush.Accent}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <!-- BorderBrush et BorderThickness sont liés au gabarit, alors qu'ils
                             ne l'étaient pas : un bouton secondaire a pour fond Brush.Surface,
                             soit exactement le fond de fenêtre, et disparaissait donc dans une
                             page. Sans effet ailleurs — l'épaisseur vaut 0 par défaut. -->
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True"
                                UseLayoutRounding="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource Brush.AccentHover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="{DynamicResource Brush.AccentPressed}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="{DynamicResource Brush.BorderStrong}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="{DynamicResource Brush.DangerStrong}"/>
            <!-- Blanc dans les deux themes : c'est du texte pose SUR le rouge. -->
            <Setter Property="Foreground" Value="White"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Brush.DangerHover}"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Brush.DangerPressed}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="{DynamicResource Brush.Surface}"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Brush.Border}"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Brush.SurfacePressed}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!--
            Onglet plat, soulignement bleu sur l'actif : le langage visuel des fenêtres à
            onglets du projet. Il vivait en double, recopié mot pour mot dans McpConfigDialog
            et BrowserConfigDialog ; la fenêtre d'Options en aurait fait une troisième copie.
            À poser par ItemContainerStyle sur le TabControl.
        -->
        <!--
            Typographie posée sur le Border du gabarit (TextElement.*), jamais sur le TabItem :
            Foreground, FontSize et FontWeight sont des propriétés HÉRITÉES. Posées sur
            l'onglet, elles descendent dans tout son contenu — l'accent bleu de l'onglet actif
            repeignait alors les titres de section de la page. Le Border ne couvre que l'en-tête.
        -->
        <Style x:Key="FlatTabItem" TargetType="TabItem">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Bd" Background="Transparent" Padding="14,8"
                                BorderThickness="0,0,0,2" BorderBrush="Transparent"
                                TextElement.FontSize="13"
                                TextElement.Foreground="{DynamicResource Brush.TextLabel}">
                            <ContentPresenter ContentSource="Header"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.RowHover}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
                                <Setter TargetName="Bd" Property="TextElement.Foreground" Value="{DynamicResource Brush.Accent}"/>
                                <Setter TargetName="Bd" Property="TextElement.FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Footer commun des fenêtres de config : version à gauche, boutons à droite -->
        <Style x:Key="DialogFooter" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Brush.SurfaceCard}"/>
            <Setter Property="Padding" Value="24,12"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
            <Setter Property="BorderThickness" Value="0,1,0,0"/>
        </Style>
        <Style x:Key="FooterVersion" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextDisabled}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

</ResourceDictionary>
