<Window x:Class="DockPad.Secrets.SecretInjectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:DockPad.Services.Localization;assembly=DockPad.Core"
        Title="{loc:T Inject_Title}"
        Width="520" SizeToContent="Height"
        MaxHeight="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Height}"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Topmost="True"
        Background="{DynamicResource Brush.Surface}"
        FontFamily="Segoe UI">
    <Grid TextElement.Foreground="{DynamicResource Brush.Text}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header : le nom du fichier fait partie du titre. Rendre le mauvais fichier est
             precisement la classe d'erreur que cette fonctionnalite existe pour supprimer. -->
        <Border Grid.Row="0" Background="{DynamicResource Brush.Accent}" Padding="20,14">
            <StackPanel>
                <TextBlock Text="{loc:T Inject_Title}" FontSize="16"
                           FontWeight="SemiBold" Foreground="White"/>
                <TextBlock x:Name="TxtFile" FontSize="12" Margin="0,3,0,0"
                           FontFamily="Consolas" TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource Brush.OnAccentMuted}"/>
            </StackPanel>
        </Border>

        <!-- Contenu : un panneau par etat, un seul visible a la fois. -->
        <Grid Grid.Row="1" Margin="24,20">

            <!-- Verification, et travail : meme forme, deux libelles -->
            <StackPanel x:Name="PanelBusy" Visibility="Collapsed">
                <TextBlock x:Name="TxtBusy" Foreground="{DynamicResource Brush.TextLabel}"
                           TextWrapping="Wrap"/>
                <ProgressBar IsIndeterminate="True" Height="4" Margin="0,12,0,0"
                             Background="{DynamicResource Brush.SurfaceMuted}"
                             Foreground="{DynamicResource Brush.Accent}" BorderThickness="0"/>
            </StackPanel>

            <!-- Deverrouillage -->
            <StackPanel x:Name="PanelUnlock" Visibility="Collapsed">
                <TextBlock Text="{loc:T Inject_Unlock_Prompt}"
                           Foreground="{DynamicResource Brush.TextLabel}" Margin="0,0,0,8"/>
                <PasswordBox x:Name="TxtPassword" Padding="6,6" FontSize="13"
                             Background="{DynamicResource Brush.SurfaceCard}"
                             Foreground="{DynamicResource Brush.Text}"
                             CaretBrush="{DynamicResource Brush.Text}"
                             BorderBrush="{DynamicResource Brush.BorderStrong}" BorderThickness="1"
                             KeyDown="Password_KeyDown"/>
                <TextBlock x:Name="TxtUnlockError" Margin="0,8,0,0" FontSize="11"
                           TextWrapping="Wrap" Visibility="Collapsed"
                           Foreground="{DynamicResource Brush.Danger}"/>
            </StackPanel>

            <!-- Compte-rendu de succes -->
            <StackPanel x:Name="PanelSuccess" Visibility="Collapsed">
                <TextBlock x:Name="TxtSummary" FontSize="13" FontWeight="SemiBold"
                           TextWrapping="Wrap" Foreground="{DynamicResource Brush.Text}"/>
                <TextBlock Text="{loc:T Inject_Success_Clipboard}" Margin="0,6,0,0"
                           Foreground="{DynamicResource Brush.TextMuted}"/>
                <TextBlock x:Name="TxtCountdown" Margin="0,14,0,0" FontSize="12"
                           Foreground="{DynamicResource Brush.Accent}" Visibility="Collapsed"/>
            </StackPanel>

            <!-- Compte-rendu du mode fichiers : ce qui a ete ecrit, et ou -->
            <StackPanel x:Name="PanelFiles" Visibility="Collapsed">
                <TextBlock x:Name="TxtFilesSummary" FontSize="13" FontWeight="SemiBold"
                           TextWrapping="Wrap" Foreground="{DynamicResource Brush.Text}"/>
                <TextBlock Text="{loc:T Inject_Files_Folder}" Margin="0,10,0,2"
                           Foreground="{DynamicResource Brush.TextLabel}" FontSize="11"/>
                <TextBlock x:Name="TxtFilesFolder" FontFamily="Consolas" FontSize="11"
                           TextWrapping="Wrap" Foreground="{DynamicResource Brush.TextMuted}"/>
                <ItemsControl x:Name="ListWritten" Margin="0,10,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="12"
                                       Margin="0,0,0,2" Foreground="{DynamicResource Brush.Text}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- Compte-rendu d'echec : ce qui a echoue, et pourquoi rien n'a ete produit -->
            <StackPanel x:Name="PanelFailed" Visibility="Collapsed">
                <TextBlock Text="{loc:T Inject_Failed_Title}" FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource Brush.Danger}"/>
                <ItemsControl x:Name="ListFailures" Margin="0,10,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,0,0,4"
                                       Foreground="{DynamicResource Brush.Text}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <!-- Pose en code, sans {loc:T} : la phrase depend du mode, et le mode n'est connu
                     qu'a l'affichage. Une liaison ici serait ecrasee par l'affectation. -->
                <TextBlock x:Name="TxtFailedHint" Margin="0,12,0,0" FontSize="11"
                           TextWrapping="Wrap" Foreground="{DynamicResource Brush.TextHint}"/>
                <TextBlock x:Name="TxtDiagnostic" Margin="0,10,0,0" FontSize="11"
                           FontFamily="Consolas" TextWrapping="Wrap" Visibility="Collapsed"
                           ToolTip="{loc:T Inject_Detail}"
                           Foreground="{DynamicResource Brush.TextFaint}"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource DialogFooter}">
            <Grid>
                <TextBlock x:Name="TxtVersion" Style="{StaticResource FooterVersion}"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="BtnOpenFolder" Content="{loc:T Inject_OpenFolder}"
                            Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"
                            Visibility="Collapsed" Click="OpenFolder_Click"/>
                    <Button x:Name="BtnClear" Content="{loc:T Common_Clear}"
                            Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"
                            Visibility="Collapsed" Click="Clear_Click"/>
                    <Button x:Name="BtnUnlock" Content="{loc:T Inject_Unlock_Button}"
                            Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"
                            Visibility="Collapsed" Click="Unlock_Click"/>
                    <!-- Pas de {loc:T} ici : quatre chemins affectent Content, et une valeur locale remplace
                         definitivement la liaison — le bouton deviendrait sourd aux changements de
                         langue. Le libelle est pose en code, et repose a chaque bascule. -->
                    <Button x:Name="BtnClose"
                            Style="{StaticResource SecondaryButton}" Click="Close_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
