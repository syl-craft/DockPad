<Window x:Class="DockPad.Secrets.SecretInjectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:DockPad.Services.Localization;assembly=DockPad.Core"
        Title="{loc:T Inject_Title}"
        Width="520" SizeToContent="Height"
        MaxHeight="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Height}"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Topmost="True"
        Background="{DynamicResource Brush.Surface}"
        FontFamily="Segoe UI">
    <Window.Resources>
        <!-- Le 👁 des lignes de creation, construites en code. Gabarit plat : celui d'Aero2 peint
             son propre fond au survol et coche, en clair, et le bouton devenait un carre blanc
             en theme sombre. Les brosses sont posees par le code, le gabarit ne fait que les lire. -->
        <ControlTemplate x:Key="EyeToggleTemplate" TargetType="ToggleButton">
            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="3" SnapsToDevicePixels="True" UseLayoutRounding="True">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.AccentSoft}"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
    </Window.Resources>
    <Grid TextElement.Foreground="{DynamicResource Brush.Text}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header : le nom du fichier fait partie du titre. Rendre le mauvais fichier est
             precisement la classe d'erreur que cette fonctionnalite existe pour supprimer. -->
        <Border Grid.Row="0" Background="{DynamicResource Brush.Accent}" Padding="20,14">
            <StackPanel>
                <TextBlock Text="{loc:T Inject_Title}" FontSize="16"
                           FontWeight="SemiBold" Foreground="White"/>
                <TextBlock x:Name="TxtFile" FontSize="12" Margin="0,3,0,0"
                           FontFamily="Consolas" TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource Brush.OnAccentMuted}"/>
            </StackPanel>
        </Border>

        <!-- Contenu : un panneau par etat, un seul visible a la fois. -->
        <Grid Grid.Row="1" Margin="24,20">

            <!-- Verification, et travail : meme forme, deux libelles -->
            <StackPanel x:Name="PanelBusy" Visibility="Collapsed">
                <TextBlock x:Name="TxtBusy" Foreground="{DynamicResource Brush.TextLabel}"
                           TextWrapping="Wrap"/>
                <ProgressBar IsIndeterminate="True" Height="4" Margin="0,12,0,0"
                             Background="{DynamicResource Brush.SurfaceMuted}"
                             Foreground="{DynamicResource Brush.Accent}" BorderThickness="0"/>
            </StackPanel>

            <!-- Deverrouillage -->
            <StackPanel x:Name="PanelUnlock" Visibility="Collapsed">
                <TextBlock Text="{loc:T Inject_Unlock_Prompt}"
                           Foreground="{DynamicResource Brush.TextLabel}" Margin="0,0,0,8"/>
                <PasswordBox x:Name="TxtPassword" Padding="6,6" FontSize="13"
                             Background="{DynamicResource Brush.SurfaceCard}"
                             Foreground="{DynamicResource Brush.Text}"
                             CaretBrush="{DynamicResource Brush.Text}"
                             BorderBrush="{DynamicResource Brush.BorderStrong}" BorderThickness="1"
                             KeyDown="Password_KeyDown"/>
                <TextBlock x:Name="TxtUnlockError" Margin="0,8,0,0" FontSize="11"
                           TextWrapping="Wrap" Visibility="Collapsed"
                           Foreground="{DynamicResource Brush.Danger}"/>

                <!-- La CLI travaille sur un CACHE LOCAL : un item modifie dans le coffre n'existe
                     pas pour `bw list items` tant qu'aucun `bw sync` n'a eu lieu. Le piege a mordu
                     trois fois, dont une en deposant une cle perimee.

                     Cochee par defaut : le coffre bouge PRECISEMENT quand on injecte — on vient
                     d'y deposer la valeur qu'on veut deployer. Le prix de l'oubli n'est pas une
                     seconde d'attente, c'est un secret perime deploye et decouvert bien plus loin.

                     Elle vit ICI et non dans les Options : c'est le moment ou la question se pose,
                     et la cle de session existe deja — donc un appel de plus dans la sequence,
                     sans second mot de passe. -->
                <CheckBox x:Name="ChkSync" Content="{loc:T Inject_Unlock_Sync}"
                          Margin="0,16,0,0" Click="Sync_Changed"/>
                <TextBlock Text="{loc:T Inject_Unlock_SyncHint}" Margin="24,4,0,0" FontSize="11"
                           TextWrapping="Wrap" Foreground="{DynamicResource Brush.TextHint}"/>
            </StackPanel>

            <!-- CHOIX DES SORTIES — seulement quand le fichier porte les DEUX formats.
                 Un fichier qui n'en porte qu'un ne passe pas par ici : une case unique,
                 pre-cochee, dont decocher revient a ne rien faire, n'est pas un choix mais un
                 clic de plus.

                 Il vit DANS cette fenetre, comme cinquieme etat, et non dans une seconde : deux
                 fenetres superposees sont precisement ce qu'on cherche a supprimer.

                 Et il arrive AVANT le mot de passe : reclamer le mot de passe maitre puis demander
                 quoi en faire, c'est faire payer avant de savoir ce qu'on achete. -->
            <StackPanel x:Name="PanelChoice" Visibility="Collapsed">
                <TextBlock Text="{loc:T Inject_Choice_Prompt}" TextWrapping="Wrap"
                           Foreground="{DynamicResource Brush.TextLabel}"/>
                <CheckBox x:Name="ChkFiles" Content="{loc:T Inject_Choice_Files}"
                          Margin="0,14,0,0" IsChecked="True" Click="Choice_Changed"/>
                <CheckBox x:Name="ChkClipboard" Content="{loc:T Inject_Choice_Clipboard}"
                          Margin="0,10,0,0" IsChecked="True" Click="Choice_Changed"/>
                <TextBlock x:Name="TxtChoiceHint" Text="{loc:T Inject_Choice_Hint}"
                           Margin="0,14,0,0" FontSize="11" TextWrapping="Wrap"
                           Visibility="Collapsed"
                           Foreground="{DynamicResource Brush.TextHint}"/>
            </StackPanel>

            <!-- INVENTAIRE GITHUB — la verification, AVANT le mot de passe maitre : elle ne lit que
                 des noms. Ce que l'envoi va creer, ecraser (avec l'age, pour voir venir une cle qui
                 expire) et laisser tel quel. Ce qui n'est que sur GitHub est signale, jamais
                 supprime. Des TextBox en lecture seule : les noms se recopient. -->
            <StackPanel x:Name="PanelGitHub" Visibility="Collapsed">
                <TextBlock x:Name="TxtGitHubTitle" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap"
                           Foreground="{DynamicResource Brush.TextStrong}"/>
                <TextBox x:Name="TxtGitHubTarget" IsReadOnly="True" Margin="0,4,0,0"
                         FontFamily="Consolas" FontSize="12" TextWrapping="Wrap"
                         Background="Transparent" BorderThickness="0" Padding="0" IsTabStop="False"
                         Foreground="{DynamicResource Brush.TextMuted}"/>

                <StackPanel x:Name="BlocGitHubMissing" Visibility="Collapsed">
                    <TextBlock Text="{loc:T GitHub_Check_Missing}" Margin="0,14,0,3" FontSize="11"
                               Foreground="{DynamicResource Brush.TextLabel}"/>
                    <ItemsControl x:Name="ListGitHubMissing">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBox Text="{Binding Mode=OneWay}" IsReadOnly="True"
                                         FontFamily="Consolas" FontSize="12" Margin="0,0,0,2"
                                         Background="Transparent" BorderThickness="0" Padding="0"
                                         IsTabStop="False" Foreground="{DynamicResource Brush.Text}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <StackPanel x:Name="BlocGitHubPresent" Visibility="Collapsed">
                    <TextBlock Text="{loc:T GitHub_Check_Present}" Margin="0,14,0,3" FontSize="11"
                               Foreground="{DynamicResource Brush.TextLabel}"/>
                    <ItemsControl x:Name="ListGitHubPresent">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBox Text="{Binding Mode=OneWay}" IsReadOnly="True"
                                         FontFamily="Consolas" FontSize="12" Margin="0,0,0,2"
                                         Background="Transparent" BorderThickness="0" Padding="0"
                                         IsTabStop="False" Foreground="{DynamicResource Brush.Text}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <Border x:Name="BlocGitHubExtra" Margin="0,14,0,0" Visibility="Collapsed"
                        Background="{DynamicResource Brush.WarnSurface}"
                        BorderBrush="{DynamicResource Brush.WarnBorder}" BorderThickness="1"
                        CornerRadius="4" Padding="10,8"
                        SnapsToDevicePixels="True" UseLayoutRounding="True">
                    <StackPanel>
                        <TextBlock Text="{loc:T GitHub_Check_Extra}" TextWrapping="Wrap"
                                   FontSize="11" Foreground="{DynamicResource Brush.WarnText}"/>
                        <ItemsControl x:Name="ListGitHubExtra" Margin="0,6,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBox Text="{Binding Mode=OneWay}" IsReadOnly="True"
                                             FontFamily="Consolas" FontSize="12" Margin="0,0,0,2"
                                             Background="Transparent" BorderThickness="0" Padding="0"
                                             IsTabStop="False" Foreground="{DynamicResource Brush.WarnText}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <TextBlock Text="{loc:T GitHub_Check_Hint}" Margin="0,14,0,0" FontSize="11"
                           TextWrapping="Wrap" Foreground="{DynamicResource Brush.TextHint}"/>
            </StackPanel>

            <!-- CREER CE QUI MANQUE — entre le deverrouillage et le rendu, avec la cle de session
                 deja ouverte : un seul mot de passe maitre. N'apparait que s'il y a quelque chose
                 a creer ; un item en double n'y figure jamais. -->
            <StackPanel x:Name="PanelCreate" Visibility="Collapsed">
                <TextBlock Text="{loc:T Inject_Create_Title}" FontSize="14" FontWeight="SemiBold"
                           Foreground="{DynamicResource Brush.TextStrong}"/>
                <TextBlock x:Name="TxtCreateIntro" Margin="0,4,0,12" TextWrapping="Wrap"
                           Foreground="{DynamicResource Brush.TextMuted}"/>
                <ScrollViewer MaxHeight="340" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="CreateRows"/>
                </ScrollViewer>
                <StackPanel x:Name="RowCollection" Orientation="Horizontal" Margin="0,12,0,0">
                    <TextBlock Text="{loc:T Inject_Create_Collection}" VerticalAlignment="Center"
                               Foreground="{DynamicResource Brush.TextLabel}" Margin="0,0,10,0"/>
                    <ComboBox x:Name="CmbCollection" Width="220" DisplayMemberPath="Name"/>
                </StackPanel>
                <TextBlock x:Name="TxtCreateNote" Margin="0,8,0,0" FontSize="11" TextWrapping="Wrap"
                           Visibility="Collapsed" Foreground="{DynamicResource Brush.WarnText}"/>
                <TextBlock Text="{loc:T Inject_Create_EmptyHint}" Margin="0,10,0,0" FontSize="11"
                           Foreground="{DynamicResource Brush.TextHint}"/>
            </StackPanel>

            <!-- COMPTE-RENDU UNIQUE.
                 Trois panneaux vivaient ici — succes, fichiers, incomplet — et un seul s'affichait.
                 Consequence : en mode « les deux », le succes complet montrait les fichiers et ne
                 disait JAMAIS que le rendu etait dans le presse-papier. La moitie de l'information
                 disparaissait. Un seul ecran a sections conditionnelles, quel que soit le nombre de
                 sorties.

                 Le titre bascule vert/ambre selon que c'est complet : la panne d'origine n'etait pas
                 qu'un rendu soit partiel, c'est qu'il ait eu l'air complet. -->
            <StackPanel x:Name="PanelResult" Visibility="Collapsed">
                <TextBlock x:Name="TxtResultTitle" FontSize="13" FontWeight="SemiBold"
                           TextWrapping="Wrap"/>
                <TextBlock x:Name="TxtResultSummary" Margin="0,6,0,0" TextWrapping="Wrap"
                           Foreground="{DynamicResource Brush.TextMuted}"/>

                <!-- Les cles absentes, AVANT ce qui a marche : c'est ce sur quoi on doit agir.
                     Des TextBox en lecture seule, pas des TextBlock : un TextBlock ne se
                     selectionne pas, et ces lignes sont precisement ce qu'on veut recopier pour
                     aller creer la cle dans le coffre. Meme motif que l'URL du selecteur de
                     navigateur. Sans BOUTON de copie : il ecraserait le rendu qu'on vient de mettre
                     dans le presse-papier, alors qu'une selection au clavier est un geste explicite
                     de l'utilisateur. -->
                <StackPanel x:Name="BlocMissing" Visibility="Collapsed">
                    <TextBlock Text="{loc:T Inject_Partial_Missing}" Margin="0,14,0,3" FontSize="11"
                               Foreground="{DynamicResource Brush.TextLabel}"/>
                    <ItemsControl x:Name="ListMissing">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBox Text="{Binding Mode=OneWay}" IsReadOnly="True"
                                         TextWrapping="Wrap" Margin="0,0,0,4"
                                         Background="Transparent" BorderThickness="0" Padding="0"
                                         IsTabStop="False"
                                         Foreground="{DynamicResource Brush.Text}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- Les fichiers ecrits, et ou -->
                <StackPanel x:Name="BlocWritten" Visibility="Collapsed">
                    <TextBlock Text="{loc:T Inject_Files_Folder}" Margin="0,14,0,2" FontSize="11"
                               Foreground="{DynamicResource Brush.TextLabel}"/>
                    <TextBox x:Name="TxtFilesFolder" IsReadOnly="True" TextWrapping="Wrap"
                             FontFamily="Consolas" FontSize="11"
                             Background="Transparent" BorderThickness="0" Padding="0"
                             IsTabStop="False"
                             Foreground="{DynamicResource Brush.TextMuted}"/>
                    <ItemsControl x:Name="ListWritten" Margin="0,8,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBox Text="{Binding Mode=OneWay}" IsReadOnly="True"
                                         FontFamily="Consolas" FontSize="12" Margin="0,0,0,2"
                                         Background="Transparent" BorderThickness="0" Padding="0"
                                         IsTabStop="False"
                                         Foreground="{DynamicResource Brush.Text}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button x:Name="BtnOpenFolder" Content="{loc:T Inject_OpenFolder}"
                                Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"
                                Click="OpenFolder_Click"/>
                        <Button x:Name="BtnDeleteWritten" Content="{loc:T Inject_Files_Delete}"
                                Style="{StaticResource SecondaryButton}"
                                Click="DeleteWritten_Click"/>
                    </StackPanel>
                </StackPanel>

                <!-- Les noms envoyes a GitHub, et ou. Jamais une valeur. -->
                <StackPanel x:Name="BlocGitHubSent" Visibility="Collapsed">
                    <TextBlock Text="{loc:T GitHub_Result_Target}" Margin="0,14,0,2" FontSize="11"
                               Foreground="{DynamicResource Brush.TextLabel}"/>
                    <TextBox x:Name="TxtGitHubSentTarget" IsReadOnly="True" TextWrapping="Wrap"
                             FontFamily="Consolas" FontSize="11"
                             Background="Transparent" BorderThickness="0" Padding="0"
                             IsTabStop="False" Foreground="{DynamicResource Brush.TextMuted}"/>
                    <ItemsControl x:Name="ListGitHubSent" Margin="0,8,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBox Text="{Binding Mode=OneWay}" IsReadOnly="True"
                                         FontFamily="Consolas" FontSize="12" Margin="0,0,0,2"
                                         Background="Transparent" BorderThickness="0" Padding="0"
                                         IsTabStop="False" Foreground="{DynamicResource Brush.Text}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- LE PRESSE-PAPIER, en deux temps quand des fichiers l'accompagnent.
                     Le decompte courait pendant qu'on copiait les fichiers sur le NAS : quatre-
                     vingt-dix secondes plus tard le rendu etait efface, et rien n'avait ete colle.
                     Le rendu attend donc un clic, et l'attente est bornee par le geste plutot que
                     par le minuteur.

                     Les commandes vivent A COTE de ce sur quoi elles agissent : cinq boutons dans
                     un pied de 520 px ne tiendraient pas, et le bloc des perimes fait deja ainsi. -->
                <StackPanel x:Name="BlocClipboard" Visibility="Collapsed">
                    <TextBlock x:Name="TxtClipboardState" Margin="0,12,0,0"
                               TextWrapping="Wrap" Foreground="{DynamicResource Brush.TextMuted}"/>
                    <TextBlock x:Name="TxtCountdown" Margin="0,6,0,0" FontSize="12"
                               Foreground="{DynamicResource Brush.Accent}" Visibility="Collapsed"/>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button x:Name="BtnArm" Content="{loc:T Inject_Clipboard_Arm}"
                                Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"
                                Visibility="Collapsed" Click="Arm_Click"/>
                        <Button x:Name="BtnPause" Content="{loc:T Inject_Clipboard_Pause}"
                                Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"
                                Visibility="Collapsed" Click="Pause_Click"/>
                        <Button x:Name="BtnClear" Content="{loc:T Inject_Clipboard_Clear}"
                                Style="{StaticResource SecondaryButton}"
                                Visibility="Collapsed" Click="Clear_Click"/>
                    </StackPanel>
                </StackPanel>

                <!-- Les perimes : signales, jamais supprimes sans un geste. -->
                <Border x:Name="BlocStale" Margin="0,14,0,0" Visibility="Collapsed"
                        Background="{DynamicResource Brush.WarnSurface}"
                        BorderBrush="{DynamicResource Brush.WarnBorder}" BorderThickness="1"
                        CornerRadius="4" Padding="10,8"
                        SnapsToDevicePixels="True" UseLayoutRounding="True">
                    <StackPanel>
                        <TextBlock Text="{loc:T Inject_Partial_Stale}" TextWrapping="Wrap"
                                   FontSize="11" Foreground="{DynamicResource Brush.WarnText}"/>
                        <ItemsControl x:Name="ListStale" Margin="0,6,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBox Text="{Binding Mode=OneWay}" IsReadOnly="True"
                                             FontFamily="Consolas" FontSize="12" Margin="0,0,0,2"
                                             Background="Transparent" BorderThickness="0" Padding="0"
                                             IsTabStop="False"
                                             Foreground="{DynamicResource Brush.WarnText}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button x:Name="BtnDeleteStale" Content="{loc:T Inject_Partial_Delete}"
                                Margin="0,10,0,0" HorizontalAlignment="Left"
                                Style="{StaticResource SecondaryButton}" Click="DeleteStale_Click"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Compte-rendu d'echec : ce qui a echoue, et pourquoi rien n'a ete produit -->
            <StackPanel x:Name="PanelFailed" Visibility="Collapsed">
                <TextBlock Text="{loc:T Inject_Failed_Title}" FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource Brush.Danger}"/>
                <ItemsControl x:Name="ListFailures" Margin="0,10,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,0,0,4"
                                       Foreground="{DynamicResource Brush.Text}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <!-- Pose en code, sans {loc:T} : la phrase depend du mode, et le mode n'est connu
                     qu'a l'affichage. Une liaison ici serait ecrasee par l'affectation. -->
                <TextBlock x:Name="TxtFailedHint" Margin="0,12,0,0" FontSize="11"
                           TextWrapping="Wrap" Foreground="{DynamicResource Brush.TextHint}"/>
                <TextBlock x:Name="TxtDiagnostic" Margin="0,10,0,0" FontSize="11"
                           FontFamily="Consolas" TextWrapping="Wrap" Visibility="Collapsed"
                           ToolTip="{loc:T Inject_Detail}"
                           Foreground="{DynamicResource Brush.TextFaint}"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource DialogFooter}">
            <Grid>
                <TextBlock x:Name="TxtVersion" Style="{StaticResource FooterVersion}"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="BtnSkipCreate" Content="{loc:T Inject_Create_Skip}"
                            Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"
                            Visibility="Collapsed" Click="SkipCreate_Click"/>
                    <Button x:Name="BtnCreate" Content="{loc:T Inject_Create_Button}"
                            Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"
                            Visibility="Collapsed" IsEnabled="False" Click="Create_Click"/>
                    <Button x:Name="BtnContinue" Content="{loc:T Inject_Choice_Continue}"
                            Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"
                            Visibility="Collapsed" Click="Continue_Click"/>
                    <Button x:Name="BtnUnlock" Content="{loc:T Inject_Unlock_Button}"
                            Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"
                            Visibility="Collapsed" Click="Unlock_Click"/>
                    <!-- Pas de {loc:T} ici : quatre chemins affectent Content, et une valeur locale remplace
                         definitivement la liaison — le bouton deviendrait sourd aux changements de
                         langue. Le libelle est pose en code, et repose a chaque bascule. -->
                    <Button x:Name="BtnClose"
                            Style="{StaticResource SecondaryButton}" Click="Close_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
