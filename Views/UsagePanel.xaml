<UserControl x:Class="DockPad.Views.UsagePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:DockPad.Services.Localization;assembly=DockPad.Core"
             FontFamily="Segoe UI">

    <UserControl.Resources>

        <!-- Badge « démo » : les chiffres inventés ne doivent pas se lire comme réels. -->
        <Style x:Key="DemoBadge" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Brush.DemoSurface}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.DemoBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="4,0"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="UseLayoutRounding" Value="True"/>
        </Style>

        <!-- Barre de jauge : un ProgressBar retemplaté, la proportionnalité est native. -->
        <Style x:Key="GaugeBar" TargetType="ProgressBar">
            <Setter Property="Height" Value="6"/>
            <Setter Property="MinWidth" Value="36"/>
            <Setter Property="Minimum" Value="0"/>
            <Setter Property="Maximum" Value="100"/>
            <Setter Property="Background" Value="{DynamicResource Brush.Separator}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border Background="{TemplateBinding Background}" CornerRadius="3"
                                SnapsToDevicePixels="True" UseLayoutRounding="True"
                                ClipToBounds="True">
                            <Grid>
                                <Border x:Name="PART_Track"/>
                                <Border x:Name="PART_Indicator" HorizontalAlignment="Left"
                                        Background="{TemplateBinding Foreground}" CornerRadius="3"
                                        SnapsToDevicePixels="True" UseLayoutRounding="True"/>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
            Sablier d'attente. Posé PAR-DESSUS la pastille du fournisseur, avec un fond opaque de
            même taille : il la couvre entièrement, ce qui évite un convertisseur booléen inversé
            pour masquer celle du dessous.

            Le RotateTransform vit dans le ControlTemplate et non dans un Setter de Style : une
            valeur de Setter est une instance UNIQUE partagée par tous les éléments qui utilisent le
            style, et l'animer lève une exception si elle est gelée. Un template est instancié par
            élément.

            L'animation ne tourne que pendant l'attente (EnterActions / ExitActions), pas en
            permanence sur un élément replié.
        -->
        <Style x:Key="LoadingSpinner" TargetType="ContentControl">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Setter Property="ToolTip" Value="Lecture en cours…"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContentControl">
                        <Border Width="16" Height="16" CornerRadius="8" Background="{DynamicResource Brush.BorderSoft}"
                                SnapsToDevicePixels="True" UseLayoutRounding="True">
                            <TextBlock x:Name="Glyph" Text="↻" Foreground="{DynamicResource Brush.GlyphMuted}"
                                       FontFamily="Segoe UI Symbol, Segoe UI"
                                       FontSize="11" FontWeight="Bold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       RenderTransformOrigin="0.5,0.5">
                                <TextBlock.RenderTransform>
                                    <RotateTransform/>
                                </TextBlock.RenderTransform>
                            </TextBlock>
                        </Border>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard Name="Spin">
                                        <Storyboard RepeatBehavior="Forever">
                                            <DoubleAnimation Storyboard.TargetName="Glyph"
                                                             Storyboard.TargetProperty="RenderTransform.Angle"
                                                             From="0" To="360" Duration="0:0:1.1"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                                <DataTrigger.ExitActions>
                                    <StopStoryboard BeginStoryboardName="Spin"/>
                                </DataTrigger.ExitActions>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsLoading}" Value="True">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Un onglet de fournisseur. Bouton plat : cliquable, sans chrome de bouton. -->
        <Style x:Key="ProviderTab" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{Binding Background, Converter={StaticResource StringToBrushConverter}}"
                                BorderBrush="{Binding BorderBrush, Converter={StaticResource StringToBrushConverter}}"
                                BorderThickness="1" CornerRadius="8"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True" UseLayoutRounding="True">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Brush.BorderHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
            Une jauge sur UNE seule ligne : « 26 % session utilisée » · barre · « ↻ 18h11 ».
            Le nombre et la barre montrent tous deux le CONSOMMÉ, comme la page
            claude.ai/settings/usage (« 26 % utilisés ») et comme /usage dans Claude Code : deux
            références pour la même donnée ne doivent pas se contredire.
        -->
        <DataTemplate x:Key="GaugeTemplate">
            <!-- Quota inconnu → la jauge entière disparaît, pas seulement la barre. Le pourcentage
                 vaudrait 0 par défaut et afficherait « 0 % session », soit une mesure affirmée là
                 où il n'y a pas de donnée. Un vide ne prétend rien. Cas courant au démarrage, avant
                 que la première lecture ait abouti. -->
            <Grid Visibility="{Binding HasQuota, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" VerticalAlignment="Center"
                           FontSize="11" Foreground="{DynamicResource Brush.TextMuted}"
                           ToolTip="{Binding Tooltip}"
                           ToolTipService.IsEnabled="{Binding Tooltip.Length}">
                    <Run Text="{Binding UsedPct, Mode=OneWay}"
                         FontSize="13" FontWeight="Bold"
                         Foreground="{Binding Color, Converter={StaticResource StringToBrushConverter}}"/><Run
                         Text="%" FontSize="13" FontWeight="Bold"
                         Foreground="{Binding Color, Converter={StaticResource StringToBrushConverter}}"/><Run
                         Text=" "/><Run Text="{Binding Label, Mode=OneWay}"/>
                </TextBlock>

                <ProgressBar Grid.Column="1" Margin="8,0,0,0"
                             Style="{StaticResource GaugeBar}"
                             Value="{Binding UsedPct, Mode=OneWay}"
                             Foreground="{Binding Color, Converter={StaticResource StringToBrushConverter}}"/>

                <TextBlock Grid.Column="2" VerticalAlignment="Center" Margin="8,0,0,0"
                           FontSize="11" Foreground="{DynamicResource Brush.TextMuted}"
                           Text="{Binding Reset, StringFormat=↻ {0}}"
                           ToolTip="{Binding ResetTooltip}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Reset}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Border TextElement.Foreground="{DynamicResource Brush.Text}" Background="{DynamicResource Brush.SurfaceCard}" BorderBrush="{DynamicResource Brush.BorderSoft}" BorderThickness="1" CornerRadius="12"
            Padding="12,8"
            SnapsToDevicePixels="True" UseLayoutRounding="True">
        <!-- Centré : la hauteur du bandeau est imposée (celle d'une tuile), le contenu est un peu
             plus court — sans centrage, le mou tomberait tout entier en bas. -->
        <StackPanel VerticalAlignment="Center">

            <!-- Une seule ligne : sélecteur de fournisseur, puis les deux jauges. -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Onglets, seulement s'il y a un choix à faire -->
                <ItemsControl Grid.Column="0" ItemsSource="{Binding Tabs}"
                              VerticalAlignment="Center"
                              Visibility="{Binding ShowTabs, Converter={StaticResource BoolToVisibilityConverter}}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource ProviderTab}" Click="Tab_Click"
                                    ToolTip="{Binding Name}">
                                <StackPanel Orientation="Horizontal">
                                    <Grid>
                                        <Border Width="16" Height="16" CornerRadius="8"
                                                Background="{Binding Accent, Converter={StaticResource StringToBrushConverter}}"
                                                SnapsToDevicePixels="True" UseLayoutRounding="True">
                                            <!-- Pile de repli : Segoe UI ne contient ni ✳ ni ⊕, qui
                                                 tombent en tofu sans Segoe UI Symbol. -->
                                            <TextBlock Text="{Binding Glyph}" Foreground="White"
                                                       FontFamily="Segoe UI Symbol, Segoe UI Emoji, Segoe UI"
                                                       FontSize="9" FontWeight="Bold"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ContentControl Style="{StaticResource LoadingSpinner}"/>
                                    </Grid>
                                    <TextBlock Text="{Binding Name}" Margin="6,0,0,0" FontSize="12"
                                               Foreground="{DynamicResource Brush.TextSecondary}" VerticalAlignment="Center"
                                               FontWeight="{Binding Weight}"/>
                                    <Border Style="{StaticResource DemoBadge}"
                                            Visibility="{Binding IsDemo, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <TextBlock Text="{loc:T Usage_Demo}" FontSize="9" Foreground="{DynamicResource Brush.Demo}"/>
                                    </Border>
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Fournisseur unique : libellé statique, pas un onglet qui ne mène nulle part -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ShowTabs}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <Grid>
                        <Border Width="16" Height="16" CornerRadius="8"
                                Background="{Binding SoloAccent, Converter={StaticResource StringToBrushConverter}}"
                                SnapsToDevicePixels="True" UseLayoutRounding="True">
                            <TextBlock Text="{Binding SoloGlyph}" Foreground="White"
                                       FontFamily="Segoe UI Symbol, Segoe UI Emoji, Segoe UI"
                                       FontSize="9" FontWeight="Bold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ContentControl Style="{StaticResource LoadingSpinner}"/>
                    </Grid>
                    <TextBlock Text="{Binding SoloName}" Margin="6,0,0,0" FontSize="12"
                               FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextSecondary}" VerticalAlignment="Center"/>
                    <Border Style="{StaticResource DemoBadge}"
                            Visibility="{Binding IsDemo, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="{loc:T Usage_Demo}" FontSize="9" Foreground="{DynamicResource Brush.Demo}"/>
                    </Border>
                </StackPanel>

                <ContentControl Grid.Column="1" Content="{Binding SessionGauge}"
                                ContentTemplate="{StaticResource GaugeTemplate}"
                                Margin="16,0,0,0"/>
                <ContentControl Grid.Column="2" Content="{Binding WeekGauge}"
                                ContentTemplate="{StaticResource GaugeTemplate}"
                                Margin="16,0,0,0"/>

                <!-- Les deux jauges masquées laissent un vide, et un vide ne dit pas ce qu'il se
                     passe : le quota de Claude peut être refusé (429, jeton expiré, endpoint qui
                     change de forme) et la seule trace vivait dans le fichier de log. La notice
                     prend leur place, avec la cause technique au survol. Vide pour les fournisseurs
                     qui n'ont pas de quota du tout : là, l'absence est normale. -->
                <TextBlock Grid.Column="1" Grid.ColumnSpan="2" Margin="16,0,0,0"
                           VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource Brush.TextMuted}"
                           FontFamily="Segoe UI Symbol, Segoe UI Emoji, Segoe UI"
                           TextTrimming="CharacterEllipsis"
                           Text="{Binding QuotaNotice, StringFormat=⚠ {0}}"
                           ToolTip="{Binding QuotaNoticeTooltip}"
                           Visibility="{Binding HasQuotaNotice, Converter={StaticResource BoolToVisibilityConverter}}"/>

                <!-- La pastille du fournisseur, à droite de la ligne haute, ouvre sa page officielle.
                     Masquée quand le fournisseur n'a pas de page. -->
                <Button Grid.Column="3" Click="OpenUsagePage_Click"
                        AutomationProperties.Name="{Binding UsageUrlTooltip}"
                        VerticalAlignment="Center" Margin="12,0,0,0" Cursor="Hand"
                        Visibility="{Binding HasUsageUrl, Converter={StaticResource BoolToVisibilityConverter}}"
                        ToolTip="{Binding UsageUrlTooltip}">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Chrome" Background="Transparent" CornerRadius="6"
                                    Padding="4" SnapsToDevicePixels="True" UseLayoutRounding="True">
                                <ContentPresenter/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Brush.SurfaceHover}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <!-- La pastille seule. L'affordance repose sur le curseur main, le fond au
                         survol et l'infobulle qui nomme l'URL. -->
                    <Border Width="20" Height="20" CornerRadius="10"
                            Background="{Binding SoloAccent, Converter={StaticResource StringToBrushConverter}}"
                            SnapsToDevicePixels="True" UseLayoutRounding="True">
                        <TextBlock Text="{Binding SoloGlyph}" Foreground="White"
                                   FontFamily="Segoe UI Symbol, Segoe UI Emoji, Segoe UI"
                                   FontSize="11" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Button>
            </Grid>

            <!-- Métriques : une colonne par mesure, filet de séparation au-dessus -->
            <Border BorderBrush="{DynamicResource Brush.SurfaceHover}" BorderThickness="0,1,0,0" Margin="0,8,0,0" Padding="0,6,0,0">
                <ItemsControl ItemsSource="{Binding Metrics}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{DynamicResource Brush.SurfaceMuted}" BorderThickness="1,0,0,0" Padding="10,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="{Binding Label}" FontSize="10"
                                               Foreground="{DynamicResource Brush.TextMetricLabel}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Value}" FontSize="13" FontWeight="Bold"
                                               Foreground="{DynamicResource Brush.TextStrong}" TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding Tooltip}"
                                               ToolTipService.IsEnabled="{Binding Tooltip.Length}"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
        </StackPanel>
    </Border>
</UserControl>
