<UserControl x:Class="DockPad.Views.UsagePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI">

    <UserControl.Resources>

        <!-- Badge « démo » : les chiffres inventés ne doivent pas se lire comme réels. -->
        <Style x:Key="DemoBadge" TargetType="Border">
            <Setter Property="Background" Value="#F3F0FF"/>
            <Setter Property="BorderBrush" Value="#DDD6FE"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="4,0"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="UseLayoutRounding" Value="True"/>
        </Style>

        <!-- Barre de jauge : un ProgressBar retemplaté, la proportionnalité est native. -->
        <Style x:Key="GaugeBar" TargetType="ProgressBar">
            <Setter Property="Height" Value="6"/>
            <Setter Property="MinWidth" Value="36"/>
            <Setter Property="Minimum" Value="0"/>
            <Setter Property="Maximum" Value="100"/>
            <Setter Property="Background" Value="#EEEEEE"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border Background="{TemplateBinding Background}" CornerRadius="3"
                                SnapsToDevicePixels="True" UseLayoutRounding="True"
                                ClipToBounds="True">
                            <Grid>
                                <Border x:Name="PART_Track"/>
                                <Border x:Name="PART_Indicator" HorizontalAlignment="Left"
                                        Background="{TemplateBinding Foreground}" CornerRadius="3"
                                        SnapsToDevicePixels="True" UseLayoutRounding="True"/>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Un onglet de fournisseur. Bouton plat : cliquable, sans chrome de bouton. -->
        <Style x:Key="ProviderTab" TargetType="Button">
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{Binding Background, Converter={StaticResource StringToBrushConverter}}"
                                BorderBrush="{Binding BorderBrush, Converter={StaticResource StringToBrushConverter}}"
                                BorderThickness="1" CornerRadius="8"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True" UseLayoutRounding="True">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#BDBDBD"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
            Une jauge sur UNE seule ligne : « 26 % session utilisée » · barre · « ↻ 18h11 ».
            Le nombre et la barre montrent tous deux le CONSOMMÉ, comme la page
            claude.ai/settings/usage (« 26 % utilisés ») et comme /usage dans Claude Code : deux
            références pour la même donnée ne doivent pas se contredire.
        -->
        <DataTemplate x:Key="GaugeTemplate">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" VerticalAlignment="Center"
                           FontSize="11" Foreground="#8A8A8A"
                           ToolTip="{Binding Tooltip}"
                           ToolTipService.IsEnabled="{Binding Tooltip.Length}">
                    <Run Text="{Binding UsedPct, Mode=OneWay}"
                         FontSize="13" FontWeight="Bold"
                         Foreground="{Binding Color, Converter={StaticResource StringToBrushConverter}}"/><Run
                         Text="%" FontSize="13" FontWeight="Bold"
                         Foreground="{Binding Color, Converter={StaticResource StringToBrushConverter}}"/><Run
                         Text=" "/><Run Text="{Binding Label, Mode=OneWay}"/>
                </TextBlock>

                <Grid Grid.Column="1" Margin="8,0,0,0">
                    <ProgressBar Style="{StaticResource GaugeBar}"
                                 Value="{Binding UsedPct, Mode=OneWay}"
                                 Foreground="{Binding Color, Converter={StaticResource StringToBrushConverter}}"
                                 Visibility="{Binding HasQuota, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    <!-- Pas de barre vide quand le quota est inconnu : elle se lirait
                         « rien consommé ». -->
                    <TextBlock Text="quota inconnu" FontSize="10" Foreground="#BBBBBB"
                               VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasQuota}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>

                <TextBlock Grid.Column="2" VerticalAlignment="Center" Margin="8,0,0,0"
                           FontSize="11" Foreground="#8A8A8A"
                           Text="{Binding Reset, StringFormat=↻ {0}}"
                           ToolTip="{Binding Reset, StringFormat=Remise à zéro à {0}}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Reset}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Border Background="White" BorderBrush="#E4E4E4" BorderThickness="1" CornerRadius="12"
            Padding="12,8"
            SnapsToDevicePixels="True" UseLayoutRounding="True"
            Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisibilityConverter}}">
        <!-- Centré : la hauteur du bandeau est imposée (celle d'une tuile), le contenu est un peu
             plus court — sans centrage, le mou tomberait tout entier en bas. -->
        <StackPanel VerticalAlignment="Center">

            <!-- Une seule ligne : sélecteur de fournisseur, puis les deux jauges. -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Onglets, seulement s'il y a un choix à faire -->
                <ItemsControl Grid.Column="0" ItemsSource="{Binding Tabs}"
                              VerticalAlignment="Center"
                              Visibility="{Binding ShowTabs, Converter={StaticResource BoolToVisibilityConverter}}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource ProviderTab}" Click="Tab_Click"
                                    ToolTip="{Binding Name}">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="16" Height="16" CornerRadius="8"
                                            Background="{Binding Accent, Converter={StaticResource StringToBrushConverter}}"
                                            SnapsToDevicePixels="True" UseLayoutRounding="True">
                                        <!-- Pile de repli : Segoe UI ne contient ni ✳ ni ⊕, qui
                                             tombent en tofu sans Segoe UI Symbol. -->
                                        <TextBlock Text="{Binding Glyph}" Foreground="White"
                                                   FontFamily="Segoe UI Symbol, Segoe UI Emoji, Segoe UI"
                                                   FontSize="9" FontWeight="Bold"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="{Binding Name}" Margin="6,0,0,0" FontSize="12"
                                               Foreground="#333" VerticalAlignment="Center"
                                               FontWeight="{Binding Weight}"/>
                                    <Border Style="{StaticResource DemoBadge}"
                                            Visibility="{Binding IsDemo, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <TextBlock Text="démo" FontSize="9" Foreground="#7C3AED"/>
                                    </Border>
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Fournisseur unique : libellé statique, pas un onglet qui ne mène nulle part -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ShowTabs}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <Border Width="16" Height="16" CornerRadius="8"
                            Background="{Binding SoloAccent, Converter={StaticResource StringToBrushConverter}}"
                            SnapsToDevicePixels="True" UseLayoutRounding="True">
                        <TextBlock Text="{Binding SoloGlyph}" Foreground="White"
                                   FontFamily="Segoe UI Symbol, Segoe UI Emoji, Segoe UI"
                                   FontSize="9" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="{Binding SoloName}" Margin="6,0,0,0" FontSize="12"
                               FontWeight="SemiBold" Foreground="#333" VerticalAlignment="Center"/>
                    <Border Style="{StaticResource DemoBadge}"
                            Visibility="{Binding IsDemo, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="démo" FontSize="9" Foreground="#7C3AED"/>
                    </Border>
                </StackPanel>

                <ContentControl Grid.Column="1" Content="{Binding SessionGauge}"
                                ContentTemplate="{StaticResource GaugeTemplate}"
                                Margin="16,0,0,0"/>
                <ContentControl Grid.Column="2" Content="{Binding WeekGauge}"
                                ContentTemplate="{StaticResource GaugeTemplate}"
                                Margin="16,0,0,0"/>
            </Grid>

            <!-- Métriques : une colonne par mesure, filet de séparation au-dessus, et le lien vers
                 la page officielle du fournisseur à droite. Le lien est hors de l'UniformGrid, sinon
                 il consommerait une colonne de mesure. -->
            <Border BorderBrush="#F0F0F0" BorderThickness="0,1,0,0" Margin="0,8,0,0" Padding="0,6,0,0">
              <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ItemsControl Grid.Column="0" ItemsSource="{Binding Metrics}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="#ECECEC" BorderThickness="1,0,0,0" Padding="10,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="{Binding Label}" FontSize="10"
                                               Foreground="#A5A5A5" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Value}" FontSize="13" FontWeight="Bold"
                                               Foreground="#222" TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding Tooltip}"
                                               ToolTipService.IsEnabled="{Binding Tooltip.Length}"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Button Grid.Column="1" Click="OpenUsagePage_Click"
                        VerticalAlignment="Center" Margin="8,0,0,0"
                        Cursor="Hand" Background="Transparent" BorderThickness="0"
                        Visibility="{Binding HasUsageUrl, Converter={StaticResource BoolToVisibilityConverter}}"
                        ToolTip="Ouvrir la page de consommation du fournisseur">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Chrome" Background="Transparent" CornerRadius="6"
                                    Padding="6,4"
                                    SnapsToDevicePixels="True" UseLayoutRounding="True">
                                <ContentPresenter/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Chrome" Property="Background" Value="#F3F3F3"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <TextBlock Text="↗" FontSize="13" Foreground="#8A8A8A"
                               FontFamily="Segoe UI Symbol, Segoe UI"/>
                </Button>
              </Grid>
            </Border>
        </StackPanel>
    </Border>
</UserControl>
