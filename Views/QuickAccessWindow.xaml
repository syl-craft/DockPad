<Window x:Class="DockPad.QuickAccessWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DockPad"
        Icon="pack://application:,,,/app.ico"
        Width="850" Height="600"
        MinWidth="850" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip"
        Background="#F3F3F3"
        FontFamily="Segoe UI"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Window.Resources>
        <Style x:Key="TileButton" TargetType="Button">
            <Setter Property="Width" Value="108"/>
            <Setter Property="Height" Value="90"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                ClipToBounds="True">
                            <Grid>
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,5,0"/>
                                <!-- Bande colorée selon le type -->
                                <Border Width="4" HorizontalAlignment="Right" CornerRadius="0,6,6,0"
                                        Background="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"/>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="EmptyTileButton" TargetType="Button" BasedOn="{StaticResource TileButton}">
            <Setter Property="Background" Value="#FAFAFA"/>
            <Setter Property="BorderBrush" Value="#EBEBEB"/>
            <Setter Property="Opacity" Value="0.4"/>
        </Style>

        <Style x:Key="PageButton" TargetType="Button">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Margin" Value="3,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#555555"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#EEF6FC"/>
                                <Setter Property="BorderBrush" Value="#0078D4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PageButtonActive" TargetType="Button" BasedOn="{StaticResource PageButton}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="#0078D4"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Foreground" Value="#0078D4"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Border Grid.Row="0" Background="White" Padding="12,8"
                BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
            <Grid>
                <!-- Actions principales (gauche) -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <Button Content="☰" Style="{StaticResource SecondaryButton}"
                            Padding="10,6" ToolTip="Menu" Click="Menu_Click">
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Menu contextuel" IsEnabled="False" FontWeight="SemiBold"/>
                                <MenuItem Header="Gestion" Click="OpenContextMenuManager_Click">
                                    <MenuItem.Icon><TextBlock Text="☰"/></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Prédéfinis" Click="Presets_Click">
                                    <MenuItem.Icon><TextBlock Text="📋"/></MenuItem.Icon>
                                </MenuItem>
                                <Separator/>
                                <MenuItem Header="Paramètres" IsEnabled="False" FontWeight="SemiBold"/>
                                <MenuItem Header="Options" Click="Settings_Click">
                                    <MenuItem.Icon><TextBlock Text="⚙"/></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Actualiser" Click="Refresh_Click">
                                    <MenuItem.Icon><TextBlock Text="↺"/></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Modifier la configuration" Click="EditConfig_Click">
                                    <MenuItem.Icon><TextBlock Text="✎"/></MenuItem.Icon>
                                </MenuItem>
                                <Separator/>
                                <MenuItem Header="Quitter l'application" Click="Quit_Click">
                                    <MenuItem.Icon><TextBlock Text="✕"/></MenuItem.Icon>
                                </MenuItem>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                </StackPanel>

                <!-- Actions raccourcis (droite) -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
<Button Style="{StaticResource SecondaryButton}"
                            Padding="10,6" Margin="0,0,8,0" ToolTip="Actualiser"
                            Click="Refresh_Click">
                        <Path Data="M12,4V1L8,5l4,4V6c3.31,0,6,2.69,6,6s-2.69,6-6,6-6-2.69-6-6H4c0,4.42,3.58,8,8,8s8-3.58,8-8S16.42,4,12,4z"
                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              Width="12" Height="12" Stretch="Uniform"/>
                    </Button>
                    <Button Content="✕" Style="{StaticResource SecondaryButton}"
                            Padding="10,6" Margin="0,0,8,0" ToolTip="Quitter l'application"
                            Click="Quit_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Grille de raccourcis 4 × 6 -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid x:Name="ShortcutsGrid"
                  HorizontalAlignment="Center" VerticalAlignment="Center"
                  Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
            </Grid>
        </ScrollViewer>

        <!-- Barre de pagination -->
        <Border Grid.Row="2" Background="White" Padding="12,10"
                BorderBrush="#E0E0E0" BorderThickness="0,1,0,0">
            <StackPanel x:Name="PaginationBar" Orientation="Horizontal" HorizontalAlignment="Center"/>
        </Border>
    </Grid>
</Window>
