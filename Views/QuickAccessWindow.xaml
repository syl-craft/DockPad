<Window x:Class="DockPad.QuickAccessWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:DockPad.Views"
        Title="DockPad"
        Icon="pack://application:,,,/app.ico"
        Width="850" SizeToContent="Height"
        MaxHeight="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Height}"
        MinWidth="850"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip"
        Background="#F3F3F3"
        FontFamily="Segoe UI"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Window.Resources>
        <Style x:Key="TileButton" TargetType="Button">
            <Setter Property="Width" Value="108"/>
            <Setter Property="Height" Value="90"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                ClipToBounds="True"
                                SnapsToDevicePixels="True"
                                UseLayoutRounding="True">
                            <Grid>
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,5,0"/>
                                <!-- Bande colorée selon le type -->
                                <Border Width="4" HorizontalAlignment="Right" CornerRadius="0,6,6,0"
                                        Background="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                        SnapsToDevicePixels="True" UseLayoutRounding="True"/>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="EmptyTileButton" TargetType="Button" BasedOn="{StaticResource TileButton}">
            <Setter Property="Background" Value="#FAFAFA"/>
            <Setter Property="BorderBrush" Value="#EBEBEB"/>
            <Setter Property="Opacity" Value="0.4"/>
        </Style>

        <Style x:Key="PageButton" TargetType="Button">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Margin" Value="3,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#555555"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#EEF6FC"/>
                                <Setter Property="BorderBrush" Value="#0078D4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PageButtonActive" TargetType="Button" BasedOn="{StaticResource PageButton}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="#0078D4"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Foreground" Value="#0078D4"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="SearchTextBox" TargetType="TextBox">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#1A1A1A"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="#CCCCCC" BorderThickness="1"
                                CornerRadius="4"
                                SnapsToDevicePixels="True"
                                UseLayoutRounding="True">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <!--
            La ligne de la grille est Auto et la fenêtre prend la hauteur de son contenu
            (SizeToContent), clampée à la zone de travail : c'est le patron documenté pour un contenu
            statique, et la grille l'est (4 × 6, tuiles de taille fixe).

            Une hauteur fixe ne marche pas ici. À 630 px, la ligne de la grille recevait 432 px pour
            425 nécessaires — sept pixels de marge. Une pagination un peu plus haute (boutons de page
            avec icône) suffisait à passer dessous et à faire apparaître une barre de défilement.
        -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Border Grid.Row="0" Background="White" Padding="12,8"
                BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Menu (gauche) -->
                <Button Grid.Column="0" Content="☰" Style="{StaticResource SecondaryButton}"
                        Padding="10,6" ToolTip="Menu" Click="Menu_Click">
                    <Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Menu contextuel" IsEnabled="False" FontWeight="SemiBold"/>
                            <MenuItem Header="Gestion" Click="OpenContextMenuManager_Click">
                                <MenuItem.Icon><TextBlock Text="☰"/></MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Raccourcis prédéfinis" Click="Presets_Click">
                                <MenuItem.Icon><TextBlock Text="📋"/></MenuItem.Icon>
                            </MenuItem>
                            <Separator/>
                            <MenuItem Header="Paramètres" IsEnabled="False" FontWeight="SemiBold"/>
                            <MenuItem Header="Options" Click="Settings_Click">
                                <MenuItem.Icon><TextBlock Text="⚙"/></MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Navigateurs" Click="Browsers_Click">
                                <MenuItem.Icon><TextBlock Text="🌐"/></MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Serveur MCP" Click="McpConfig_Click">
                                <MenuItem.Icon><TextBlock Text="🔌"/></MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Usage IA" Click="UsageConfig_Click">
                                <MenuItem.Icon><TextBlock Text="📊"/></MenuItem.Icon>
                            </MenuItem>
                            <Separator/>
                            <MenuItem Header="Configuration" IsEnabled="False" FontWeight="SemiBold"/>
                            <MenuItem Header="Actualiser" Click="Refresh_Click">
                                <MenuItem.Icon><TextBlock Text="↺"/></MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Modifier" Click="EditConfig_Click">
                                <MenuItem.Icon><TextBlock Text="✎"/></MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Sauvegarder" Click="BackupConfig_Click">
                                <MenuItem.Icon><TextBlock Text="💾"/></MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Voir le dossier" Click="OpenConfigFolder_Click">
                                <MenuItem.Icon><TextBlock Text="📁"/></MenuItem.Icon>
                            </MenuItem>
                            <Separator/>
                            <MenuItem Header="Quitter l'application" Click="Quit_Click">
                                <MenuItem.Icon><TextBlock Text="✕"/></MenuItem.Icon>
                            </MenuItem>
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>

                <!-- Barre de recherche (centre) -->
                <Grid Grid.Column="1" Margin="150,0" VerticalAlignment="Stretch" Background="AliceBlue">
                    <TextBox x:Name="SearchBox"
                             Style="{StaticResource SearchTextBox}"
                             TextChanged="SearchBox_TextChanged"
                             PreviewKeyDown="SearchBox_PreviewKeyDown"/>
                    <Popup x:Name="SearchPopup"
                           PlacementTarget="{Binding ElementName=SearchBox}"
                           Placement="Bottom"
                           StaysOpen="True"
                           AllowsTransparency="True">
                        <Border MinWidth="{Binding ActualWidth, ElementName=SearchBox}"
                                Background="White"
                                BorderBrush="#CCCCCC" BorderThickness="1"
                                CornerRadius="0,0,4,4"
                                SnapsToDevicePixels="True" UseLayoutRounding="True">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="8" Opacity="0.15" ShadowDepth="3" Direction="270"/>
                            </Border.Effect>
                            <ListBox x:Name="SearchResults"
                                     MaxHeight="280" BorderThickness="0"
                                     Background="Transparent"
                                     PreviewKeyDown="SearchResults_PreviewKeyDown"
                                     MouseLeftButtonUp="SearchResults_MouseLeftButtonUp">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Padding" Value="6,4"/>
                                        <Setter Property="Cursor" Value="Hand"/>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="24" Height="24" Margin="0,0,8,0">
                                                <Image Source="{Binding Icon}" Stretch="Uniform"/>
                                            </Border>
                                            <TextBlock Text="{Binding Entry.Name}"
                                                       VerticalAlignment="Center"
                                                       MinWidth="120" MaxWidth="280"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <Border CornerRadius="3" Padding="6,2" Margin="10,0,0,0"
                                                    VerticalAlignment="Center"
                                                    Background="{Binding TypeBrush}"
                                                    SnapsToDevicePixels="True" UseLayoutRounding="True">
                                                <TextBlock Text="{Binding TypeLabel}"
                                                           FontSize="10" Foreground="#444"
                                                           VerticalAlignment="Center"/>
                                            </Border>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>
                    </Popup>
                </Grid>

                <!-- Boutons droite -->
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <!-- Verrou du déplacement des tuiles. Le clic sur une tuile lance son action, et
                         le même geste manqué de quelques pixels la déplaçait : la réorganisation
                         devient un mode qu'on demande. Glyphe, infobulle et style sont posés par le
                         code-behind depuis TileLockState — l'état par défaut est le verrou. -->
                    <Button x:Name="TileLockButton" Content="🔒"
                            Style="{StaticResource SecondaryButton}"
                            FontFamily="Segoe UI Symbol, Segoe UI Emoji, Segoe UI"
                            Padding="10,6" Margin="0,0,8,0" MinWidth="40"
                            ToolTip="Déverrouiller le déplacement des tuiles"
                            Click="ToggleTileLock_Click"/>
                    <Button Content="─" Style="{StaticResource SecondaryButton}"
                            Padding="10,6" Margin="0,0,8,0" ToolTip="Réduire"
                            Click="Minimize_Click"/>
                    <Button Content="⬇" Style="{StaticResource SecondaryButton}"
                            Padding="10,6" Margin="0,0,8,0" ToolTip="Masquer dans la barre système"
                            Click="HideToSystray_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Grille de raccourcis 4 × 6 -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <!-- Marge basse à 5 : ajoutée aux 5 px de marge d'une tuile, l'écart entre la dernière
                 rangée et le bandeau vaut 10 px, soit le pas entre deux tuiles. Avec une ligne Auto
                 il n'y a plus de mou, donc l'écart est déterminé sans avoir à ancrer la grille. -->
            <Grid x:Name="ShortcutsGrid"
                  HorizontalAlignment="Center" VerticalAlignment="Center"
                  Margin="20,20,20,5">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
            </Grid>
        </ScrollViewer>

        <!-- Bandeau Usage IA. Masqué, il ne prend aucune place (Collapsed, pas Hidden).
             Largeur alignée sur la grille de tuiles, posée une fois par le code au premier
             LayoutUpdated : ni marges fixes, qui laisseraient le bandeau dépasser dès qu'on élargit
             la fenêtre, ni binding sur ActualWidth, qui fait boucler la mise en page. -->
        <views:UsagePanel x:Name="UsageBanner" Grid.Row="2"
                          HorizontalAlignment="Center" Margin="0,0,0,10"/>

        <!-- Barre de pagination -->
        <Border Grid.Row="3" Background="White" Padding="12,10"
                BorderBrush="#E0E0E0" BorderThickness="0,1,0,0">
            <Grid>
                <StackPanel x:Name="PaginationBar" Orientation="Horizontal" HorizontalAlignment="Center"/>
                <TextBlock x:Name="TxtVersion" HorizontalAlignment="Left" VerticalAlignment="Center"
                           FontFamily="Consolas" FontSize="11" Foreground="#AAAAAA"/>
                <Border HorizontalAlignment="Right" VerticalAlignment="Center"
                        Background="#F3F3F3" BorderBrush="#E0E0E0" BorderThickness="1"
                        CornerRadius="4" Padding="8,3"
                        SnapsToDevicePixels="True" UseLayoutRounding="True">
                    <TextBlock x:Name="TxtHotkey" FontFamily="Consolas" FontSize="11"
                               Foreground="#666" ToolTip="Raccourci pour afficher DockPad"/>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
