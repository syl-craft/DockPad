<Window x:Class="DockPad.QuickAccessWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:DockPad.Services.Localization"
        xmlns:views="clr-namespace:DockPad.Views"
        Title="DockPad"
        Icon="pack://application:,,,/app.ico"
        Width="850" SizeToContent="Height"
        MaxHeight="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Height}"
        MinWidth="850"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource Brush.Surface}"
        FontFamily="Segoe UI"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Window.Resources>
        <Style x:Key="TileButton" TargetType="Button">
            <Setter Property="Width" Value="108"/>
            <Setter Property="Height" Value="90"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="{DynamicResource Brush.SurfaceCard}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                ClipToBounds="True"
                                SnapsToDevicePixels="True"
                                UseLayoutRounding="True">
                            <Grid>
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,5,0"/>
                                <!-- Bande colorée selon le type -->
                                <Border Width="4" HorizontalAlignment="Right" CornerRadius="0,6,6,0"
                                        Background="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                        SnapsToDevicePixels="True" UseLayoutRounding="True"/>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="EmptyTileButton" TargetType="Button" BasedOn="{StaticResource TileButton}">
            <Setter Property="Background" Value="{DynamicResource Brush.SurfaceAlt}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderFaint}"/>
            <Setter Property="Opacity" Value="0.4"/>
        </Style>

        <!-- Gabarit d'une tuile occupee. Les gestionnaires d'evenements sont declares ici et se
             resolvent dans le code-behind de la fenetre : le glisser-deposer et le survol ont besoin
             de leurs arguments d'evenement, une commande ne les porterait pas.
             Le menu contextuel est construit a l'ouverture (ContextMenuOpening) et non a la
             construction : il depend des pages existantes et, pour un dossier, d'une lecture du
             registre — on ne la faisait jusqu'ici pour chaque tuile a chaque peuplement. -->
        <DataTemplate x:Key="TileTemplate">
            <Button Style="{StaticResource TileButton}"
                    ToolTip="{Binding Tooltip}"
                    Tag="{Binding Band}"
                    AutomationProperties.Name="{Binding Name}"
                    Click="Tile_Click"
                    MouseEnter="TileHover_Enter" MouseLeave="TileHover_Leave"
                    PreviewMouseLeftButtonDown="TileDrag_MouseDown" PreviewMouseMove="TileDrag_MouseMove"
                    AllowDrop="True" DragOver="TileDrop_DragOver" DragLeave="TileDrop_DragLeave"
                    Drop="TileDrop_Drop"
                    ContextMenuOpening="Tile_ContextMenuOpening">
                <!-- Un menu vide, rempli a l'ouverture. Il doit exister des la construction : WPF ne
                     leve ContextMenuOpening que sur un element qui porte deja un menu, et le menu
                     affiche est celui capture avant le gestionnaire. En assigner un neuf depuis le
                     gestionnaire ne montrerait rien. -->
                <Button.ContextMenu>
                    <ContextMenu/>
                </Button.ContextMenu>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Image Source="{Binding Icon}" Width="36" Height="36" Stretch="Uniform"
                           Margin="0,0,0,6"/>
                    <TextBlock Text="{Binding Name}" TextAlignment="Center" TextWrapping="Wrap"
                               MaxWidth="94" FontSize="11"/>
                </StackPanel>
            </Button>
        </DataTemplate>

        <!-- Case libre : le « + » grise, et le depot depuis l'Explorateur, qui doit fonctionner
             exactement comme sur une tuile occupee. -->
        <DataTemplate x:Key="EmptyTileTemplate">
            <Button Style="{StaticResource EmptyTileButton}"
                    AutomationProperties.Name="{loc:T Quick_Tile_Add}"
                    AllowDrop="True" DragOver="TileDrop_DragOver" DragLeave="TileDrop_DragLeave"
                    Drop="TileDrop_Drop"
                    ContextMenuOpening="EmptyTile_ContextMenuOpening">
                <Button.ContextMenu>
                    <ContextMenu/>
                </Button.ContextMenu>
                <TextBlock Text="+" FontSize="22" Foreground="{DynamicResource Brush.BorderStrong}"/>
            </Button>
        </DataTemplate>

        <views:TileTemplateSelector x:Key="TileSelector"
                                    Tile="{StaticResource TileTemplate}"
                                    Empty="{StaticResource EmptyTileTemplate}"/>

        <Style x:Key="PageButton" TargetType="Button">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Margin" Value="3,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderStrong}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextLabel}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource Brush.AccentSoft}"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PageButtonActive" TargetType="Button" BasedOn="{StaticResource PageButton}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="SearchTextBox" TargetType="TextBox">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="Background" Value="{DynamicResource Brush.SurfaceCard}"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{DynamicResource Brush.BorderStrong}" BorderThickness="1"
                                CornerRadius="4"
                                SnapsToDevicePixels="True"
                                UseLayoutRounding="True">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <!--
            La ligne de la grille est Auto et la fenêtre prend la hauteur de son contenu
            (SizeToContent), clampée à la zone de travail : c'est le patron documenté pour un contenu
            statique, et la grille l'est (4 × 6, tuiles de taille fixe).

            Une hauteur fixe ne marche pas ici. À 630 px, la ligne de la grille recevait 432 px pour
            425 nécessaires — sept pixels de marge. Une pagination un peu plus haute (boutons de page
            avec icône) suffisait à passer dessous et à faire apparaître une barre de défilement.
        -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Border Grid.Row="0" Background="{DynamicResource Brush.SurfaceCard}" Padding="12,8"
                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Menu (gauche) -->
                <Button x:Name="MenuButton" Grid.Column="0" Content="☰" Style="{StaticResource SecondaryButton}"
                            AutomationProperties.Name="{loc:T Quick_Menu_Tip}"
                        Padding="10,6" ToolTip="{loc:T Quick_Menu_Tip}" Click="Menu_Click">
                    <Button.ContextMenu>
                        <!-- Un ContextMenu vit dans son propre arbre visuel : il n'herite PAS du
                             DataContext de la fenetre, et ses liaisons de commande rendaient toutes
                             null — dix entrees cliquables et sans effet, sans la moindre erreur de
                             compilation. Une liaison sur PlacementTarget ne suffit pas : celui-ci
                             reste nul tant que le menu n'est pas ouvert. Le contexte est donc pose
                             une fois pour toutes a la construction de la fenetre. -->
                        <ContextMenu>
                            <MenuItem Header="{loc:T Quick_Menu_ContextMenu}" IsEnabled="False" FontWeight="SemiBold"/>
                            <MenuItem Header="{loc:T Quick_Menu_Manage}" Command="{Binding Commands.OpenContextMenuManager}">
                                <MenuItem.Icon><TextBlock Text="☰"/></MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="{loc:T Quick_Menu_Presets}" Command="{Binding Commands.OpenPresets}">
                                <MenuItem.Icon><TextBlock Text="📋"/></MenuItem.Icon>
                            </MenuItem>
                            <Separator/>
                            <MenuItem Header="{loc:T Quick_Menu_Settings}" IsEnabled="False" FontWeight="SemiBold"/>
                            <MenuItem Header="{loc:T Quick_Menu_Options}" Command="{Binding Commands.OpenSettings}">
                                <MenuItem.Icon><TextBlock Text="⚙"/></MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="{loc:T Quick_Menu_Browsers}" Command="{Binding Commands.OpenBrowsers}">
                                <MenuItem.Icon><TextBlock Text="🌐"/></MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="{loc:T Quick_Menu_Mcp}" Command="{Binding Commands.OpenMcpConfig}">
                                <MenuItem.Icon><TextBlock Text="🔌"/></MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="{loc:T Quick_Menu_Usage}" Command="{Binding Commands.OpenUsageConfig}">
                                <MenuItem.Icon><TextBlock Text="📊"/></MenuItem.Icon>
                            </MenuItem>
                            <Separator/>
                            <MenuItem Header="{loc:T Quick_Menu_Config}" IsEnabled="False" FontWeight="SemiBold"/>
                            <MenuItem Header="{loc:T Quick_Menu_Refresh}" Command="{Binding Commands.Refresh}">
                                <MenuItem.Icon><TextBlock Text="↺"/></MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="{loc:T Quick_Menu_Edit}" Command="{Binding Commands.EditConfig}">
                                <MenuItem.Icon><TextBlock Text="✎"/></MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="{loc:T Quick_Menu_Save}" Command="{Binding Commands.BackupConfig}">
                                <MenuItem.Icon><TextBlock Text="💾"/></MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="{loc:T Quick_Menu_OpenFolder}" Command="{Binding Commands.OpenConfigFolder}">
                                <MenuItem.Icon><TextBlock Text="📁"/></MenuItem.Icon>
                            </MenuItem>
                            <Separator/>
                            <MenuItem Header="{loc:T Quick_Menu_Quit}" Command="{Binding Commands.Quit}">
                                <MenuItem.Icon><TextBlock Text="✕"/></MenuItem.Icon>
                            </MenuItem>
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>

                <!-- Barre de recherche (centre) -->
                <Grid Grid.Column="1" Margin="150,0" VerticalAlignment="Stretch" Background="AliceBlue">
                    <TextBox x:Name="SearchBox" AutomationProperties.Name="{loc:T Quick_Search}"
                             Style="{StaticResource SearchTextBox}"
                             TextChanged="SearchBox_TextChanged"
                             PreviewKeyDown="SearchBox_PreviewKeyDown"/>
                    <Popup x:Name="SearchPopup"
                           PlacementTarget="{Binding ElementName=SearchBox}"
                           Placement="Bottom"
                           StaysOpen="True"
                           AllowsTransparency="True">
                        <Border MinWidth="{Binding ActualWidth, ElementName=SearchBox}"
                                Background="{DynamicResource Brush.SurfaceCard}"
                                BorderBrush="{DynamicResource Brush.BorderStrong}" BorderThickness="1"
                                CornerRadius="0,0,4,4"
                                SnapsToDevicePixels="True" UseLayoutRounding="True">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="8" Opacity="0.15" ShadowDepth="3" Direction="270"/>
                            </Border.Effect>
                            <ListBox x:Name="SearchResults"
                                     MaxHeight="280" BorderThickness="0"
                                     Background="Transparent"
                                     PreviewKeyDown="SearchResults_PreviewKeyDown"
                                     MouseLeftButtonUp="SearchResults_MouseLeftButtonUp">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Padding" Value="6,4"/>
                                        <Setter Property="Cursor" Value="Hand"/>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="24" Height="24" Margin="0,0,8,0">
                                                <Image Source="{Binding Icon}" Stretch="Uniform"/>
                                            </Border>
                                            <TextBlock Text="{Binding Entry.Name}"
                                                       VerticalAlignment="Center"
                                                       MinWidth="120" MaxWidth="280"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <Border CornerRadius="3" Padding="6,2" Margin="10,0,0,0"
                                                    VerticalAlignment="Center"
                                                    Background="{Binding TypeBrush}"
                                                    SnapsToDevicePixels="True" UseLayoutRounding="True">
                                                <TextBlock Text="{Binding TypeLabel}"
                                                           FontSize="10" Foreground="{DynamicResource Brush.TextSmall}"
                                                           VerticalAlignment="Center"/>
                                            </Border>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>
                    </Popup>
                </Grid>

                <!-- Boutons droite -->
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <!-- Verrou du déplacement des tuiles. Le clic sur une tuile lance son action, et
                         le même geste manqué de quelques pixels la déplaçait : la réorganisation
                         devient un mode qu'on demande. Glyphe, infobulle et style sont posés par
                         ApplyTileLock depuis TileLockState — l'état par défaut est le verrou.
                         Pas de {loc:T} sur ToolTip : l'affectation en code est une valeur locale,
                         elle remplacerait la liaison des l'initialisation. -->
                    <Button x:Name="TileLockButton" Content="🔒"
                            Style="{StaticResource SecondaryButton}"
                            FontFamily="Segoe UI Symbol, Segoe UI Emoji, Segoe UI"
                            Padding="10,6" Margin="0,0,8,0" MinWidth="40"
                            Command="{Binding Commands.ToggleTileLock}"/>
                    <Button Content="─" Style="{StaticResource SecondaryButton}"
                            AutomationProperties.Name="{loc:T Quick_Minimize}"
                            Padding="10,6" Margin="0,0,8,0" ToolTip="{loc:T Quick_Minimize}"
                            Command="{Binding Commands.Minimize}"/>
                    <Button Content="⬇" Style="{StaticResource SecondaryButton}"
                            AutomationProperties.Name="{loc:T Quick_HideToTray}"
                            Padding="10,6" Margin="0,0,8,0" ToolTip="{loc:T Quick_HideToTray}"
                            Command="{Binding Commands.HideToTray}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Grille de raccourcis 4 × 6 -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <!-- Marge basse à 5 : ajoutée aux 5 px de marge d'une tuile, l'écart entre la dernière
                 rangée et le bandeau vaut 10 px, soit le pas entre deux tuiles. Avec une ligne Auto
                 il n'y a plus de mou, donc l'écart est déterminé sans avoir à ancrer la grille. -->
            <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20,20,20,5">
                <!-- Les tuiles. Les cases ont une taille fixe : un UniformGrid 4 x 6 donne la meme
                     geometrie que les rangees et colonnes Auto d'avant, sans avoir a poser
                     Grid.Row et Grid.Column sur chaque enfant depuis le code. -->
                <ItemsControl x:Name="ShortcutsGrid"
                              ItemTemplateSelector="{StaticResource TileSelector}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="4" Columns="6"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>

                <!-- L'overlay des raccourcis clavier, par-dessus et sans interception : il occupe la
                     meme grille de cases, ce qui le rend independant de la facon dont les tuiles
                     sont construites. Avant, ses elements etaient ajoutes DANS la grille des
                     tuiles. -->
                <UniformGrid x:Name="HintOverlay" Rows="4" Columns="6"
                             IsHitTestVisible="False" Visibility="Collapsed"/>
            </Grid>
        </ScrollViewer>

        <!-- Bandeau Usage IA. Masqué, il ne prend aucune place (Collapsed, pas Hidden).
             Largeur alignée sur la grille de tuiles, posée une fois par le code au premier
             LayoutUpdated : ni marges fixes, qui laisseraient le bandeau dépasser dès qu'on élargit
             la fenêtre, ni binding sur ActualWidth, qui fait boucler la mise en page. -->
        <views:UsagePanel x:Name="UsageBanner" Grid.Row="2"
                          HorizontalAlignment="Center" Margin="0,0,0,10"/>

        <!-- Barre de pagination -->
        <Border Grid.Row="3" Background="{DynamicResource Brush.SurfaceCard}" Padding="12,10"
                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0">
            <Grid>
                <StackPanel x:Name="PaginationBar" Orientation="Horizontal" HorizontalAlignment="Center"/>
                <TextBlock x:Name="TxtVersion" HorizontalAlignment="Left" VerticalAlignment="Center"
                           FontFamily="Consolas" FontSize="11" Foreground="{DynamicResource Brush.TextDisabled}"/>
                <Border HorizontalAlignment="Right" VerticalAlignment="Center"
                        Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                        CornerRadius="4" Padding="8,3"
                        SnapsToDevicePixels="True" UseLayoutRounding="True">
                    <TextBlock x:Name="TxtHotkey" FontFamily="Consolas" FontSize="11"
                               Foreground="{DynamicResource Brush.TextSubtle}" ToolTip="{loc:T Quick_HotkeyBadge_Tip}"/>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
