<UserControl x:Class="DockPad.Views.UsageHoverCardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:DockPad"
             xmlns:views="clr-namespace:DockPad.Views"
             xmlns:loc="clr-namespace:DockPad.Services.Localization;assembly=DockPad.Core"
             FontFamily="Segoe UI" FontSize="12"
             Foreground="{DynamicResource Brush.Text}"
             AutomationProperties.Name="{Binding AccessibleText}">
    <UserControl.Resources>
        <local:StringToBrushConverter x:Key="CardBrush"/>
        <BooleanToVisibilityConverter x:Key="CardVisibility"/>
        <Style TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </UserControl.Resources>
    <Border Width="236" Margin="7" Padding="12" CornerRadius="8"
            Background="{DynamicResource Brush.SurfaceCard}"
            BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
            SnapsToDevicePixels="True" UseLayoutRounding="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.18"/>
        </Border.Effect>
        <StackPanel>
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <views:ProviderIcon Width="18" Height="18" Margin="0,0,7,0" VerticalAlignment="Top"
                                    ProviderId="{Binding ProviderId}" Glyph="{Binding Glyph}"
                                    Accent="{Binding Color, Converter={StaticResource CardBrush}}"/>
                <TextBlock Grid.Column="1" Text="{Binding Header}" FontWeight="SemiBold"/>
            </Grid>
            <StackPanel Visibility="{Binding HasQuota, Converter={StaticResource CardVisibility}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding PercentText}" FontSize="28" FontWeight="Bold"
                               Foreground="{Binding Color, Converter={StaticResource CardBrush}}"/>
                    <TextBlock Grid.Column="1" Text="{Binding RemainingText}" Margin="8,0,0,4"
                               HorizontalAlignment="Right" VerticalAlignment="Bottom"
                               Foreground="{DynamicResource Brush.TextSubtle}"/>
                </Grid>
                <views:FractionBar Height="5" Radius="2.5" Margin="0,5,0,0"
                                   Fraction="{Binding Fraction}" Track="{DynamicResource Brush.SeparatorStrong}"
                                   Fill="{Binding Color, Converter={StaticResource CardBrush}}"/>
            </StackPanel>
            <StackPanel Margin="0,10,0,0" Visibility="{Binding HasReset, Converter={StaticResource CardVisibility}}">
                <TextBlock Text="{Binding ResetText}"/>
                <TextBlock Text="{Binding ResetRelative}" Foreground="{DynamicResource Brush.TextSubtle}" Margin="0,2,0,0"/>
            </StackPanel>
            <Border Padding="7" Margin="0,10,0,0" CornerRadius="4"
                    Visibility="{Binding HasNote, Converter={StaticResource CardVisibility}}"
                    SnapsToDevicePixels="True" UseLayoutRounding="True">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{DynamicResource Brush.DangerSurface}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsStale}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource Brush.SurfaceMuted}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="{Binding Note}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextWrapping" Value="Wrap"/>
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsStale}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource Brush.TextSubtle}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Border>
            <StackPanel Visibility="{Binding HasNotice, Converter={StaticResource CardVisibility}}">
                <TextBlock Text="{Binding NoticeTitle}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.WarnTextStrong}"/>
                <TextBlock Text="{Binding NoticeDetail}" Foreground="{DynamicResource Brush.TextSubtle}" Margin="0,5,0,0"/>
            </StackPanel>
            <TextBlock Text="{Binding OtherWindow}" Margin="0,10,0,0"
                       Visibility="{Binding HasOtherWindow, Converter={StaticResource CardVisibility}}"
                       Foreground="{DynamicResource Brush.TextSubtle}"/>
            <Button x:Name="PageLink" Click="OpenPage_Click" Margin="0,10,0,0" Padding="0,4"
                    Cursor="Hand" HorizontalContentAlignment="Left"
                    Visibility="{Binding HasUsageUrl, Converter={StaticResource CardVisibility}}"
                    AutomationProperties.Name="{loc:T UsageHover_OpenPage}" ToolTip="{Binding UsageUrl}">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="LinkBorder" Padding="{TemplateBinding Padding}" BorderThickness="1"
                                BorderBrush="Transparent" Background="Transparent" CornerRadius="3"
                                SnapsToDevicePixels="True" UseLayoutRounding="True">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="LinkBorder" Property="Background" Value="{DynamicResource Brush.SurfaceHover}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="LinkBorder" Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
                <TextBlock Text="{loc:T UsageHover_OpenPage}" Foreground="{DynamicResource Brush.Accent}" FontSize="11"/>
            </Button>
        </StackPanel>
    </Border>
</UserControl>
