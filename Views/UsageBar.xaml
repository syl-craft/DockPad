<UserControl x:Class="DockPad.Views.UsageBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:DockPad.Views"
             xmlns:loc="clr-namespace:DockPad.Services.Localization;assembly=DockPad.Core"
             FontFamily="Segoe UI" Focusable="False"
             AutomationProperties.Name="{loc:T UsageBar_Accessible}">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="UsageBarStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <!-- Aucun calcul ici : tout vient de UsageBarViewModel, testé sans WPF. Un gabarit par style dans
         UsageBarStyles.xaml ; le style et l'état de la barre choisissent lequel s'affiche. -->
    <Border TextElement.Foreground="{DynamicResource Brush.Text}" Background="{DynamicResource Brush.SurfaceAlt}"
            BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="6" Padding="4"
            SnapsToDevicePixels="True" UseLayoutRounding="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Tête de barre : un logo par fournisseur éligible, et le sablier d'une lecture en cours. -->
            <Grid Grid.Row="0" Height="24" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ItemsControl Grid.Column="0" ItemsSource="{Binding Logos}" Focusable="False" IsTabStop="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="1"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource BarFlatButton}" Margin="1.5,0" ToolTip="{Binding Tooltip}"
                                    AutomationProperties.Name="{Binding AccessibleName}"
                                    ContextMenuOpening="Logo_ContextMenuOpening">
                                <!-- Un menu vide, rempli à l'ouverture : WPF ne lève ContextMenuOpening que sur un
                                     élément qui en porte déjà un. -->
                                <Button.ContextMenu>
                                    <ContextMenu/>
                                </Button.ContextMenu>
                                <Grid>
                                    <Border x:Name="Tint" CornerRadius="5" Opacity="0.2" Visibility="Collapsed"
                                            Background="{Binding Color, Converter={StaticResource BarBrush}}"/>
                                    <Border x:Name="Frame" CornerRadius="5" BorderThickness="1"
                                            BorderBrush="{DynamicResource Brush.Border}"/>
                                    <views:ProviderIcon Width="14" Height="14" HorizontalAlignment="Center"
                                                        VerticalAlignment="Center" ProviderId="{Binding ProviderId}"
                                                        Glyph="{Binding Glyph}"
                                                        Accent="{Binding Color, Converter={StaticResource BarBrush}}"/>
                                    <Ellipse x:Name="AlertDot" Width="7" Height="7" Visibility="Collapsed"
                                             HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-3,-3,0"
                                             Fill="{DynamicResource Brush.Danger}" Stroke="{DynamicResource Brush.SurfaceAlt}"
                                             StrokeThickness="1.5"/>
                                </Grid>
                            </Button>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                    <Setter TargetName="Tint" Property="Visibility" Value="Visible"/>
                                    <Setter TargetName="Frame" Property="BorderBrush"
                                            Value="{Binding Color, Converter={StaticResource BarBrush}}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding HasAlertDot}" Value="True">
                                    <Setter TargetName="AlertDot" Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <ContentControl Grid.Column="1" Style="{StaticResource BarSpinner}" Width="14" Margin="3,0,0,0"
                                ToolTip="{loc:T UsageBar_Loading}"/>
            </Grid>

            <ContentControl Grid.Row="1" Content="{Binding}" Focusable="False" IsTabStop="False">
                <ContentControl.Style>
                    <Style TargetType="ContentControl">
                        <Setter Property="ContentTemplate" Value="{StaticResource BarColumnsBody}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Style}" Value="HeroStack">
                                <Setter Property="ContentTemplate" Value="{StaticResource BarHeroBody}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Style}" Value="Rings">
                                <Setter Property="ContentTemplate" Value="{StaticResource BarRingsBody}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Style}" Value="Reservoir">
                                <Setter Property="ContentTemplate" Value="{StaticResource BarReservoirBody}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding State}" Value="Empty">
                                <Setter Property="ContentTemplate" Value="{StaticResource BarEmptyBody}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ContentControl.Style>
            </ContentControl>
        </Grid>
    </Border>
</UserControl>
