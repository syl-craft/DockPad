<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:DockPad"
                    xmlns:views="clr-namespace:DockPad.Views"
                    xmlns:loc="clr-namespace:DockPad.Services.Localization;assembly=DockPad.Core">

    <!-- Les couleurs des éléments viennent du modèle de vue, en chaînes : la décision de couleur (alerte, gris
         d'ancienneté, identité du fournisseur) appartient à la logique testée sans WPF. -->
    <local:StringToBrushConverter x:Key="BarBrush"/>

    <!-- Textes de la barre. Une troncature a toujours son texte complet en infobulle, posée sur l'élément parent. -->
    <Style x:Key="BarText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        <Setter Property="TextAlignment" Value="Center"/>
        <Setter Property="FontSize" Value="10"/>
    </Style>

    <Style x:Key="BarSubtle" TargetType="TextBlock" BasedOn="{StaticResource BarText}">
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextSubtle}"/>
    </Style>

    <!-- Un texte vide ne prend aucune place. -->
    <Style x:Key="BarSubtleOrNothing" TargetType="TextBlock" BasedOn="{StaticResource BarSubtle}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource Self}}" Value="">
                <Setter Property="Visibility" Value="Collapsed"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Bouton plat et sans focus : cliquer un logo ne doit pas retirer le clavier de la zone de recherche. -->
    <Style x:Key="BarFlatButton" TargetType="Button">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="4">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Brush.SurfaceHover}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- UsageGaugeButton conserve Tab et le focus visible, mais un clic de souris garde le clavier dans la recherche. -->
    <Style x:Key="BarGaugeButton" TargetType="Button" BasedOn="{StaticResource BarFlatButton}">
        <Setter Property="Focusable" Value="True"/>
        <Setter Property="IsTabStop" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="4"
                            BorderThickness="1" BorderBrush="Transparent" Padding="1"
                            SnapsToDevicePixels="True" UseLayoutRounding="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Brush.SurfaceHover}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Brush.SurfaceMuted}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Brush.Text}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Cursor" Value="Arrow"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="BarEnlargeButton" TargetType="Button" BasedOn="{StaticResource BarGaugeButton}">
        <Setter Property="IsEnabled" Value="{Binding CanEnlarge}"/>
        <Setter Property="ToolTip" Value="{Binding EnlargeTooltip}"/>
        <Setter Property="AutomationProperties.Name" Value="{Binding EnlargeTooltip}"/>
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Focusable" Value="False"/>
                <Setter Property="IsTabStop" Value="False"/>
                <Setter Property="ToolTip" Value="{x:Null}"/>
                <Setter Property="AutomationProperties.Name" Value="{Binding Tooltip}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="BarFeaturedLogoButton" TargetType="Button" BasedOn="{StaticResource BarGaugeButton}">
        <Setter Property="IsEnabled" Value="{Binding CanOpenUsagePage}"/>
        <Setter Property="ToolTip" Value="{loc:T UsageBar_OpenPage}"/>
        <Setter Property="AutomationProperties.Name" Value="{loc:T UsageBar_OpenPage}"/>
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="ToolTip" Value="{x:Null}"/>
                <Setter Property="AutomationProperties.Name" Value="{Binding Name}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Le cadre de focus se superpose au contenu : aucune place ajoutée au rendu de master. -->
    <ControlTemplate x:Key="BarRingsButtonTemplate" TargetType="Button">
        <Grid Background="{TemplateBinding Background}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <Border x:Name="Chrome" BorderThickness="1" CornerRadius="4" IsHitTestVisible="False"/>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Brush.SurfaceHover}"/>
                <Setter TargetName="Chrome" Property="Opacity" Value="0.3"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Brush.Text}"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- Sablier d'une lecture en cours. Sa place reste réservée pour que les logos ne se décalent pas. Le
         RotateTransform vit dans le gabarit, instancié par élément, et non dans un Setter partagé. -->
    <Style x:Key="BarSpinner" TargetType="ContentControl">
        <Setter Property="Visibility" Value="Hidden"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <TextBlock x:Name="Glyph" Text="↻" Foreground="{DynamicResource Brush.GlyphMuted}"
                               FontFamily="Segoe UI Symbol, Segoe UI" FontSize="12" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               RenderTransformOrigin="0.5,0.5">
                        <TextBlock.RenderTransform>
                            <RotateTransform/>
                        </TextBlock.RenderTransform>
                    </TextBlock>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsLoading}" Value="True">
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="Spin">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="Glyph"
                                                         Storyboard.TargetProperty="RenderTransform.Angle"
                                                         From="0" To="360" Duration="0:0:1.1"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <StopStoryboard BeginStoryboardName="Spin"/>
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsLoading}" Value="True">
                <Setter Property="Visibility" Value="Visible"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Un élément dont la donnée manque (carte, charge, anneaux, réservoir) ne prend aucune place. -->
    <Style x:Key="VisibleWithHeroCard" TargetType="FrameworkElement">
        <Style.Triggers>
            <DataTrigger Binding="{Binding HeroCard}" Value="{x:Null}">
                <Setter Property="Visibility" Value="Collapsed"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="VisibleWithSecondWindow" TargetType="FrameworkElement">
        <Style.Triggers>
            <DataTrigger Binding="{Binding HeroCard.SecondWindow}" Value="{x:Null}">
                <Setter Property="Visibility" Value="Collapsed"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="VisibleWithLoad" TargetType="FrameworkElement">
        <Style.Triggers>
            <DataTrigger Binding="{Binding Load}" Value="{x:Null}">
                <Setter Property="Visibility" Value="Collapsed"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="VisibleWithRings" TargetType="FrameworkElement">
        <Style.Triggers>
            <DataTrigger Binding="{Binding Rings}" Value="{x:Null}">
                <Setter Property="Visibility" Value="Collapsed"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="VisibleWithInnerRing" TargetType="FrameworkElement">
        <Style.Triggers>
            <DataTrigger Binding="{Binding Rings.Inner}" Value="{x:Null}">
                <Setter Property="Visibility" Value="Collapsed"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="VisibleWithTank" TargetType="FrameworkElement">
        <Style.Triggers>
            <DataTrigger Binding="{Binding Reservoir.LevelText}" Value="">
                <Setter Property="Visibility" Value="Collapsed"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="VisibleWithCurve" TargetType="FrameworkElement">
        <Style.Triggers>
            <DataTrigger Binding="{Binding ShowCurve}" Value="False">
                <Setter Property="Visibility" Value="Collapsed"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Le nombre d'une colonne ou d'un anneau : la couleur de l'élément, ou la brosse du thème que NumberBrushKey nomme
         (ThemedBrush). Le modèle de vue décide, la vue lie. -->
    <Style x:Key="BarNumber" TargetType="TextBlock" BasedOn="{StaticResource BarText}">
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="TextTrimming" Value="None"/>
        <Setter Property="Foreground" Value="{Binding Color, Converter={StaticResource BarBrush}}"/>
    </Style>

    <Style x:Key="BarLogoIcon" TargetType="views:ProviderIcon">
        <Setter Property="Width" Value="11"/>
        <Setter Property="Height" Value="11"/>
    </Style>

    <!-- Colonnes : pourcentage, jauge verticale, nom court, logo ou pastille de couleur. -->
    <DataTemplate x:Key="BarColumnsBody">
        <ItemsControl ItemsSource="{Binding Columns}" Focusable="False" IsTabStop="False">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Rows="1"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Grid Background="Transparent" ToolTip="{Binding Tooltip}" AutomationProperties.Name="{Binding Tooltip}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Style="{StaticResource BarNumber}" Text="{Binding NumberText}" FontSize="9"
                                   Margin="0,0,0,3" views:ThemedBrush.Key="{Binding NumberBrushKey}"/>
                        <views:FractionBar Grid.Row="1" Width="10" IsVertical="True" Radius="5"
                                           Track="{DynamicResource Brush.SeparatorStrong}" Fraction="{Binding Fraction}"
                                           Fill="{Binding Color, Converter={StaticResource BarBrush}}"/>
                        <TextBlock Grid.Row="2" Style="{StaticResource BarSubtle}" Text="{Binding Label}" FontSize="7"
                                   Margin="0,3"/>
                        <views:ProviderIcon Grid.Row="3" Style="{StaticResource BarLogoIcon}" Margin="0,0,0,1"
                                            ProviderId="{Binding ProviderId}" Glyph="{Binding Glyph}"
                                            Accent="{Binding Color, Converter={StaticResource BarBrush}}"/>
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </DataTemplate>

    <!-- Une ligne du style Héros : un autre fournisseur, ou la seconde fenêtre de l'IA mise en avant. Le clic est
         traité par UsageBar, qui lit le modèle de la ligne. -->
    <DataTemplate x:Key="BarHeroRowTemplate">
        <Button Style="{StaticResource BarFlatButton}" Height="20"
                ToolTip="{Binding Tooltip}" AutomationProperties.Name="{Binding Tooltip}">
            <Grid Margin="3,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <views:ProviderIcon Grid.Column="0" Style="{StaticResource BarLogoIcon}" Margin="0,0,4,0"
                                    ProviderId="{Binding ProviderId}" Glyph="{Binding Glyph}"
                                    Accent="{Binding Color, Converter={StaticResource BarBrush}}"/>
                <TextBlock Grid.Column="1" Style="{StaticResource BarSubtle}" Text="{Binding Label}"
                           TextAlignment="Left" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="2" Style="{StaticResource BarText}" Text="{Binding Text}" FontSize="11"
                           FontWeight="Bold" VerticalAlignment="Center" Margin="3,0,0,0" TextTrimming="None"
                           Foreground="{Binding Color, Converter={StaticResource BarBrush}}"/>
            </Grid>
        </Button>
    </DataTemplate>

    <!-- La seconde fenêtre de la carte : de l'information, pas un geste. Elle n'est pas un bouton, donc elle ne change
         pas d'IA mise en avant et ne suspend pas l'Auto. -->
    <DataTemplate x:Key="BarHeroSecondRow">
        <Grid Height="20" Background="Transparent" ToolTip="{Binding Tooltip}" AutomationProperties.Name="{Binding Tooltip}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <views:ProviderIcon Grid.Column="0" Style="{StaticResource BarLogoIcon}" Margin="3,0,4,0"
                                ProviderId="{Binding ProviderId}" Glyph="{Binding Glyph}"
                                Accent="{Binding Color, Converter={StaticResource BarBrush}}"/>
            <TextBlock Grid.Column="1" Style="{StaticResource BarSubtle}" Text="{Binding Label}"
                       TextAlignment="Left" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="2" Style="{StaticResource BarText}" Text="{Binding Text}" FontSize="11"
                       FontWeight="Bold" VerticalAlignment="Center" Margin="3,0" TextTrimming="None"
                       Foreground="{Binding Color, Converter={StaticResource BarBrush}}"/>
        </Grid>
    </DataTemplate>

    <!-- Héros : l'IA mise en avant en grand, les autres en lignes, la charge du PC en bas. -->
    <DataTemplate x:Key="BarHeroBody">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource VisibleWithHeroCard}"
                    Background="{DynamicResource Brush.SurfaceCard}" BorderBrush="{DynamicResource Brush.Border}"
                    BorderThickness="1" CornerRadius="6" Padding="4,7" Margin="0,0,0,8"
                    ToolTip="{Binding HeroCard.Tooltip}" AutomationProperties.Name="{Binding HeroCard.Tooltip}">
                <StackPanel>
                    <views:ProviderIcon Width="18" Height="18" HorizontalAlignment="Center"
                                        ProviderId="{Binding HeroCard.ProviderId}" Glyph="{Binding HeroCard.Glyph}"
                                        Accent="{Binding HeroCard.Color, Converter={StaticResource BarBrush}}"/>
                    <TextBlock Style="{StaticResource BarText}" Text="{Binding HeroCard.Name}" FontSize="11"
                               FontWeight="SemiBold" Margin="0,3,0,0"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Style="{StaticResource BarSubtleOrNothing}" Text="{Binding HeroCard.Label}"/>
                        <TextBlock Style="{StaticResource BarSubtleOrNothing}" Text="{Binding AutoSuffix}"/>
                    </StackPanel>
                    <TextBlock Style="{StaticResource BarText}" Text="{Binding HeroCard.Text}" FontSize="24"
                               FontWeight="Bold" TextTrimming="None"
                               Foreground="{Binding HeroCard.Color, Converter={StaticResource BarBrush}}"/>
                    <TextBlock Style="{StaticResource BarSubtleOrNothing}" Text="{Binding HeroCard.NoticeTitle}"
                               TextWrapping="Wrap" MaxHeight="26" Margin="2,0"/>
                    <views:FractionBar Height="4" Radius="2" Margin="2,3,2,0"
                                       Track="{DynamicResource Brush.SeparatorStrong}" Fraction="{Binding HeroCard.Fraction}"
                                       Fill="{Binding HeroCard.Color, Converter={StaticResource BarBrush}}"/>
                    <TextBlock Style="{StaticResource BarSubtleOrNothing}" Text="{Binding HeroCard.ResetLabel}"
                               Margin="0,3,0,0"/>
                    <ContentControl Style="{StaticResource VisibleWithSecondWindow}" Focusable="False" Margin="0,4,0,0"
                                    Content="{Binding HeroCard.SecondWindow}"
                                    ContentTemplate="{StaticResource BarHeroSecondRow}"/>
                </StackPanel>
            </Border>

            <ItemsControl Grid.Row="1" ItemsSource="{Binding HeroRows}" Focusable="False" IsTabStop="False"
                          ItemTemplate="{StaticResource BarHeroRowTemplate}"/>

            <Grid Grid.Row="3" Style="{StaticResource VisibleWithLoad}">
                <Border BorderBrush="{DynamicResource Brush.SeparatorStrong}" BorderThickness="0,1,0,0" Margin="0,0,0,0"/>
                <Grid Margin="0,7,0,0" ToolTip="{Binding Load.Tooltip}" Background="Transparent">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,2,0">
                        <TextBlock Style="{StaticResource BarSubtle}" Text="{loc:T StreamDock_Cpu}" FontSize="9"/>
                        <TextBlock Style="{StaticResource BarText}" Text="{Binding Load.CpuText}" FontSize="13"
                                   FontWeight="Bold"/>
                        <views:LoadCurve Height="22" Margin="0,2,0,0" Style="{StaticResource VisibleWithCurve}"
                                         Series="{Binding Load.CpuSeries}"
                                         Stroke="{Binding Load.CpuColor, Converter={StaticResource BarBrush}}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="2,0,0,0">
                        <TextBlock Style="{StaticResource BarSubtle}" Text="{loc:T StreamDock_Memory}" FontSize="9"/>
                        <TextBlock Style="{StaticResource BarText}" Text="{Binding Load.MemoryText}" FontSize="13"
                                   FontWeight="Bold"/>
                        <views:LoadCurve Height="22" Margin="0,2,0,0" Style="{StaticResource VisibleWithCurve}"
                                         Series="{Binding Load.MemorySeries}"
                                         Stroke="{Binding Load.MemoryColor, Converter={StaticResource BarBrush}}"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </DataTemplate>

    <!-- Un petit anneau : une fenêtre d'un autre fournisseur, ou le processeur et la mémoire. -->
    <DataTemplate x:Key="BarSmallRing">
        <views:UsageGaugeButton Style="{StaticResource BarEnlargeButton}" Margin="2,0"
                Template="{StaticResource BarRingsButtonTemplate}">
            <StackPanel HorizontalAlignment="Center">
                <Grid Width="32" Height="32">
                    <Ellipse Stroke="{DynamicResource Brush.SeparatorStrong}" StrokeThickness="4"/>
                    <views:RingArc Width="32" Height="32" StrokeThickness="4" Fraction="{Binding Fraction}"
                                   Stroke="{Binding Color, Converter={StaticResource BarBrush}}"/>
                    <TextBlock Style="{StaticResource BarNumber}" Text="{Binding NumberText}" FontSize="10"
                               VerticalAlignment="Center" views:ThemedBrush.Key="{Binding NumberBrushKey}"/>
                </Grid>
                <views:ProviderIcon Style="{StaticResource BarLogoIcon}" Margin="0,3,0,0"
                                    ProviderId="{Binding ProviderId}" Glyph=""
                                    Accent="{Binding Color, Converter={StaticResource BarBrush}}"/>
            </StackPanel>
        </views:UsageGaugeButton>
    </DataTemplate>

    <!-- Une pastille du réservoir : un petit anneau et son nom court dessous. -->
    <DataTemplate x:Key="BarDot">
        <views:UsageGaugeButton Style="{StaticResource BarEnlargeButton}" Margin="0,1">
            <StackPanel HorizontalAlignment="Center">
                <Grid Width="34" Height="34">
                    <Ellipse Stroke="{DynamicResource Brush.SeparatorStrong}" StrokeThickness="4"/>
                    <views:RingArc Width="34" Height="34" StrokeThickness="4" Fraction="{Binding Fraction}"
                                   Stroke="{Binding Color, Converter={StaticResource BarBrush}}"/>
                    <TextBlock Style="{StaticResource BarNumber}" Text="{Binding NumberText}" FontSize="10"
                               VerticalAlignment="Center"/>
                </Grid>
                <TextBlock Style="{StaticResource BarSubtle}" Text="{Binding Label}" FontSize="8"/>
            </StackPanel>
        </views:UsageGaugeButton>
    </DataTemplate>

    <!-- Anneaux : le double anneau de l'IA mise en avant, les autres en petits anneaux, le PC en double anneau. -->
    <DataTemplate x:Key="BarRingsBody">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Style="{StaticResource VisibleWithRings}" HorizontalAlignment="Center">
                <Grid Width="74" Height="74" Background="Transparent" ToolTip="{Binding Rings.Outer.Tooltip}"
                      AutomationProperties.Name="{Binding Rings.Outer.Tooltip}">
                    <Ellipse Stroke="{DynamicResource Brush.SeparatorStrong}" StrokeThickness="5"/>
                    <views:RingArc Width="74" Height="74" StrokeThickness="5" Fraction="{Binding Rings.Outer.Fraction}"
                                   Stroke="{Binding Rings.Outer.Color, Converter={StaticResource BarBrush}}"/>
                    <Grid Width="50" Height="50" Background="Transparent" Style="{StaticResource VisibleWithInnerRing}"
                          ToolTip="{Binding Rings.Inner.Tooltip}">
                        <Ellipse Stroke="{DynamicResource Brush.SeparatorStrong}" StrokeThickness="4"/>
                        <views:RingArc Width="50" Height="50" StrokeThickness="4" Fraction="{Binding Rings.Inner.Fraction}"
                                       Stroke="{Binding Rings.Inner.Color, Converter={StaticResource BarBrush}}"/>
                    </Grid>
                    <TextBlock Style="{StaticResource BarText}" Text="{Binding Rings.CenterText}" FontSize="15"
                               FontWeight="Bold" VerticalAlignment="Center" TextTrimming="None" IsHitTestVisible="False"
                               Foreground="{Binding Rings.Outer.Color, Converter={StaticResource BarBrush}}"/>
                </Grid>
                <!-- Le nom et la légende sont réduits : le nom a pour infobulle celle de la carte, la légende celles des deux anneaux. -->
                <views:UsageGaugeButton DataContext="{Binding FeaturedGauge}" Style="{StaticResource BarFeaturedLogoButton}"
                        Template="{StaticResource BarRingsButtonTemplate}" HorizontalAlignment="Center" Margin="0,3,0,0">
                    <TextBlock Style="{StaticResource BarText}" Text="{Binding Name}" FontSize="11" FontWeight="SemiBold"
                               ToolTip="{Binding Ring.Tooltip}" ToolTipService.ShowOnDisabled="True"/>
                </views:UsageGaugeButton>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Background="Transparent"
                            ToolTip="{Binding Rings.LegendTooltip}">
                    <TextBlock Style="{StaticResource BarSubtleOrNothing}" Text="{Binding Rings.Legend}"/>
                    <TextBlock Style="{StaticResource BarSubtleOrNothing}" Text="{Binding AutoSuffix}"/>
                </StackPanel>
            </StackPanel>

            <ItemsControl Grid.Row="1" ItemsSource="{Binding Rings.Others}" Focusable="False" IsTabStop="False"
                          Margin="0,8,0,0" ItemTemplate="{StaticResource BarSmallRing}" HorizontalAlignment="Center">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>

            <Grid Grid.Row="3" Style="{StaticResource VisibleWithLoad}">
                <Border BorderBrush="{DynamicResource Brush.SeparatorStrong}" BorderThickness="0,1,0,0"/>
                <views:UsageGaugeButton DataContext="{Binding Load}" Style="{StaticResource BarGaugeButton}"
                        Template="{StaticResource BarRingsButtonTemplate}" Margin="0,8,0,0" HorizontalAlignment="Center"
                        ToolTip="{loc:T UsageBar_Enlarge}" AutomationProperties.Name="{loc:T UsageBar_CpuMemory}">
                    <StackPanel HorizontalAlignment="Center">
                    <Grid Width="58" Height="58" HorizontalAlignment="Center">
                        <Ellipse Stroke="{DynamicResource Brush.SeparatorStrong}" StrokeThickness="5"/>
                        <views:RingArc Width="58" Height="58" StrokeThickness="5" Fraction="{Binding CpuFraction}"
                                       Stroke="{Binding CpuColor, Converter={StaticResource BarBrush}}"/>
                        <Grid Width="40" Height="40">
                            <Ellipse Stroke="{DynamicResource Brush.SeparatorStrong}" StrokeThickness="4"/>
                            <views:RingArc Width="40" Height="40" StrokeThickness="4"
                                           Fraction="{Binding MemoryFraction}"
                                           Stroke="{Binding MemoryColor, Converter={StaticResource BarBrush}}"/>
                        </Grid>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource BarText}" Text="{Binding CpuText}" FontSize="9"
                                       FontWeight="Bold" TextTrimming="None"/>
                            <TextBlock Style="{StaticResource BarText}" Text="{Binding MemoryText}" FontSize="9"
                                       FontWeight="Bold" TextTrimming="None"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock Style="{StaticResource BarSubtle}" Text="{Binding Legend}" FontSize="9" Margin="0,2,0,0"/>
                    </StackPanel>
                </views:UsageGaugeButton>
            </Grid>
        </Grid>
    </DataTemplate>

    <!-- Réservoir : une colonne qui se remplit, et quatre pastilles dessous. -->
    <DataTemplate x:Key="BarReservoirBody">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource VisibleWithTank}" Margin="0,0,0,8" CornerRadius="8"
                    BorderThickness="1" BorderBrush="{DynamicResource Brush.Border}"
                    Background="{DynamicResource Brush.SurfaceMuted}" ClipToBounds="True"
                    ToolTip="{Binding Reservoir.Tooltip}" AutomationProperties.Name="{Binding Reservoir.Tooltip}">
                <Grid>
                    <views:FractionBar IsVertical="True" FillOpacity="0.4" Fraction="{Binding Reservoir.Level}"
                                       Fill="{Binding Reservoir.Color, Converter={StaticResource BarBrush}}"/>
                    <StackPanel VerticalAlignment="Top" Margin="0,8,0,0">
                        <views:UsageGaugeButton DataContext="{Binding FeaturedGauge}" Style="{StaticResource BarFeaturedLogoButton}"
                                HorizontalAlignment="Center">
                            <views:ProviderIcon Width="18" Height="18" ProviderId="{Binding Ring.ProviderId}"
                                                Glyph="{Binding Glyph}"
                                                Accent="{Binding Ring.Color, Converter={StaticResource BarBrush}}"/>
                        </views:UsageGaugeButton>
                        <TextBlock Style="{StaticResource BarText}" Text="{Binding FeaturedGauge.Name}" FontSize="11"
                                   FontWeight="SemiBold" Margin="0,2,0,0" ToolTip="{Binding FeaturedGauge.Ring.Tooltip}"/>
                        <TextBlock Style="{StaticResource BarSubtleOrNothing}" Text="{Binding FeaturedGauge.WindowLabel}"/>
                        <TextBlock Style="{StaticResource BarSubtleOrNothing}" Text="{Binding Reservoir.Label}"
                                   TextWrapping="Wrap" MaxHeight="26" Margin="2,0"/>
                        <TextBlock Style="{StaticResource BarSubtleOrNothing}" Text="{Binding AutoLabel}"/>
                    </StackPanel>
                    <TextBlock Style="{StaticResource BarText}" Text="{Binding Reservoir.LevelText}" FontSize="22"
                               FontWeight="Bold" VerticalAlignment="Bottom" Margin="0,0,0,8" TextTrimming="None"/>
                </Grid>
            </Border>

            <ItemsControl Grid.Row="1" ItemsSource="{Binding Reservoir.Dots}" Focusable="False" IsTabStop="False"
                          ItemTemplate="{StaticResource BarDot}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="2"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </Grid>
    </DataTemplate>

    <!-- Aucun quota et charge décochée : une notice qui renvoie aux réglages. Le clic est traité par UsageBar. -->
    <DataTemplate x:Key="BarEmptyBody">
        <Button Style="{StaticResource BarFlatButton}" VerticalAlignment="Top" ToolTip="{loc:T UsageBar_Empty_Tooltip}"
                AutomationProperties.Name="{Binding EmptyText}">
            <TextBlock Style="{StaticResource BarSubtle}" Text="{Binding EmptyText}" TextWrapping="Wrap" Margin="4,8"/>
        </Button>
    </DataTemplate>
</ResourceDictionary>
