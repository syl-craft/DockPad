<UserControl x:Class="DockPad.Views.ProviderIcon"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:services="clr-namespace:DockPad.Services"
             x:Name="IconRoot" Focusable="False" IsHitTestVisible="False">
    <Viewbox Stretch="Uniform">
        <Grid Width="24" Height="24">
            <Border CornerRadius="12" Background="{Binding Accent, ElementName=IconRoot}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ProviderId, ElementName=IconRoot}" Value="claude">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding ProviderId, ElementName=IconRoot}" Value="codex">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding ProviderId, ElementName=IconRoot}" Value="antigravity">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="{Binding Glyph, ElementName=IconRoot}" Foreground="White"
                           FontFamily="Segoe UI Symbol, Segoe UI Emoji, Segoe UI"
                           FontSize="14" FontWeight="Bold"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <Path Stretch="Uniform">
                <Path.Style>
                    <Style TargetType="Path">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Setter Property="Fill" Value="{DynamicResource Brush.Text}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ProviderId, ElementName=IconRoot}" Value="claude">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Setter Property="Data" Value="{x:Static services:ProviderLogos.Claude}"/>
                                <Setter Property="Fill" Value="{x:Static services:ProviderLogos.ClaudeBrush}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding ProviderId, ElementName=IconRoot}" Value="codex">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Setter Property="Data" Value="{x:Static services:ProviderLogos.Codex}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding ProviderId, ElementName=IconRoot}" Value="antigravity">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Setter Property="Data" Value="{x:Static services:ProviderLogos.Antigravity}"/>
                                <Setter Property="Fill" Value="{x:Static services:ProviderLogos.AntigravityBrush}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Path.Style>
            </Path>
        </Grid>
    </Viewbox>
</UserControl>
