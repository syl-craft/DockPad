<Window x:Class="DockPad.ContextMenuManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gestionnaire de menu contextuel Windows"
        Icon="pack://application:,,,/app.ico"
        Width="820" Height="580"
        MinWidth="640" MinHeight="400"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="#F3F3F3"
        FontFamily="Segoe UI">

    <Window.Resources>
        <Style TargetType="ListView">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style TargetType="GridViewColumnHeader">
            <Setter Property="Background" Value="#EEEEEE"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="BorderBrush" Value="#DDDDDD"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>
        <Style TargetType="ListViewItem">
            <Setter Property="Padding" Value="0,4"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#CCE4F7"/>
                    <Setter Property="Foreground" Value="#1A1A1A"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#EEF6FC"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#0078D4" Padding="20,16">
            <StackPanel>
                <TextBlock Text="Gestionnaire de menu contextuel" FontSize="18"
                           FontWeight="SemiBold" Foreground="White"/>
                <TextBlock Text="Ajoutez, modifiez et supprimez des raccourcis dans le menu clic droit de l'Explorateur Windows."
                           FontSize="12" Foreground="#B3D9F7" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <!-- Toolbar -->
        <Border Grid.Row="1" Background="White" Padding="16,10"
                BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" x:Name="BtnAdd" Content="+ Ajouter"
                        Style="{StaticResource PrimaryButton}"
                        Margin="0,0,8,0" Click="Add_Click"/>
                <Button Grid.Column="1" Content="Modifier" Style="{StaticResource SecondaryButton}"
                        x:Name="BtnEdit" Margin="0,0,8,0" IsEnabled="False" Click="Edit_Click"/>
                <Button Grid.Column="2" Content="Dupliquer" Style="{StaticResource SecondaryButton}"
                        x:Name="BtnDuplicate" Margin="0,0,8,0" IsEnabled="False" Click="Duplicate_Click"/>
                <Button Grid.Column="3" Content="Supprimer" Style="{StaticResource DangerButton}"
                        x:Name="BtnDelete" IsEnabled="False" Click="Delete_Click"/>

                <!-- Filtre cible -->
                <StackPanel Grid.Column="5" Margin="10,0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Afficher : " VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#555"/>
                    <ComboBox x:Name="CmbFilter" Width="180" SelectionChanged="CmbFilter_SelectionChanged">
                        <ComboBoxItem Content="Tout" IsSelected="True" Tag="All"/>
                        <ComboBoxItem Content="Fichiers" Tag="Files"/>
                        <ComboBoxItem Content="Dossiers" Tag="Folders"/>
                        <ComboBoxItem Content="Fond de dossier" Tag="FolderBackground"/>
                    </ComboBox>
                </StackPanel>

                <!-- Élever (non-admin uniquement) -->
                <Button Grid.Column="5" x:Name="BtnElevate" Content="🛡 Élever"
                        Style="{StaticResource SecondaryButton}"
                        Visibility="Collapsed" Click="Elevate_Click"/>
            </Grid>
        </Border>

        <!-- Bandeau non-admin -->
        <Border Grid.Row="2" x:Name="AdminBanner"
                Background="#FFF4CE" BorderBrush="#FFB900" BorderThickness="0,0,0,1"
                Padding="16,8" Visibility="Collapsed">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="🔒 " FontSize="13" VerticalAlignment="Center"/>
                <TextBlock VerticalAlignment="Center" FontSize="12" Foreground="#5C3A00"
                           Text="Droits administrateur requis pour modifier les entrées. Cliquez sur « Élever » pour relancer en admin."/>
            </StackPanel>
        </Border>

        <!-- Liste -->
        <Border Grid.Row="3" Margin="16" Background="White"
                BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="6">
            <Grid>
                <ListView x:Name="LvEntries"
                          SelectionChanged="LvEntries_SelectionChanged"
                          MouseDoubleClick="LvEntries_MouseDoubleClick">
                    <ListView.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Modifier" Click="Edit_Click"/>
                            <MenuItem Header="Dupliquer" Click="Duplicate_Click"/>
                            <Separator/>
                            <MenuItem Header="Supprimer" Click="Delete_Click" Foreground="#D13438"/>
                        </ContextMenu>
                    </ListView.ContextMenu>
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Icône" Width="54">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <Image Source="{Binding IconBitmap}" Width="24" Height="24"
                                               HorizontalAlignment="Center" Stretch="Uniform"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Nom affiché"
                                            DisplayMemberBinding="{Binding DisplayName}"/>
                            <GridViewColumn Header="Clé de registre"
                                            DisplayMemberBinding="{Binding RegistryKey}"/>
                            <GridViewColumn Header="S'applique à"
                                            DisplayMemberBinding="{Binding TargetLabel}"/>
                            <GridViewColumn Header="Commande"
                                            DisplayMemberBinding="{Binding Command}"/>
                        </GridView>
                    </ListView.View>
                </ListView>
                <TextBlock x:Name="TxtEmpty" Text="Aucun raccourci trouvé."
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="#999" FontSize="14" Visibility="Collapsed"/>
            </Grid>
        </Border>

        <!-- Status bar -->
        <Border Grid.Row="4" Background="#EEEEEE" Padding="16,8"
                BorderBrush="#DDDDDD" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TxtStatus" Text="Prêt." Foreground="#555" FontSize="12"
                           VerticalAlignment="Center"/>
                <Button Grid.Column="1" Content="Actualiser" Style="{StaticResource SecondaryButton}"
                        Padding="12,4" Click="Refresh_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>
