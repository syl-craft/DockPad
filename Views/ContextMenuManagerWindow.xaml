<Window x:Class="DockPad.ContextMenuManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:DockPad.Services.Localization"
        Title="{loc:T CtxMenu_Title}"
        Icon="pack://application:,,,/app.ico"
        Width="820" Height="580"
        MinWidth="640" MinHeight="400"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="{StaticResource Brush.Surface}"
        FontFamily="Segoe UI">

    <Window.Resources>
        <Style TargetType="ListView">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style TargetType="GridViewColumnHeader">
            <Setter Property="Background" Value="{StaticResource Brush.Separator}"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="BorderBrush" Value="{StaticResource Brush.SeparatorStrong}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>
        <Style TargetType="ListViewItem">
            <Setter Property="Padding" Value="0,4"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#CCE4F7"/>
                    <Setter Property="Foreground" Value="{StaticResource Brush.Text}"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource Brush.AccentSoft}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{StaticResource Brush.Accent}" Padding="20,16">
            <StackPanel>
                <TextBlock Text="{loc:T CtxMenu_Heading}" FontSize="18"
                           FontWeight="SemiBold" Foreground="White"/>
                <TextBlock Text="{loc:T CtxMenu_Subtitle}"
                           FontSize="12" Foreground="#B3D9F7" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <!-- Toolbar -->
        <Border Grid.Row="1" Background="White" Padding="16,10"
                BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" x:Name="BtnAdd" Content="{loc:T Common_Add}"
                        Style="{StaticResource PrimaryButton}"
                        Margin="0,0,8,0" Click="Add_Click"/>
                <Button Grid.Column="1" Content="{loc:T Common_Edit}" Style="{StaticResource SecondaryButton}"
                        x:Name="BtnEdit" Margin="0,0,8,0" IsEnabled="False" Click="Edit_Click"/>
                <Button Grid.Column="2" Content="{loc:T Common_Duplicate}" Style="{StaticResource SecondaryButton}"
                        x:Name="BtnDuplicate" Margin="0,0,8,0" IsEnabled="False" Click="Duplicate_Click"/>
                <Button Grid.Column="3" Content="{loc:T Common_Delete}" Style="{StaticResource DangerButton}"
                        x:Name="BtnDelete" IsEnabled="False" Click="Delete_Click"/>

                <!-- Filtre cible -->
                <StackPanel Grid.Column="5" Margin="10,0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{loc:T CtxMenu_Filter}" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#555"/>
                    <ComboBox x:Name="CmbFilter" Width="180" SelectionChanged="CmbFilter_SelectionChanged">
                        <ComboBoxItem Content="{loc:T CtxMenu_Filter_All}" IsSelected="True" Tag="All"/>
                        <ComboBoxItem Content="{loc:T CtxMenu_Filter_Files}" Tag="Files"/>
                        <ComboBoxItem Content="{loc:T CtxMenu_Filter_Folders}" Tag="Folders"/>
                        <ComboBoxItem Content="{loc:T CtxMenu_Filter_Background}" Tag="FolderBackground"/>
                    </ComboBox>
                </StackPanel>

                <!-- Élever (non-admin uniquement) -->
                <Button Grid.Column="5" x:Name="BtnElevate" Content="{loc:T Common_Elevate}"
                        Style="{StaticResource SecondaryButton}"
                        Visibility="Collapsed" Click="Elevate_Click"/>
            </Grid>
        </Border>

        <!-- Bandeau non-admin -->
        <Border Grid.Row="2" x:Name="AdminBanner"
                Background="#FFF4CE" BorderBrush="#FFB900" BorderThickness="0,0,0,1"
                Padding="16,8" Visibility="Collapsed">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="🔒 " FontSize="13" VerticalAlignment="Center"/>
                <TextBlock VerticalAlignment="Center" FontSize="12" Foreground="#5C3A00"
                           Text="{loc:T CtxMenu_AdminBanner}"/>
            </StackPanel>
        </Border>

        <!-- Liste -->
        <Border Grid.Row="3" Margin="16" Background="White"
                BorderBrush="{StaticResource Brush.Border}" BorderThickness="1" CornerRadius="6"
                SnapsToDevicePixels="True" UseLayoutRounding="True">
            <Grid>
                <ListView x:Name="LvEntries"
                          SelectionChanged="LvEntries_SelectionChanged"
                          MouseDoubleClick="LvEntries_MouseDoubleClick">
                    <ListView.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="{loc:T Common_Edit}" Click="Edit_Click"/>
                            <MenuItem Header="{loc:T Common_Duplicate}" Click="Duplicate_Click"/>
                            <Separator/>
                            <MenuItem Header="{loc:T Common_Delete}" Click="Delete_Click" Foreground="{StaticResource Brush.DangerStrong}"/>
                        </ContextMenu>
                    </ListView.ContextMenu>
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="{loc:T CtxMenu_Col_Icon}" Width="54">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <Image Source="{Binding IconBitmap}" Width="24" Height="24"
                                               HorizontalAlignment="Center" Stretch="Uniform"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="{loc:T CtxMenu_Col_DisplayName}"
                                            DisplayMemberBinding="{Binding DisplayName}"/>
                            <GridViewColumn Header="{loc:T CtxMenu_Col_RegistryKey}"
                                            DisplayMemberBinding="{Binding RegistryKey}"/>
                            <GridViewColumn Header="{loc:T CtxMenu_Col_AppliesTo}"
                                            DisplayMemberBinding="{Binding TargetLabel}"/>
                            <GridViewColumn Header="{loc:T CtxMenu_Col_Command}"
                                            DisplayMemberBinding="{Binding Command}"/>
                        </GridView>
                    </ListView.View>
                </ListView>
                <TextBlock x:Name="TxtEmpty" Text="{loc:T CtxMenu_Empty}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="#999" FontSize="14" Visibility="Collapsed"/>
            </Grid>
        </Border>

        <!-- Status bar -->
        <Border Grid.Row="4" Background="{StaticResource Brush.Separator}" Padding="16,8"
                BorderBrush="{StaticResource Brush.SeparatorStrong}" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TxtStatus" Text="{loc:T Common_Ready}" Foreground="#555" FontSize="12"
                           VerticalAlignment="Center"/>
                <Button Grid.Column="1" Content="{loc:T CtxMenu_Refresh}" Style="{StaticResource SecondaryButton}"
                        Padding="12,4" Click="Refresh_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>
