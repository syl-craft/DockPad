<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- ============================================================================
         Theme sombre. Chaque cle est la traduction de son role, pas de sa valeur.

         Les deux dictionnaires portent EXACTEMENT les memes cles : un test le verifie,
         comme la parite des deux fichiers de traduction. Une cle absente d'un cote ne se
         verrait sinon que sur l'ecran concerne, dans le theme concerne.
         ============================================================================ -->
    <SolidColorBrush x:Key="Brush.Accent" Color="#0078D4"/>   <!-- bleu d'accent : boutons primaires, en-tetes, selection -->
    <SolidColorBrush x:Key="Brush.AccentHover" Color="#1A86D9"/>   <!-- accent au survol -->
    <SolidColorBrush x:Key="Brush.AccentPressed" Color="#005A9E"/>   <!-- accent enfonce -->
    <SolidColorBrush x:Key="Brush.AccentSoft" Color="#16283A"/>   <!-- fond tres clair derive de l'accent -->
    <SolidColorBrush x:Key="Brush.Surface" Color="#202020"/>   <!-- fond de fenetre et des boutons secondaires -->
    <SolidColorBrush x:Key="Brush.SurfaceCard" Color="#2B2B2B"/>   <!-- fond d'une carte, d'une liste, d'une tuile -->
    <SolidColorBrush x:Key="Brush.SurfaceHover" Color="#333333"/>   <!-- survol sur une surface claire -->
    <SolidColorBrush x:Key="Brush.Border" Color="#3D3D3D"/>   <!-- bordure standard -->
    <SolidColorBrush x:Key="Brush.BorderSoft" Color="#383838"/>   <!-- bordure attenuee (cartes du bandeau) -->
    <SolidColorBrush x:Key="Brush.BorderStrong" Color="#4D4D4D"/>   <!-- bordure de champ de saisie, texte desactive -->
    <SolidColorBrush x:Key="Brush.Text" Color="#F0F0F0"/>   <!-- texte principal -->
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="#DADADA"/>   <!-- texte secondaire -->
    <SolidColorBrush x:Key="Brush.TextMuted" Color="#949494"/>   <!-- texte d'appoint : unites, chemins, aide -->
    <SolidColorBrush x:Key="Brush.Danger" Color="#FF6B5E"/>   <!-- erreur et suppression -->
    <SolidColorBrush x:Key="Brush.DangerStrong" Color="#D13438"/>   <!-- accent d'un dialogue d'erreur -->
    <SolidColorBrush x:Key="Brush.Demo" Color="#A78BFA"/>   <!-- violet du badge de demonstration -->
    <SolidColorBrush x:Key="Brush.Separator" Color="#2E2E2E"/>   <!-- filets et separateurs -->
    <SolidColorBrush x:Key="Brush.SeparatorStrong" Color="#3A3A3A"/>   <!-- filets marques -->
    <SolidColorBrush x:Key="Brush.TextStrong" Color="#FFFFFF"/>   <!-- valeur d'une metrique -->
    <SolidColorBrush x:Key="Brush.TextSmall" Color="#C8C8C8"/>   <!-- petit libelle -->
    <SolidColorBrush x:Key="Brush.TextLabel" Color="#B8B8B8"/>   <!-- libelle de champ, texte d'aide -->
    <SolidColorBrush x:Key="Brush.TextSubtle" Color="#ABABAB"/>   <!-- texte secondaire discret -->
    <SolidColorBrush x:Key="Brush.TextDetail" Color="#9E9E9E"/>   <!-- detail technique -->
    <SolidColorBrush x:Key="Brush.TextHint" Color="#909090"/>   <!-- chemin, indication -->
    <SolidColorBrush x:Key="Brush.TextFaint" Color="#808080"/>   <!-- texte tres attenue -->
    <SolidColorBrush x:Key="Brush.TextMetricLabel" Color="#8C8C8C"/>   <!-- libelle d'une metrique du bandeau -->
    <SolidColorBrush x:Key="Brush.TextDisabled" Color="#6E6E6E"/>   <!-- texte inactif -->
    <SolidColorBrush x:Key="Brush.GlyphMuted" Color="#A0A0A0"/>   <!-- glyphe attenue -->
    <SolidColorBrush x:Key="Brush.SurfaceAlt" Color="#262626"/>   <!-- surface alternee d'une liste -->
    <SolidColorBrush x:Key="Brush.RowHover" Color="#3A3A3A"/>   <!-- ligne de liste au survol -->
    <SolidColorBrush x:Key="Brush.SurfaceMuted" Color="#2A2A2A"/>   <!-- surface eteinte -->
    <SolidColorBrush x:Key="Brush.BorderFaint" Color="#303030"/>   <!-- bordure a peine visible -->
    <SolidColorBrush x:Key="Brush.BorderSubtle" Color="#343434"/>   <!-- bordure discrete -->
    <SolidColorBrush x:Key="Brush.BorderList" Color="#454545"/>   <!-- filet entre lignes d'une liste -->
    <SolidColorBrush x:Key="Brush.BorderHover" Color="#6A6A6A"/>   <!-- bordure au survol -->
    <SolidColorBrush x:Key="Brush.AccentTintSoft" Color="#16283A"/>   <!-- fond d'accent tres pale -->
    <SolidColorBrush x:Key="Brush.AccentTint" Color="#1B3348"/>   <!-- fond d'accent pale -->
    <SolidColorBrush x:Key="Brush.AccentTintStrong" Color="#21405B"/>   <!-- fond d'accent marque -->
    <SolidColorBrush x:Key="Brush.AccentSelected" Color="#1E3A5F"/>   <!-- ligne selectionnee -->
    <SolidColorBrush x:Key="Brush.AccentBorderSoft" Color="#2F5F87"/>   <!-- bordure d'accent pale -->
    <SolidColorBrush x:Key="Brush.WarnSurface" Color="#3A2E00"/>   <!-- fond d'avertissement -->
    <SolidColorBrush x:Key="Brush.WarnBorder" Color="#8A7300"/>   <!-- bordure d'avertissement -->
    <SolidColorBrush x:Key="Brush.WarnAccent" Color="#FFB900"/>   <!-- accent d'avertissement -->
    <SolidColorBrush x:Key="Brush.WarnText" Color="#F5D77A"/>   <!-- texte sur fond d'avertissement -->
    <SolidColorBrush x:Key="Brush.WarnTextAlt" Color="#F5C97A"/>   <!-- texte d'avertissement, variante -->
    <SolidColorBrush x:Key="Brush.WarnTextStrong" Color="#FFC46B"/>   <!-- texte d'avertissement marque -->
    <SolidColorBrush x:Key="Brush.DemoSurface" Color="#2A2438"/>   <!-- fond du badge de demonstration -->
    <SolidColorBrush x:Key="Brush.DemoBorder" Color="#4C3F73"/>   <!-- bordure du badge de demonstration -->
    <SolidColorBrush x:Key="Brush.DangerAlt" Color="#E8705F"/>   <!-- erreur, variante -->
    <SolidColorBrush x:Key="Brush.HintVeil" Color="#BB000000"/>   <!-- voile de l'overlay clavier -->
    <SolidColorBrush x:Key="Brush.DangerHover" Color="#E14C46"/>   <!-- bouton de suppression au survol -->
    <SolidColorBrush x:Key="Brush.DangerPressed" Color="#B32E26"/>   <!-- bouton de suppression enfonce -->
    <SolidColorBrush x:Key="Brush.SurfacePressed" Color="#4A4A4A"/>   <!-- bouton secondaire enfonce -->
</ResourceDictionary>
